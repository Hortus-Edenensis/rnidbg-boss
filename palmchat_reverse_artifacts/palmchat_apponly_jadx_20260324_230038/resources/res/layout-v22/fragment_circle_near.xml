<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.palmchat.circle.ui.view.TabLayoutScroll
            android:id="@+id/tablayout"
            android:layout_width="match_parent"
            android:layout_height="38dp">
            <com.zenmen.palmchat.circle.ui.view.IndicatorLineView
                android:id="@+id/indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cy_color_indicator="@color/Aa"
                app:cy_height_indicator="4dp"
                app:cy_radius_indicator="2dp"
                app:cy_width_indicator_max="16dp"
                app:cy_width_indicator_selected="45dp"/>
        </com.zenmen.palmchat.circle.ui.view.TabLayoutScroll>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nest_scroll_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/layout_permission"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="144dp"
                android:layout_marginTop="86dp"
                android:src="@drawable/icon_need_location"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/B4"
                android:textColor="@color/Gd"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="250dp"
                android:text="授权地理位置，可以发现更多附近群组"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/B2"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/text_permission"
                android:background="@drawable/selector_btn_green2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="48dp"
                android:layout_marginTop="120dp"
                android:layout_marginRight="48dp"
                android:text="授权地理位置"
                android:layout_below="@+id/text"
                android:layout_marginHorizontal="48dp"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
