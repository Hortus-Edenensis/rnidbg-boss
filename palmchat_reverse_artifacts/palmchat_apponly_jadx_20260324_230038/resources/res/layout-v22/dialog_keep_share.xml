<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="#7f000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/image_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/icon_keep_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/text_share"
        android:background="@drawable/selector_keep_share"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="53dp"
        android:layout_marginRight="53dp"
        android:layout_marginBottom="30dp"
        android:text="分享"
        android:layout_marginHorizontal="53dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_content"
        android:background="@drawable/white_round_8"
        android:layout_width="match_parent"
        android:layout_height="208dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/text_share"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:background="#ebebeb"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="23dp"
            android:layout_marginTop="98dp"
            android:layout_marginRight="23dp"
            android:layout_marginHorizontal="23dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/image_head"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="23dp"
            android:layout_marginTop="25dp"
            app:esv_shape="circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_color_222222"
            android:ellipsize="end"
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:maxLines="1"
            android:maxEms="12"
            app:layout_constraintStart_toEndOf="@+id/image_head"
            app:layout_constraintTop_toTopOf="@+id/image_head"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/text_color_999"
            android:id="@+id/text_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/image_head"
            app:layout_constraintStart_toEndOf="@+id/image_head"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_color_999"
            android:id="@+id/text_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="23dp"
            android:layout_marginBottom="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_color_999"
            android:id="@+id/text_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="23dp"
            android:layout_marginBottom="21dp"
            android:text="时长"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textSize="28dp"
            android:textColor="@color/text_color_222222"
            android:id="@+id/text_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/text_length"
            app:layout_constraintEnd_toEndOf="@+id/text_length"/>
        <TextView
            android:textSize="28dp"
            android:textColor="@color/text_color_222222"
            android:id="@+id/text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/text_repeat"
            app:layout_constraintTop_toTopOf="@+id/text_time"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_color_222222"
            android:id="@+id/text_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/text_count"
            app:layout_constraintStart_toEndOf="@+id/text_count"
            app:layout_constraintTop_toTopOf="@+id/text_count"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="26dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/text_complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:text="你完成了"
        app:layout_constraintBottom_toTopOf="@+id/layout_content"
        app:layout_constraintStart_toStartOf="@+id/layout_content"/>
    <TextView
        android:textSize="26dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/text_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/text_complete"
        app:layout_constraintTop_toBottomOf="@+id/text_complete"/>
</androidx.constraintlayout.widget.ConstraintLayout>
