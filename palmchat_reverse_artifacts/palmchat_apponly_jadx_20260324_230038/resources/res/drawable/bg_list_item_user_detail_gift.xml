<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <gradient
                android:startColor="#ffebeb"
                android:endColor="#e4f3f4"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <gradient
                android:startColor="#fff7ee"
                android:endColor="#f1feff"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
