<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_polish_dialog_bg"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/ic_polish_rule_bg"
            android:layout_width="320dp"
            android:layout_height="76dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:gravity="center"
                android:id="@+id/titleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="擦亮主页活动规则"
                android:layout_centerHorizontal="true"/>
            <ScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#999"
                    android:id="@+id/content"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.今日曝光板块品示曝光次数为找朋友页面曝光次数；\10 2.参与活动擦亮主页可获得找朋友页面额外的曝光次数；\10 3.每次擦亮主页可获得的曝光次数以活动页面显示为准。  "/>
            </ScrollView>
            <View
                android:background="#e5e5e5"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:gravity="center"
                android:id="@+id/confirm"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="我知道了"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
