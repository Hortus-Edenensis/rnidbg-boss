<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/toolbar"
            layout="@layout/layout_toolbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="16dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/country_name_view"
                android:background="@drawable/background_select_countrycode"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_black"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:text="@string/country_code"/>
                <TextView
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_green"
                    android:gravity="center"
                    android:id="@+id/country_name_textview"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="中国"
                    android:singleLine="true"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/phoneContainer"
                android:background="@drawable/shape_light_green_underline"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_black"
                    android:gravity="center"
                    android:id="@+id/add_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:text="+"/>
                <EditText
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_black"
                    android:gravity="center"
                    android:id="@+id/country_code_edit"
                    android:background="@null"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="34dp"
                    android:text="86"
                    android:maxLength="4"
                    android:layout_toRightOf="@+id/add_symbol"
                    android:inputType="number"/>
                <com.zenmen.palmchat.widget.ClearEditText
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_black"
                    android:textColorHint="@color/login_hint_text_color"
                    android:gravity="center"
                    android:id="@+id/phone_number_edit"
                    android:background="@null"
                    android:paddingLeft="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="95dp"
                    android:hint="@string/your_phone_number"
                    android:maxLength="20"
                    android:inputType="number"
                    android:textCursorDrawable="@null"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_black"
                    android:gravity="center"
                    android:id="@+id/passwordTv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:text="@string/password"/>
                <com.zenmen.palmchat.widget.ClearEditText
                    android:textSize="@dimen/text_size_log_in"
                    android:textColor="@color/text_color_black"
                    android:textColorHint="@color/login_hint_text_color"
                    android:gravity="center"
                    android:id="@+id/password_edit"
                    android:background="@drawable/selector_edit_text_underline_green"
                    android:paddingLeft="95dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="34dp"
                    android:hint="@string/input_password"
                    android:password="true"
                    android:singleLine="true"
                    android:maxLength="16"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@null"/>
            </RelativeLayout>
            <TextView
                android:enabled="false"
                android:textSize="@dimen/text_size_log_in_button"
                android:textColor="@color/text_selector_green_btn_text"
                android:gravity="center"
                android:id="@+id/log_in_text"
                android:background="@drawable/selector_btn_green2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="@string/log_in"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/login_select_text_color"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/login_by_sms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/forget_password"/>
            <TextView
                android:enabled="true"
                android:textSize="@dimen/text_size_big"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/log_in_text_2"
                android:background="@drawable/selector_btn_green"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="25dp"
                android:text="进主页"/>
            <TextView
                android:enabled="true"
                android:textSize="@dimen/text_size_big"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/log_in_text_3"
                android:background="@drawable/selector_btn_green"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="25dp"
                android:text="测试"/>
            <TextView
                android:enabled="true"
                android:textSize="@dimen/text_size_big"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/log_in_text_4"
                android:background="@drawable/selector_btn_green"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="25dp"
                android:text="发消息"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_log_in"
        android:textColor="@color/login_select_text_color"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/login_by_other_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="@string/login_by_other_method"/>
</FrameLayout>
