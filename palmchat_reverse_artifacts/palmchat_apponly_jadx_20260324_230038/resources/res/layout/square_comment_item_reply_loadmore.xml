<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loadMoreLayout"
    android:background="@color/white"
    android:paddingLeft="62dp"
    android:paddingBottom="10dp"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#6683c0"
            android:gravity="center"
            android:id="@+id/loadMoreTv"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示更多回复"
            android:drawablePadding="2dp"/>
    </LinearLayout>
    <com.zenmen.square.comment.widget.VideoTabLoadingView
        android:layout_gravity="center"
        android:id="@+id/loadMoreView"
        android:background="@color/square_translucent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:square_initial_left_color="@color/square_loading_ball_blue"
        app:square_initial_right_color="@color/square_loading_ball_red"/>
</FrameLayout>
