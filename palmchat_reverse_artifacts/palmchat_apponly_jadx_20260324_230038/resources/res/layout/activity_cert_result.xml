<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/color_trans"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        android:layout_marginStart="@dimen/dimen_16">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back"
            android:paddingTop="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_arrow"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/color_222222"
            android:layout_gravity="center"
            android:paddingTop="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_my_cert_zrrz_title"/>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_26"
        android:layout_marginStart="@dimen/dimen_32"
        android:layout_marginEnd="@dimen/dimen_32">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <RelativeLayout
                android:id="@+id/portrait_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_portrait"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:src="@drawable/default_portrait"/>
                <com.zenmen.palmchat.widget.RoundCornerCoverView
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    app:cornerRad="@dimen/dimen_18"/>
                <ImageView
                    android:id="@+id/iv_cert_result"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_cert_result_success"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_reviewing"
                    android:background="@drawable/bg_cert_result_reviewing"
                    android:paddingTop="@dimen/dimen_6"
                    android:paddingBottom="@dimen/dimen_6"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/string_cert_result_reviewing"
                    android:layout_alignBottom="@+id/iv_portrait"
                    android:paddingStart="@dimen/dimen_8"
                    android:paddingEnd="@dimen/dimen_8"
                    android:layout_alignEnd="@+id/iv_portrait"/>
            </RelativeLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="@string/string_cert_result_cur_portrait"
                android:layout_below="@+id/portrait_container"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_scan_result"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:src="@drawable/default_portrait"/>
            <com.zenmen.palmchat.widget.RoundCornerCoverView
                android:layout_width="148dp"
                android:layout_height="148dp"
                app:cornerRad="@dimen/dimen_18"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="@string/string_cert_result_scan_result"
                android:layout_below="@+id/iv_scan_result"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#00c85a"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cert_success_reminder"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:text="@string/string_cert_result_success_reminder"
        android:lines="1"
        android:drawablePadding="@dimen/dimen_5"
        android:drawableStart="@drawable/ic_cert_result_success_reminder"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/Ba"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cert_fail_reminder"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:text="@string/string_cert_result_fail_reminder"
        android:lines="1"
        android:drawablePadding="@dimen/dimen_5"
        android:drawableStart="@drawable/ic_cert_result_fail_reminder"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cert_result_btn1"
        android:background="@drawable/bg_cert_guide_to_cert"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:text="@string/string_cert_result_back"
        android:paddingStart="106dp"
        android:paddingEnd="106dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/Aa"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cert_result_btn2"
        android:background="@drawable/bg_cert_result_rescan"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:text="@string/string_cert_result_rescan"
        android:paddingStart="106dp"
        android:paddingEnd="106dp"/>
</LinearLayout>
