        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/tv_friend_empty"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
