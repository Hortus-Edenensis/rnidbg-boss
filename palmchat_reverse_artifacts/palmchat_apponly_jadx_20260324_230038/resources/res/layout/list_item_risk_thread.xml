<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/notice"
        android:background="#ffe4e4"
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginLeft="17dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_risk_thread_notice"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#d75858"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系统对异常用户进行消息拦截，请注意保护个人信息"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/contentLayout"
        android:background="@drawable/selector_thread_item_background"
        android:paddingLeft="8dp"
        android:paddingRight="@dimen/dimen_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zenmen.palmchat.widget.LXPortraitView
            android:id="@+id/icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:text_size="10dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/lyt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_toLeftOf="@+id/date"
                    app:alignItems="center"
                    app:flexDirection="row"
                    app:flexWrap="nowrap"
                    app:justifyContent="flex_start">
                    <TextView
                        android:textSize="@dimen/B2"
                        android:textColor="@color/Gb"
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标题"
                        android:lines="1"
                        app:layout_flexShrink="1"/>
                </com.google.android.flexbox.FlexboxLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/message_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="40dp"
                    android:layout_below="@+id/lyt_title">
                    <TextView
                        android:id="@+id/message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="消息"
                        style="@style/thread_item_sub_title"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时间"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    style="@style/text_small_content"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/noMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="42dp">
        <View
            android:background="#999"
            android:layout_width="16dp"
            android:layout_height="1dp"
            android:layout_margin="7dp"/>
        <TextView
            android:textColor="#999"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/riskShowTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="异常消息记录本地仅保留30天"/>
        <View
            android:background="#999"
            android:layout_width="16dp"
            android:layout_height="1dp"
            android:layout_margin="7dp"/>
    </LinearLayout>
</LinearLayout>
