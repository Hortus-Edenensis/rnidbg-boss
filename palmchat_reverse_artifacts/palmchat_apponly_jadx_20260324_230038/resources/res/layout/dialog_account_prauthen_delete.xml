<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#b4000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/pr_authen_delete_dialog_bg"
        android:layout_width="320dp"
        android:layout_height="233dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="温馨提示"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxWidth="276dp"
            android:text="目前仅支持通过注销当前账号的方式进行自助删除身份认证信息，如有其他需要，请联系客服处理。"
            android:maxLines="3"
            android:includeFontPadding="false"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="16dp"
                android:textColor="#222222"
                android:gravity="center"
                android:id="@+id/pr_authen_dialog_delete"
                android:background="@drawable/pr_authen_dialog_white_bg"
                android:layout_width="130dp"
                android:layout_height="44dp"
                android:text="注销账号"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/pr_authen_dialog_cancel"
                android:background="@drawable/pr_authen_dialog_green_bg"
                android:layout_width="130dp"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                android:text="取消操作"
                android:layout_toRightOf="@+id/pr_authen_dialog_delete"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
