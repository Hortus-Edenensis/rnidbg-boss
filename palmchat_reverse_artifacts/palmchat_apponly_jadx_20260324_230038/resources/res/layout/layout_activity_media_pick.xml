<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <GridView
        android:gravity="center"
        android:id="@+id/media_grid_view"
        android:background="@color/Ca"
        android:scrollbars="vertical"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:listSelector="@android:color/transparent"
        android:horizontalSpacing="3dp"
        android:verticalSpacing="3dp"
        android:columnWidth="0dp"
        android:numColumns="3"
        android:layout_below="@+id/toolbar"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/color_FFFFFF"
        android:gravity="center"
        android:id="@+id/date_text"
        android:background="#80000000"
        android:paddingLeft="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_below="@+id/toolbar"/>
    <View
        android:id="@+id/media_folder_pick_bg_view"
        android:background="#bc000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomContainer"
        android:layout_below="@+id/toolbar"/>
    <FrameLayout
        android:id="@+id/media_folder_pick_layout"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomContainer"
        android:layout_below="@+id/toolbar">
        <ListView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
            android:scrollbarStyle="insideOverlay"
            android:layout_gravity="bottom"
            android:id="@+id/media_folder_pick_list"
            android:background="@android:color/white"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:divider="@color/Fb"
            android:dividerHeight="1px"
            android:smoothScrollbar="true"
            android:scrollbarDefaultDelayBeforeFade="1000"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:background="@color/color_FFFFFF"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/media_folder_pick_area"
                android:paddingLeft="16dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <TextView
                    android:enabled="false"
                    android:gravity="center_vertical"
                    android:id="@+id/media_folder_pick_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_grid_all"
                    style="@style/text_normal_content"/>
                <ImageView
                    android:paddingTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:src="@drawable/selector_ic_triangle"
                    android:layout_toRightOf="@+id/media_folder_pick_btn"/>
            </LinearLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/originSizeTv"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/photo_preview_image_size"
                android:drawableLeft="@drawable/icon_photo_origin"
                android:drawablePadding="5dp"
                android:layout_centerInParent="true"
                style="@style/text_normal_content"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/toolbar_custom_btn_text_color_btn"
                android:gravity="center"
                android:id="@+id/tv_action"
                android:background="@drawable/selector_big_button_green"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginRight="16dp"
                android:text="@string/media_pick_activity_send"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <View
                android:background="#282828"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginRight="16dp"
                android:layout_toLeftOf="@+id/tv_action"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toast_container"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
