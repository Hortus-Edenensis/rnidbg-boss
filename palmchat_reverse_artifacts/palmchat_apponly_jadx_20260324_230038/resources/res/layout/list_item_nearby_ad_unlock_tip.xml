<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_unlock_layout"
    android:background="@color/ad_bt_unlock_bg"
    android:paddingLeft="@dimen/ad_dimen_12"
    android:paddingRight="@dimen/ad_dimen_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ad_bt_tip_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/ad_unlock_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ad_dimen_7"
        android:layout_marginBottom="@dimen/ad_dimen_7"
        android:text="@string/ad_nearby_unlock"
        android:singleLine="true"
        android:includeFontPadding="false"/>
</LinearLayout>
