<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f9f9f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <ScrollView
        android:id="@+id/scv_user_detail"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="19dp"
                android:textColor="#333333"
                android:layout_gravity="center_horizontal"
                android:id="@+id/nearby_gender_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="74dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#999999"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nearby_complete_gender_label"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/gender_area"
                android:padding="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/male_area"
                    android:padding="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_male"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/nearby_male_new"/>
                    <ImageView
                        android:id="@+id/iv_check_male"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/nearby_check_new"
                        android:layout_alignRight="@+id/iv_male"
                        android:layout_alignBottom="@+id/iv_male"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/string_male"
                        android:layout_below="@+id/iv_male"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <RelativeLayout
                    android:id="@+id/female_area"
                    android:padding="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_female"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/nearby_female_new"/>
                    <ImageView
                        android:id="@+id/iv_check_female"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/nearby_check_new"
                        android:layout_alignRight="@+id/iv_female"
                        android:layout_alignBottom="@+id/iv_female"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/string_female"
                        android:layout_below="@+id/iv_female"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:enabled="true"
                android:id="@+id/action_button"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="25dp"
                android:text="@string/nearby_complete_gender_btn"
                style="@style/btn_green_solid"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
