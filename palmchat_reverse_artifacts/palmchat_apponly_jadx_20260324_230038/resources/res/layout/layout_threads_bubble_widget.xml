<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="90dp"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/bubble_close"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bubble_close"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/bubble_image"
        android:layout_width="90dp"
        android:layout_height="105dp"
        android:scaleType="fitCenter"
        android:layout_below="@+id/bubble_close"/>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="#f52424"
        android:gravity="center"
        android:id="@+id/bubble_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:text="@string/bubble_countdown"
        android:maxLines="2"
        android:layout_below="@+id/bubble_image"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
