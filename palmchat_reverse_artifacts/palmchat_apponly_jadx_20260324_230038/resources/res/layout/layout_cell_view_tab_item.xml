<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="@dimen/group_item_height">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/cell_label_relativelayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/cell_label"
            android:background="@drawable/shape_red_round_corner_17dp"
            android:padding="@dimen/ad_dimen_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="热游推荐"
            android:maxEms="6"
            android:singleLine="true"
            android:maxLength="6"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cell_view_tab_item2_jiao"
            android:scaleType="centerCrop"
            android:layout_below="@+id/cell_label"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/cell_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_tab_cell_default2"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"
        app:esv_shape="round_rectangle"
        app:radius_x_dp="12dp"
        app:radius_y_dp="12dp"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/cell_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/cell_icon"
        android:layout_centerVertical="true"
        style="@style/text_normal_content"/>
    <com.zenmen.palmchat.widget.TabCellUnReadView
        android:id="@+id/cell_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_alignBaseline="@+id/cell_label_relativelayout"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/group_item_height"
        android:layout_toRightOf="@+id/cell_unread"
        android:layout_alignBaseline="@+id/cell_label_relativelayout">
        <FrameLayout
            android:id="@+id/cell_guide_layout"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:layout_gravity="center"
                android:id="@+id/cell_guide_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitXY"/>
            <View
                android:layout_gravity="top|right"
                android:id="@+id/noticeRedDot"
                android:background="@drawable/red_circle_lbs_notify"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="1dp"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/unsend"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/status_fail"
        android:layout_toLeftOf="@+id/arrowIcon"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/arrowIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@drawable/list_ic_arrow"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
