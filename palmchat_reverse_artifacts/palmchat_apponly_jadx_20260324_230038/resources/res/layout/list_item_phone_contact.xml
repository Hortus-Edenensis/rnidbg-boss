<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_tiny"
        android:textColor="#888888"
        android:gravity="center_vertical"
        android:id="@+id/group_indicator"
        android:background="#ebebeb"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="23dp"
        android:text="A"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="52dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/portrait"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="13dp"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_normal"
                android:textColor="#353535"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="张三"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="#aaaaaa"
                android:ellipsize="end"
                android:id="@+id/nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="掌信：张三"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/friend_request_text_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/confirm_button"
            android:background="@drawable/selector_btn_green_trans"
            android:paddingLeft="16dp"
            android:paddingTop="7dp"
            android:paddingRight="16dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/accept_add_contact_request"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#d9d9d9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
</LinearLayout>
