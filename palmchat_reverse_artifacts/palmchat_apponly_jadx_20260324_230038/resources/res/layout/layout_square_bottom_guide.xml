<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="42dp">
    <ImageView
        android:id="@+id/square_guide_bottom_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/square_guide_bottom_icon_function"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/square_guide_bottom_close"
        android:paddingTop="12dp"
        android:paddingRight="6dp"
        android:paddingBottom="12dp"
        android:layout_width="24dp"
        android:layout_height="42dp"
        android:src="@drawable/square_guide_bottom_close"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:gravity="center"
        android:id="@+id/square_guide_bottom_open"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="10dp"
        android:minWidth="60dp"
        android:layout_toLeftOf="@+id/square_guide_bottom_close"
        android:layout_centerVertical="true"
        style="@style/btn_green_solid_28"/>
    <TextView
        android:textSize="@dimen/text_size_xsmall"
        android:textColor="@color/Gb"
        android:id="@+id/square_guide_bottom_info"
        android:paddingLeft="6dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/square_bottom_guide_info_permission"
        android:layout_toLeftOf="@+id/square_guide_bottom_open"
        android:layout_toRightOf="@+id/square_guide_bottom_icon"
        android:layout_centerVertical="true"/>
</RelativeLayout>
