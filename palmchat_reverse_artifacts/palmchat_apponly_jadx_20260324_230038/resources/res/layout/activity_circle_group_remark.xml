<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <TextView
        android:textSize="22dp"
        android:textColor="@color/text_color_363636"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/group_anthor_name"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/text_color_999"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/group_remark_tip"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="16dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_head"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"
            app:esv_shape="circle"
            app:radius_x="13"
            app:radius_y="13"/>
        <com.zenmen.palmchat.widget.ClearEditText
            android:textSize="15dp"
            android:textColor="@color/text_color_363636"
            android:textColorHint="@color/color_999999"
            android:gravity="center"
            android:id="@+id/edit"
            android:background="@drawable/selector_edit_text_underline_green"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="15dp"
            android:hint="请填写备注名"
            android:singleLine="true"
            android:textCursorDrawable="@null"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:id="@+id/tv_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="63dp"
        android:layout_marginRight="48dp"
        android:text="@string/save"
        style="@style/btn_green_solid"/>
</LinearLayout>
