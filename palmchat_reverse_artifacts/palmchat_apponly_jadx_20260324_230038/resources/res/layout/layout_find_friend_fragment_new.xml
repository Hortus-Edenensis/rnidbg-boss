<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/topBgView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_find_friend_entrance_bg"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.square.ui.widget.FindSelectTabView
            android:id="@+id/find_tab_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/container"
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <RelativeLayout
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="scroll">
                    <RelativeLayout
                        android:id="@+id/rl_super_expose_tip_enter"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                </RelativeLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/find_friend_viewpager"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/rl_super_expose_in_effect_container"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="100dp"
        android:layout_marginBottom="154dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:id="@+id/iv_super_expose_in_effect_bg"
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <RelativeLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true">
            <com.zenmen.square.ui.widget.CircleProgressView
                android:id="@+id/cpv_super_expose"
                android:background="@drawable/bg_find_friend_right_bottom_progressbar"
                android:layout_width="match_parent"
                android:layout_height="54dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_222222"
                android:gravity="center_horizontal"
                android:id="@+id/tv_super_expose_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_222222"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="曝光"
                android:includeFontPadding="false"
                android:layout_below="@+id/tv_super_expose_number"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.zenmen.square.ui.widget.FindMapEntryView
        android:layout_gravity="bottom|right"
        android:id="@+id/rl_find_map_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
