<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/chat_mate_activity_status_layout"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <View
                android:background="#ffecec"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/chat_mate_activity_status_receiver"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff3984"
                    android:gravity="center_vertical"
                    android:id="@+id/receiver_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#999999"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="后对方将选择礼物赠送对象，最佳聊友可独享礼物"
                    android:lines="1"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/chat_mate_activity_status_send"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="14dp">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#999999"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="送礼倒计时："/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ff3984"
                        android:gravity="center_vertical"
                        android:id="@+id/send_time"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="00:00"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:textColor="#fc4183"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/chat_mate_activity_status_title"
                        android:background="@drawable/chat_mate_activity_next_btn_bg"
                        android:layout_width="66dp"
                        android:layout_height="26dp"
                        android:text="礼物送她"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btn_next"
                        android:background="@drawable/chat_mate_activity_send_gift_bg"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginLeft="12dp"
                        android:text="聊下一个/2人"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="bottom|right"
            android:orientation="vertical"
            android:id="@+id/chat_mate_send_pop_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="38dp">
            <TextView
                android:textSize="10dp"
                android:textColor="#fc4183"
                android:gravity="center"
                android:background="@drawable/chat_mate_activity_send_pop_bg"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="有新人加入了！点击去聊"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@drawable/chat_mate_activity_send_pop_text_jt"
                android:layout_width="12dp"
                android:layout_height="8dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
