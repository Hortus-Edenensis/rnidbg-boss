<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_call_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/video_call_icon_loading_fail_bg"
        android:scaleType="centerCrop"/>
    <TextureView
        android:id="@+id/video_screen_render_sv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/video_window_render_fl"
        android:background="@drawable/bg_float_window_voice"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="130dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/background_fl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/video_call_icon_loading_fail_bg"
            android:scaleType="centerCrop"/>
        <TextureView
            android:id="@+id/video_window_render_sv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/float_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/video_call_swap_screen_normal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/headimage_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="52dp"
        android:layout_marginRight="24dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_portrait"
            android:layout_width="79dp"
            android:layout_height="79dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp">
            <TextView
                android:textSize="@dimen/A2"
                android:textStyle="bold"
                android:textColor="@color/Ab"
                android:ellipsize="end"
                android:layout_gravity="left"
                android:id="@+id/audio_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dad"
                android:singleLine="true"
                android:shadowColor="@color/black"
                android:shadowRadius="2"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/Ab"
                android:id="@+id/calling_hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dadsfasdfasdfasdffa"
                android:shadowColor="@color/black"
                android:shadowRadius="2"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/pre_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/pre_hangup_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/pre_hangup_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_re_voip_hangup"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@android:color/white"
                android:id="@+id/hangup_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="拒绝"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/pre_accept_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/pre_accept_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_re_voip_accept"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@android:color/white"
                android:id="@+id/accept_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="接听"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/silence_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/silence_iv"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_re_voip_silence"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/white"
                android:id="@+id/silence_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="静音"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/speaker_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/speaker_iv"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_re_voip_speaker"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/white"
                android:id="@+id/speaker_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="免提"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/camera_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/camera_iv"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_re_voip_camera"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/white"
                android:id="@+id/camera_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="摄像头已关"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/act_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/hangup_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/hangup_iv"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:src="@drawable/ic_re_voip_hangup"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/accept_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/accept_iv"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:src="@drawable/ic_re_voip_accept"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"/>
        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/swap_iv"
                android:padding="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_re_voip_swap2"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/white"
        android:id="@+id/call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:shadowColor="@color/black"
        android:shadowRadius="2"
        app:layout_constraintBottom_toTopOf="@+id/button_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
