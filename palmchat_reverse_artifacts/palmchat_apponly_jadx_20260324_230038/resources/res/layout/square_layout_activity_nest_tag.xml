<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/portrait_blur"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_nest_tag_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/color_trans"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:id="@+id/rl_second_toolbar"
        android:background="@color/white"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/iv_arrow_back"
                android:paddingLeft="16dp"
                android:paddingTop="15dp"
                android:paddingRight="8dp"
                android:paddingBottom="9dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/selector_arrow_back"
                android:layout_alignParentLeft="true"
                android:onClick="onBackClick"/>
            <TextView
                android:textSize="18dp"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_second_title_name"
                android:layout_width="138dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerInParent="true"
                style="@style/blackStyle"/>
            <TextView
                android:textColor="@color/Aa"
                android:gravity="center"
                android:id="@+id/btn_second_title_private_chat"
                android:background="@drawable/square_stroke_btn_bg"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="私聊"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/btn_green_solid_xsmall"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.zenmen.square.ui.widget.NestTagInfoView
        android:id="@+id/rl_tag_tool_bar"
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_below="@+id/rl_second_toolbar"/>
</RelativeLayout>
