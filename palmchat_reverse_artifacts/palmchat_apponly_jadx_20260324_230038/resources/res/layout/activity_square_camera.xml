<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_camera"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/addContainer"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="9:17.7"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_view"/>
    <ImageView
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="27dp"
        android:src="@drawable/camera_back"
        android:onClick="back"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/duration"
        android:background="@drawable/shape_ff6262_12"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_fl"
        app:layout_constraintLeft_toLeftOf="@+id/btn_fl"
        app:layout_constraintRight_toRightOf="@+id/btn_fl"/>
    <View
        android:id="@+id/pick_cover"
        android:background="@drawable/shape_pick"
        android:layout_width="44dp"
        android:layout_height="22dp"
        android:layout_marginRight="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_view"
        app:layout_constraintLeft_toLeftOf="@+id/btn_fl"
        app:layout_constraintRight_toRightOf="@+id/btn_fl"
        app:layout_constraintTop_toTopOf="@+id/tab_view"/>
    <com.zenmen.media.camera.ui.HorizontalPicker
        android:textSize="13dp"
        android:textColor="@color/text_pick_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tab_view"
        android:layout_width="250dp"
        android:layout_height="28dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_fl"
        app:layout_constraintLeft_toLeftOf="@+id/btn_fl"
        app:layout_constraintRight_toRightOf="@+id/btn_fl"
        app:sideItems="2"/>
    <FrameLayout
        android:id="@+id/btn_fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.zenmen.media.SquareRecordButton
            android:id="@+id/camera_record_button"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"/>
        <com.zenmen.media.SquarePhotoButton
            android:id="@+id/camera_photo_button"
            android:visibility="visible"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/square_camera_btn"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginRight="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_fl"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_fl">
        <ImageView
            android:id="@+id/swap"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/camera_swap"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:id="@+id/swap_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="翻转"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_fl"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_fl">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/camera_album"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="回忆"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/album_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/album"
        app:layout_constraintLeft_toLeftOf="@+id/album"
        app:layout_constraintRight_toRightOf="@+id/album">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:background="@drawable/shape_square_album_tips_bg"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布相册内容"/>
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/square_camera_album_tips_icon"
            android:layout_width="8dp"
            android:layout_height="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
