<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/toolbar"
            layout="@layout/layout_toolbar_custom_button"/>
        <androidx.core.widget.NestedScrollView
            android:paddingBottom="@dimen/dimen_86"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:background="@color/white"
                    android:paddingLeft="15dp"
                    android:paddingTop="@dimen/feed_dp_12"
                    android:paddingBottom="@dimen/feed_dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.EffectiveShapeView
                        android:id="@+id/layout_circle_notedetail_head"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/default_portrait"
                        android:scaleType="centerCrop"
                        app:esv_shape="round_rectangle"
                        app:radius_x="6"
                        app:radius_y="6"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/color_222222"
                        android:ellipsize="end"
                        android:id="@+id/layout_circle_notedetail_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:lines="1"
                        android:layout_toRightOf="@+id/layout_circle_notedetail_head"
                        android:layout_alignTop="@+id/layout_circle_notedetail_head"
                        style="@style/settings_main_text_black"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/text_color_999"
                        android:id="@+id/layout_circle_notedetail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_below="@+id/layout_circle_notedetail_name"
                        android:layout_alignLeft="@+id/layout_circle_notedetail_name"/>
                </RelativeLayout>
                <View
                    android:background="#e3e3e3"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="@dimen/feed_dp_15"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:paddingLeft="15dp"
                    android:paddingTop="14dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/text_color_666666"
                        android:gravity="left"
                        android:id="@+id/layout_circle_notedetail_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/settings_main_text_black"/>
                    <View
                        android:id="@+id/layout_circle_notedetail_divider"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"/>
                    <ImageView
                        android:id="@+id/layout_circle_notedetail_img"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/default_portrait"
                        android:scaleType="centerCrop"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layout_circle_notedetail_tab"
                    android:background="@color/white"
                    android:paddingTop="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/color_222222"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/layout_circle_notedetail_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/color_222222"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/layout_circle_notedetail_not_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="7.5dp"/>
                <View
                    android:id="@+id/circle_notice_bottom_divider"
                    android:background="#e3e3e3"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="@dimen/feed_dp_15"
                    android:layout_marginRight="@dimen/feed_dp_15"/>
                <View
                    android:id="@+id/bg_circle_note_gap"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="7.5dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/layout_circle_notedetail_list"
                    android:background="@color/white"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:layout_gravity="bottom"
        android:id="@+id/circle_note_edit_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="31dp"
        android:text="编辑公告"
        android:layout_weight="1"
        android:onClick="toEditCircleNote"
        style="@style/btn_green_solid"/>
</FrameLayout>
