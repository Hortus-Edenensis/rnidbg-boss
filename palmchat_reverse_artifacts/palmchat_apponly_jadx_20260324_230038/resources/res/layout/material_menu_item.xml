<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:id="@+id/menu_item_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="title"
            android:drawablePadding="@dimen/material_menu_drawable_padding"
            style="@style/text_normal_content"/>
        <TextView
            android:id="@+id/sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sub_text"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/text_middle_content"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/divider"
        android:background="@drawable/list_item_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
