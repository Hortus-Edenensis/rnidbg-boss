<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <RelativeLayout
        android:id="@+id/layout_panel_one"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_panel_one"
            android:focusable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/red_dot_one"
            android:background="@drawable/red_circle"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginBottom="-5dp"
            android:layout_above="@+id/iv_panel_one"
            android:layout_marginStart="-5dp"
            android:layout_toEndOf="@+id/iv_panel_one"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_panel_two"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_panel_two"
            android:focusable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/red_dot_two"
            android:background="@drawable/red_circle"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginBottom="-5dp"
            android:layout_above="@+id/iv_panel_two"
            android:layout_marginStart="-5dp"
            android:layout_toEndOf="@+id/iv_panel_two"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_panel_three"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_panel_three"
            android:focusable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/red_dot_three"
            android:background="@drawable/red_circle"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginBottom="-5dp"
            android:layout_above="@+id/iv_panel_three"
            android:layout_marginStart="-5dp"
            android:layout_toEndOf="@+id/iv_panel_three"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_panel_four"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_panel_four"
            android:focusable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/red_dot_four"
            android:background="@drawable/red_circle"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginBottom="-5dp"
            android:layout_above="@+id/iv_panel_four"
            android:layout_marginStart="-5dp"
            android:layout_toEndOf="@+id/iv_panel_four"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/add_button"
        android:padding="10dp"
        android:focusable="true"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/selector_background_input_add_button"
        android:layout_weight="1"/>
</LinearLayout>
