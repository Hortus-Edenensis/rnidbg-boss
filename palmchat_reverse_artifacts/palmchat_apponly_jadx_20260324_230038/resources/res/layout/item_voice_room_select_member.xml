<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="44dp"
    android:layout_height="40dp">
    <RelativeLayout
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_centerInParent="true">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"
            app:esv_shape="circle"
            app:radius_x_dp="15dp"
            app:radius_y_dp="15dp"/>
        <ImageView
            android:id="@+id/iv_select_ring"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@drawable/shape_ring_voice_room_select_item"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/text_voice_room_select_item_name"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:background="@drawable/selector_voice_room_select_item_name"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
