<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <RelativeLayout
        android:id="@+id/layout_action"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/layout_action_text"
            android:background="@drawable/item_tool_content_bg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:text="+"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/image_head_group"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_action"
        app:layout_constraintTop_toTopOf="parent">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/image_head"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/default_portrait"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="12dp"
            app:radius_y_dp="12dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/text_tool_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        app:layout_constraintBottom_toTopOf="@+id/text_tool_subtitle"
        app:layout_constraintStart_toEndOf="@+id/image_head_group"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/text_normal_content"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#ffffffff"
        android:id="@+id/text_tool_status"
        android:background="@drawable/shape_room_setting_audit_bg"
        android:paddingLeft="3dp"
        android:paddingTop="2dp"
        android:paddingRight="3dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="审核中"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/text_tool_name"
        app:layout_constraintStart_toEndOf="@+id/text_tool_name"
        app:layout_constraintTop_toBottomOf="@+id/text_tool_name"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/Ge"
        android:id="@+id/text_tool_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text_tool_name"
        app:layout_constraintTop_toBottomOf="@+id/text_tool_name"/>
    <ImageView
        android:id="@+id/image_tool_arrow"
        android:src="@drawable/list_ic_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/right_arrow_size"/>
</androidx.constraintlayout.widget.ConstraintLayout>
