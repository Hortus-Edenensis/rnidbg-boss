<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/image_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_item_portrait_view_size_margin_right_top"
                android:layout_marginRight="@dimen/chat_item_portrait_margin_left_or_right"
                android:layout_toLeftOf="@+id/portrait">
                <RelativeLayout
                    android:id="@+id/image_click_area"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.AutoResizeGifImageView
                        android:id="@+id/image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"/>
                    <ImageView
                        android:id="@+id/specialExpressionIv"
                        android:visibility="gone"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:scaleType="fitXY"/>
                    <ImageView
                        android:id="@+id/gif_shadow"
                        android:background="@drawable/gif_shadow"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/gif_down"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/gif_download"
                    android:scaleType="centerInside"
                    android:layout_centerInParent="true"/>
                <com.zenmen.palmchat.widget.DownloadProgressBar
                    android:id="@+id/downloadProgress"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/gif_size"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="11.2M"
                    android:layout_alignRight="@+id/image_click_area"
                    android:layout_alignBottom="@+id/image_click_area"/>
                <ImageView
                    android:id="@+id/image_loading_fail"
                    android:paddingRight="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_loading_fail"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/image_container"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_centerInParent="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
