<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#9b9b9b"
            android:id="@+id/send_msg_notice_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/recommend_request_send_edit_notice_tv"/>
        <EditText
            android:textSize="@dimen/text_size_small"
            android:textColor="#4a4a4a"
            android:gravity="left"
            android:id="@+id/request_information"
            android:background="@drawable/recommend_request_send_edit_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:text=""
            android:maxLines="3"
            android:lineSpacingMultiplier="1.1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/remark_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="@dimen/text_size_tiny"
                android:textColor="#9b9b9b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommend_request_send_edit_remark_tv"/>
            <EditText
                android:textSize="@dimen/text_size_small"
                android:textColor="#4a4a4a"
                android:textColorHint="@color/divider_gray"
                android:id="@+id/remark_edit"
                android:background="@drawable/recommend_request_send_edit_bg"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:hint="@string/new_remark_name"
                android:singleLine="true"
                android:textCursorDrawable="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/remark_recommend_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="@dimen/text_size_tiny"
                android:textColor="#9b9b9b"
                android:id="@+id/remark_recommend_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommend_request_send_remark_recommend_tip"
                android:layout_toLeftOf="@+id/remark_recommend_btn"
                android:layout_centerVertical="true"/>
            <TextView
                android:textColor="#04b4a2"
                android:id="@+id/remark_recommend_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text="@string/recommend_request_send_remark_recommend_btn"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/action_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            style="@style/btn_green_solid">
            <TextView
                android:enabled="true"
                android:textSize="@dimen/text_size_normal"
                android:textColor="@color/text_color_btn_green"
                android:gravity="center"
                android:id="@+id/action_textview"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:text="@string/send"
                android:drawablePadding="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
