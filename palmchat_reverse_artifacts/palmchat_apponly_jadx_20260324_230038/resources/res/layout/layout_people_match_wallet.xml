<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.wallet.WalletWebview
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/backBtn"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:src="@drawable/selector_arrow_back"
        android:scaleType="fitCenter"/>
    <RelativeLayout
        android:id="@+id/errorView"
        android:background="#f8f8fa"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/toolbar"
            layout="@layout/layout_toolbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/errorIv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:src="@drawable/people_match_failed"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#aaaaaa"
                android:layout_gravity="center_horizontal"
                android:paddingLeft="42dp"
                android:paddingRight="42dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/people_match_default_error"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#fe4967"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/refreshBtn"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/people_match_refresh"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
