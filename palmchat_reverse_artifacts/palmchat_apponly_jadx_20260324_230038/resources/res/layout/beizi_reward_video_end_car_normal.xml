<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/beizi_reward_video_ad_end_car_image_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="#b2000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/beizi_reward_video_ad_end_car_interaction_container_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="30dp"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/beizi_reward_video_ad_end_car_interaction_iv"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/beizi_reward_video_ad_end_car_interaction_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/beizi_reward_video_ad_end_car_interaction_container_ll">
        <com.beizi.ad.internal.view.CustomRoundImageView
            android:id="@+id/beizi_reward_video_ad_end_car_app_icon_iv"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginBottom="15dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/beizi_reward_video_ad_end_car_app_title_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/beizi_reward_video_ad_end_car_app_subtitle_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"/>
    </LinearLayout>
</RelativeLayout>
