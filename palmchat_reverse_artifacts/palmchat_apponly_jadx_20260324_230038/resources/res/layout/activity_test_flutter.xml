<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root_content"
    android:background="@color/color_00AC9A"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fragment_stub"
        android:layout_width="match_parent"
        android:layout_height="400dp"/>
    <Button
        android:id="@+id/open_flutter_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="打开flutter页面"/>
    <Button
        android:id="@+id/call_flutter_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="调用flutter事件"/>
    <Button
        android:id="@+id/show_flutter_with_fragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示flutterFragment"/>
    <Button
        android:id="@+id/show_flutter_with_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示flutterView"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
