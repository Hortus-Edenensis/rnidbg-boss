<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="10dp"
    android:paddingRight="16dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:id="@+id/tv_nearby_divider_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/square_nearby_list_bottom_guide"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/Aa"
            android:gravity="center"
            android:id="@+id/btn_condition"
            android:background="@drawable/shape_nearby_condition_btn_bg"
            android:layout_width="156dp"
            android:layout_height="38dp"
            android:layout_marginTop="20dp"
            android:text="设置筛选条件"
            android:layout_below="@+id/tv_nearby_divider_text1"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
