<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mine_head_group_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp">
    <RelativeLayout
        android:id="@+id/rl_root"
        android:background="@drawable/vip_card_putway_bg"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:paddingStart="20dp">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/vip_icon_vip_card"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/color_84440C"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="连信会员"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/iv_avatar"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="27dp"
            android:layout_toStartOf="@+id/iv_arrow"
            android:layout_alignParentEnd="true">
            <com.zenmen.palmchat.mine.view.LoopTextView
                android:textSize="12dp"
                android:textColor="@color/color_A05717"
                android:id="@+id/tv_tips"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="最贵特权等你来开启"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/vip_dot"
                android:background="@drawable/red_circle_lbs_notify"
                android:visibility="gone"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="11dp"
                android:layout_toRightOf="@+id/tv_tips"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_arrow"
            android:paddingTop="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/minehead_jiantou"
            android:scaleType="centerCrop"
            android:paddingEnd="14dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/vip_banner"
        android:background="@drawable/shape_topic_banner_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_new_root"
        android:background="@drawable/vip_card_new_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/color_84440C"
                android:id="@+id/tv_new_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的特权"
                android:maxLines="1"
                android:drawableLeft="@drawable/new_vip_icon_vip_card"
                android:drawablePadding="5dp"/>
            <com.zenmen.palmchat.mine.view.LoopTextView
                android:textSize="12dp"
                android:textColor="@color/color_A05717"
                android:id="@+id/tv_new_tips"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/tv_new_title"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_root"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/desc_container"
                android:background="@drawable/vip_card_desc_bg"
                android:layout_width="wrap_content"
                android:layout_height="31dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_A05717"
                    android:gravity="center"
                    android:id="@+id/tv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.zenmen.palmchat.widget.LightingAnimationView
                android:id="@+id/anim_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:la_w="18dp"
                app:layout_constraintBottom_toBottomOf="@+id/desc_container"
                app:layout_constraintLeft_toLeftOf="@+id/desc_container"
                app:layout_constraintRight_toRightOf="@+id/desc_container"
                app:layout_constraintTop_toTopOf="@+id/desc_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</RelativeLayout>
