<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/media_root_layout"
    android:background="@drawable/bg_location_head"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/head_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/Gb"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相册内容"/>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginRight="14dp"
            android:src="@drawable/ic_media_pop_select_close"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/no_permission"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/head_layout">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_media_pop_select_empty"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#999"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="24dp"
            android:text="授权相册权限，才能分享相册中照片和视频哦"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/action"
            android:background="@drawable/square_btn_bg_24dp"
            android:layout_width="102dp"
            android:layout_height="40dp"
            android:text="去开启"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/head_layout">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/icon_square_load_state_empty"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#999"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="24dp"
            android:text="你的相册中无可用内容"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/open_camera"
            android:background="@drawable/square_btn_bg_24dp"
            android:layout_width="102dp"
            android:layout_height="40dp"
            android:text="去拍摄"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/list_layout"
        android:background="@color/white"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/media_select"
        android:layout_below="@+id/head_layout">
        <com.zenmen.media.album.pop.NestedRecyclerView
            android:id="@+id/media_grid_view"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/media_select"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/media_select_icon"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/square_media_pick_select_bg_green"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/Gb"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:id="@+id/media_select_title"
            android:paddingLeft="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="多选"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/Gd"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_multi_prompt"
            android:paddingLeft="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="（仅支持图片多选）"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/media_select_action"
            android:background="@drawable/selector_big_button_green"
            android:paddingLeft="22dp"
            android:paddingTop="9dp"
            android:paddingRight="22dp"
            android:paddingBottom="9dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确定"/>
    </LinearLayout>
</RelativeLayout>
