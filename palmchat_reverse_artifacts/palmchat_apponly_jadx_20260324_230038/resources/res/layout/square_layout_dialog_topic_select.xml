<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:background="@drawable/bg_location_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/A2"
            android:textStyle="bold"
            android:textColor="@color/Gb"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:paddingTop="40dp"
            android:paddingBottom="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_select_topic_dialog_title"/>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/square_icon_dialog_close"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/list_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="450dp">
        <com.zenmen.square.ui.widget.NestedScrollingListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@color/white"
            android:divider="@color/transparent"/>
        <ProgressBar
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            style="@style/LocationLoadingProgressBar"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#666666"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:text="话题获取失败，请稍后再试"/>
    </FrameLayout>
</LinearLayout>
