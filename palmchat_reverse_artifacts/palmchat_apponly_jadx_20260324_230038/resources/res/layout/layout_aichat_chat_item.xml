<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_chat_chat_act_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/chat_item_padding_left_or_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <com.zenmen.palmchat.widget.LXPortraitView
            android:id="@+id/portrait"
            android:layout_width="@dimen/chat_item_portrait_view_size"
            android:layout_height="@dimen/chat_item_portrait_view_size"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ai_msg_guard_layout"
            android:background="@drawable/ai_chat_chatactivity_item_layout_bg"
            android:layout_width="215dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/other_avatar_img"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="fitXY"
                    app:esv_shape="circle"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="25dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/ai_chat_act_item_like_bg"
                    android:scaleType="fitXY"/>
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/mine_avatar_img"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="12dp"
                    android:scaleType="fitXY"
                    app:esv_shape="circle"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_name_title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="16dp"
                android:maxWidth="180dp"
                android:text="守护Tutu的小丸子"
                android:lines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_desc"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginTop="4dp"
                android:maxWidth="180dp"
                android:text="获得聊天专属权益"
                android:lines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_button"
                android:background="@drawable/ai_chat_act_item_btn_bg"
                android:layout_width="137dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="去解锁"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
