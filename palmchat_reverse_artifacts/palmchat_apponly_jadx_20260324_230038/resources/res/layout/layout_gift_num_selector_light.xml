<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="32dp">
    <TextView
        android:textSize="@dimen/C2"
        android:textColor="@color/Gc"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数量"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_f5f5f5_radius_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp">
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:id="@+id/tv_num_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:id="@+id/tv_num_10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="10"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:id="@+id/tv_num_30"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="30"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:id="@+id/tv_num_66"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="66"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:id="@+id/tv_num_188"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="188"
            android:layout_weight="1"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_num_select"
            android:layout_width="47dp"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/C2"
                android:textColor="@color/Gc"
                android:gravity="center"
                android:id="@+id/tv_num_select"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="更多"
                android:drawableRight="@drawable/ic_gift_num_more_light"
                android:drawablePadding="1dp"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
