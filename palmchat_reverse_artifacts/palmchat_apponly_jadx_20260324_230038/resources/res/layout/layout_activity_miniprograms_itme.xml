<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="90dp">
    <com.zenmen.palmchat.webplatform.miniPrograms.widget.CircleImageView
        android:id="@+id/mini_program_item_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:src="@drawable/media_pick_grid_item_background"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="18dp"
        android:textColor="#000000"
        android:gravity="center_vertical"
        android:id="@+id/mini_program_item_name"
        android:layout_width="wrap_content"
        android:layout_height="90dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/mini_program_nearby"
        android:layout_toRightOf="@+id/mini_program_item_icon"/>
    <ImageView
        android:id="@+id/mini_more"
        android:layout_width="89dp"
        android:layout_height="35dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/mini_more"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/divider"
        android:background="#f6f6f6"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/divider_line"
        android:background="#e6e6e6"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="90dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
