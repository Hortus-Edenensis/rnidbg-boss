<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ad_root_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/ad_main_layout"
                android:layout_width="match_parent"
                android:layout_height="210dp">
                <ImageView
                    android:id="@+id/ad_bg_blur"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ad_img_video_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/ad_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"/>
                    <FrameLayout
                        android:id="@+id/ad_video"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:id="@+id/video_finish_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/video_finish_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/video_finish_restart"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/video_finish_restart"
                            android:scaleType="fitXY"/>
                    </FrameLayout>
                </FrameLayout>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:background="@drawable/nest_bg_bottom_ad_down"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"/>
                <com.wifi.adsdk.baseview.LxAdRoundCornerCoverView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_gravity="top|right"
                    android:id="@+id/ad_close"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/lx_temp_adsdk_close"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_gravity="top|right"
                    android:id="@+id/voice"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="40dp"
                    android:src="@drawable/lxad_voice_close"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="bottom|left"
                    android:id="@+id/ad_desc"
                    android:layout_width="178dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginBottom="35dp"
                    android:text="点击查看更多精彩内容"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:layout_gravity="bottom|left"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="13dp">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/ad_app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="推荐"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/logo_ad_layout"
                        android:background="@drawable/nest_mine_adsdk_tag_bg_style2"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="7dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/ad_logo"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/icon_lxad_logo"
                            android:scaleType="fitCenter"/>
                        <TextView
                            android:textSize="9dp"
                            android:textColor="#ffffff"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/ad_sign"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:text="@string/adsdk_generic_ad_group_normal"
                            android:lines="1"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="bottom|right"
                    android:orientation="horizontal"
                    android:id="@+id/ad_down_yaoyiyao_layout"
                    android:tag="ad_down_yaoyiyao_layout"
                    android:background="@drawable/nest_bg_square_btn_ad_down"
                    android:layout_width="129dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="13dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ad_yaoyiyao"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/yy_shake_bg"
                            android:background="@drawable/ad_yaoyiyao"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginLeft="5dp"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/yy_shake_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="摇一摇或"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/ad_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="点击下载"/>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.wifi.adsdk.baseview.AdComInfoAllLayoutNew2
            android:id="@+id/ad_com_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
