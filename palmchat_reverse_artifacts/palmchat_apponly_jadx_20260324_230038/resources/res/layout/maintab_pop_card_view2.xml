<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:contentPadding="0dp">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/contentLayout"
        android:background="@drawable/ic_main_pop_banner_bg"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="134dp">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#440106"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="恭喜获得一次批量打招呼机会"
            android:maxLines="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#69575a"
            android:ellipsize="end"
            android:id="@+id/subTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="你说好不好？"
            android:singleLine="true"
            android:layout_below="@+id/title"/>
        <ImageView
            android:id="@+id/contentImg"
            android:layout_width="138dp"
            android:layout_height="42dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/ic_main_pop_multi_img"
            android:scaleType="fitXY"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/ic_main_pop_small_btn"
            android:layout_width="106dp"
            android:layout_height="33dp"
            android:layout_marginBottom="11dp"
            android:text="立即开聊"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/ic_main_pop_close"/>
</androidx.cardview.widget.CardView>
