<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ad_view_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="5dp"
        app:cardCornerRadius="11dp">
        <View
            android:id="@+id/people_card_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ad_image_top"
                android:layout_width="match_parent"
                android:layout_height="234dp"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/ad_image_bottom"
                android:layout_width="match_parent"
                android:layout_height="234dp"
                android:scaleType="centerCrop"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/ad_video_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp">
            <View
                android:background="@drawable/shape_people_match_card_mask"
                android:layout_width="match_parent"
                android:layout_height="268dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_ad_close_tag"
                android:background="@drawable/ad_pm_tag_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="14dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_ad_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pm_icon_csj_logo"
                    android:tint="#dbdbdb"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="#dbdbdb"
                    android:gravity="center"
                    android:id="@+id/ad_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个性化广告"
                    android:drawablePadding="6dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:src="@drawable/ad_arrow"
                    android:tint="#dbdbdb"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_ad_close_pop_wrapper"
                android:background="@drawable/ic_ad_close_pop_bg"
                android:paddingTop="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintRight_toRightOf="@+id/ll_ad_close_tag"
                app:layout_constraintTop_toBottomOf="@+id/ll_ad_close_tag">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#dbdbdb"
                    android:gravity="center"
                    android:id="@+id/ll_ad_close_pop"
                    android:paddingLeft="6dp"
                    android:paddingTop="6dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不感兴趣"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#dbdbdb"
                    android:gravity="center"
                    android:id="@+id/ll_vip_entrance_pop"
                    android:paddingLeft="6dp"
                    android:paddingTop="6dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="超级会员免广告"/>
            </LinearLayout>
            <com.zenmen.palmchat.ad.view.ProgressButton
                android:gravity="center"
                android:id="@+id/ad_attatch_progress_btn"
                android:background="@drawable/ad_pm_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="25dp"
                android:text="了解详情"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="22dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/default_portrait"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/ad_attatch_progress_btn"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/ad_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="58dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="23dp"
                android:text="ad_name"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/ad_attatch_progress_btn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ad_icon"
                app:layout_constraintRight_toLeftOf="@+id/ad_permission"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#bebebe"
                android:id="@+id/ad_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="58dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="18dp"
                android:text="@string/string_ad_permission"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toTopOf="@+id/ad_attatch_progress_btn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ad_name"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="10dp"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/ad_icon"
                app:layout_constraintLeft_toLeftOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
