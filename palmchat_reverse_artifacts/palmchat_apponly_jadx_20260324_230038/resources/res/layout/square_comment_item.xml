<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/square_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/comment_item_divider"
            android:background="#f5f5f5"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginLeft="62dp"
            android:layout_marginRight="16dp"/>
        <View
            android:id="@+id/highLightView"
            android:background="#88dddddd"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/videosdk_comment_item_layout"
            android:layout_alignBottom="@+id/videosdk_comment_item_layout"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/videosdk_comment_item_layout"
            android:background="@drawable/square_comment_item_bg"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/commentUserAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/square_icon_default_portrait"
                app:square_esv_shape="circle"/>
            <ImageView
                android:id="@+id/commentUserGender"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/icon_sex_female"
                android:layout_alignRight="@+id/commentUserAvatar"
                android:layout_alignBottom="@+id/commentUserAvatar"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_toLeftOf="@+id/likeLayout"
                android:layout_toRightOf="@+id/commentUserAvatar">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#8c191c1c"
                        android:ellipsize="end"
                        android:id="@+id/nickName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/iv_verified"
                        android:padding="3dp"
                        android:visibility="gone"
                        android:layout_width="18dp"
                        android:layout_height="18dp"/>
                    <TextView
                        android:textSize="9dp"
                        android:textColor="#c0191c1c"
                        android:gravity="center"
                        android:id="@+id/iv_author_icon"
                        android:background="@drawable/square_comment_author_bg"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginLeft="6dp"
                        android:text="作者"/>
                    <ImageView
                        android:id="@+id/iv_vip"
                        android:visibility="visible"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginLeft="6dp"
                        android:src="@drawable/vip_icon_normal_small"/>
                </LinearLayout>
                <com.zenmen.square.comment.widget.RichTextView
                    android:textSize="14dp"
                    android:textColor="#191c1c"
                    android:ellipsize="end"
                    android:id="@+id/commentContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#8c191c1c"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#8c191c1c"
                        android:id="@+id/reply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · 回复"/>
                </LinearLayout>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#ff0000"
                    android:id="@+id/sendFailedTV"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="60dp"
                    android:text="点击重试"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#898c91"
                    android:id="@+id/authorLiked"
                    android:background="#f0f1f2"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="作者赞过"/>
            </LinearLayout>
            <com.zenmen.square.comment.ui.CommentLikeView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/likeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_alignParentRight="true">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/likeIcon"
                    android:padding="3dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_praise_selected_new"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/likeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="1"/>
            </com.zenmen.square.comment.ui.CommentLikeView>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
