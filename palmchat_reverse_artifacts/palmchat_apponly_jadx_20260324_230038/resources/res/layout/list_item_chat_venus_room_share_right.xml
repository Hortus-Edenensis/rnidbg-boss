<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/feed_card_layout"
                android:background="@drawable/selector_message_right_item_background_gender"
                android:paddingLeft="12dp"
                android:paddingTop="30dp"
                android:paddingRight="12dp"
                android:paddingBottom="30dp"
                android:layout_width="233dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/chat_item_portrait_margin_left_or_right"
                android:layout_toLeftOf="@+id/portrait">
                <com.zenmen.palmchat.widget.VenusPortraitView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/venus_portrait"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    app:venus_init_radius="26dp"
                    app:venus_max_radius="36dp"
                    app:venus_portrait_margin="10dp"
                    app:venus_text_size="10dp"/>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/venus_share_room_text_color"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/venus_title_before"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="我正在“"
                        android:lines="1"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/venus_share_room_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/venus_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxEms="5"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/venus_share_room_text_color"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/venus_title_after"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="”聊天"
                        android:lines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/venus_share_room_text_color"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/venus_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="邀请你进来一起玩"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/venus_btn"
                    android:background="@drawable/selector_message_right_item_btn_gender"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:text="去聊天"/>
            </LinearLayout>
            <TextView
                android:textSize="10dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/venus_source"
                android:background="@drawable/message_right_item_bg_source"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/chat_item_portrait_margin_left_or_right"
                android:layout_toLeftOf="@+id/portrait"
                android:layout_below="@+id/feed_card_layout"/>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/feed_card_layout"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
