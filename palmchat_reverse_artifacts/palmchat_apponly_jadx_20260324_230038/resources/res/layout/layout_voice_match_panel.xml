<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_voice_match_panel_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/user_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svga"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="400dp"/>
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon"
            android:visibility="visible"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_default_portrait"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:esv_shape="circle"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/retry_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="152dp">
        <ImageView
            android:id="@+id/empty_iv"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:src="@drawable/ic_voice_match_net_error"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#666"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/retry_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载失败，点击刷新"
            android:layout_centerHorizontal="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ab_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="152dp">
        <ImageView
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:src="@drawable/ic_voice_match_empty"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ab_des_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能内测中，仅受邀用户可参与"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#999"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ab_des_2"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="敬请期待哦~"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/match_info_layout"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/user_info_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/match_info_main_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:text=""
            android:singleLine="true"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:id="@+id/match_info_sub_loop_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#999"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/match_info_sub_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="语音匹配成功后仅展示基础信息，聊天超安全"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/fastmatching_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/user_info_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/fast_matching_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在加速匹配中"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:background="@drawable/voice_match_fast_matching_background"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="24dp">
            <ImageView
                android:id="@+id/fast_match_flash"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_voice_match_fast_matching_arrow"
                android:layout_centerVertical="true"
                android:alpha="0.1"/>
            <ImageView
                android:id="@+id/fastmatchingicon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_voice_match_prop_fast"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/fast_matching_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="10dp"
                android:text="匹配效率翻3倍"
                android:singleLine="true"
                android:layout_toRightOf="@+id/fastmatchingicon"
                android:layout_centerVertical="true"
                android:textAlignment="center"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/prop_card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/fast_guide_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fast_guide_content_layout"
                android:background="@drawable/ic_voice_match_card_bg_fast"
                android:paddingTop="2.5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7.5dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="73dp">
                    <ImageView
                        android:id="@+id/fast_icon"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_voice_match_card_fast"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:textColor="#222"
                                android:id="@+id/fast_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="加速卡"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#999"
                                android:id="@+id/fast_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="6dp"
                                android:text="10连信豆/次"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#999"
                            android:ellipsize="end"
                            android:id="@+id/fast_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="匹配效率提升3倍 · 失败不消耗"
                            android:singleLine="true"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/fast_btn"
                        android:background="@drawable/ic_voice_match_card_bg"
                        android:layout_width="92dp"
                        android:layout_height="34dp"
                        android:layout_marginRight="12dp"
                        android:text="一键加速"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="10dp"
                android:textColor="#fe7fcd"
                android:id="@+id/fast_guide_matching_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前排队人数99+"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/city_guide_layout"
            android:background="@drawable/ic_voice_match_card_bg_city"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="73dp"
            android:layout_marginTop="12dp"
            android:layout_alignParentBottom="true">
            <ImageView
                android:id="@+id/city_icon"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_voice_match_card_city"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:id="@+id/city_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="同城卡"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#999"
                        android:id="@+id/city_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="20连信豆/次"/>
                </LinearLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#999"
                    android:ellipsize="end"
                    android:id="@+id/city_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="匹配同城的Ta"
                    android:singleLine="true"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="92dp"
                android:layout_height="34dp"
                android:layout_marginRight="12dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/city_btn"
                    android:background="@drawable/ic_voice_match_card_bg"
                    android:layout_width="92dp"
                    android:layout_height="34dp"
                    android:text="立即使用"/>
                <com.zenmen.palmchat.widget.LightingAnimationView
                    android:id="@+id/anim_view1"
                    android:layout_width="92dp"
                    android:layout_height="34dp"
                    app:la_colors="#00FFFFFF,#E6FFFFFF,#E6FFFFFF,#00FFFFFF"
                    app:la_positions="0,0.4,0.5,1"
                    app:la_w="20dp"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <com.zenmen.palmchat.framework.bridge.voicomatch.MatchPropInfoCardView
        android:id="@+id/matching_fail_prop_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
