<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_settings_item_background"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.SocialPortraitView
        android:layout_gravity="center_vertical"
        android:id="@+id/portrait"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/default_portrait"
        android:scaleType="centerCrop"
        app:esv_shape="round_rectangle"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/tv_discuss_action"
        android:layout_toRightOf="@+id/portrait"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_000000"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/text_color_999"
            android:ellipsize="end"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#14cd64"
        android:gravity="center"
        android:id="@+id/tv_discuss_action"
        android:background="@drawable/shape_dicuss_topic_rectangle_round_corner"
        android:paddingLeft="9dp"
        android:paddingTop="5dp"
        android:paddingRight="9dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="参与讨论"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
