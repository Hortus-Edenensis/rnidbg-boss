<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:id="@+id/ll_compliance_board"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_view_container">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_compliance_board_inner"
            android:background="#b3ffe4e4"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:paddingStart="17dp"
            android:paddingEnd="23dp">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_chatter_compliance_board"
                android:layout_marginEnd="6dp"/>
            <com.zenmen.palmchat.mine.view.LoopTextView
                android:textColor="@color/color_666666"
                android:id="@+id/tv_compliance_board"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/contentBgImageView"
        android:background="@color/color_chat_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:layout_below="@+id/ll_compliance_board"/>
    <FrameLayout
        android:id="@+id/input_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <ListView
        android:gravity="bottom"
        android:id="@+id/message_list"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:scrollingCache="false"
        android:transcriptMode="normal"
        android:cacheColorHint="#00000000"
        android:divider="#00000000"
        android:dividerHeight="0dp"
        android:layout_above="@+id/input_fragment"
        android:layout_below="@+id/ll_compliance_board"
        android:splitMotionEvents="false"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#222"
        android:gravity="center"
        android:id="@+id/ai_greeting_profile_float_guide"
        android:background="@drawable/shape_ai_greeting_chat_card_close_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="20dp"
        android:text="完善资料+发动态，让AI更懂你!"
        android:drawableRight="@drawable/ic_ai_greeting_close_arrow"
        android:drawablePadding="2dp"
        android:layout_above="@+id/input_fragment"
        android:layout_alignParentRight="true"/>
    <View
        android:id="@+id/giftGapView"
        android:background="@drawable/shape_gift_quick_fade_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_alignBottom="@+id/message_list"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/chat_notice_receiver_mode"
        android:background="#dc000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:src="@drawable/ic_toast_receiver_mode"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="@string/chat_notice_current_audio_play_out_is_speaker"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/chat_notice_tv"
        android:background="#88000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/chat_notice_audio_play_out_speaker"/>
    <RelativeLayout
        android:id="@+id/recorder_layout"
        android:background="@drawable/shape_voice_recorder_background"
        android:visibility="gone"
        android:layout_width="130dp"
        android:layout_height="126dp"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@+id/recoder_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/voice_recorder"/>
                    <ImageView
                        android:id="@+id/volume_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/volume_one"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/recoder_cancel_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/voice_recorder_cancel"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/recoder_short_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/voice_recorder_short"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:id="@+id/voice_recorder_message"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/voice_swipe_to_cancel"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recorder_layout2"
        android:background="@drawable/shape_voice_recorder_background"
        android:visibility="gone"
        android:layout_width="226dp"
        android:layout_height="80dp"
        android:layout_marginBottom="116dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="46dp">
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/recoder_icon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/voice_recorder"/>
                <ImageView
                    android:id="@+id/volume_icon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/volume_one"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/volume_fake_img"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/audio_volume_anim"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/recoder_cancel_icon2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/audio_revert"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/recoder_short_icon2"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/audio_too_short"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="#666666"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="33dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:id="@+id/voice_recorder_message2"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_swipe_to_cancel"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
