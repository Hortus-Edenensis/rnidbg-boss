<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="200dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#ff9b9b9b"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_recommend_hint"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#ff9b9b9b"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:background="@drawable/selector_settings_item_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_recommend_hint_to_nearby"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ff009687"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/click_button_text_view"
                android:background="@drawable/selector_settings_item_background"
                android:paddingLeft="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_recommend_hint_to_nearby_button"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/content_layout"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <ListView
            android:gravity="top"
            android:id="@+id/contact_request_list"
            android:background="@color/white"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:stackFromBottom="false"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000"
            android:divider="@color/white"
            android:dividerHeight="0px"/>
    </RelativeLayout>
</RelativeLayout>
