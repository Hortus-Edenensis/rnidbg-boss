<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/Ab"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintHorizontal_weight="5">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/container2"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/headLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.zenmen.palmchat.widget.SocialPortraitView
                android:layout_gravity="center"
                android:id="@+id/portrait"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <FrameLayout
                android:id="@+id/del_member_btn"
                android:background="@drawable/red_circle"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="0dp">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/rect_white"
                    android:layout_width="13dp"
                    android:layout_height="3dp"/>
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/Gd"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/member_nick_name"
            android:paddingTop="@dimen/feed_dp_2"
            android:paddingBottom="@dimen/feed_dp_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/feed_dp_15"
            android:layout_marginRight="@dimen/feed_dp_15"
            android:text="测试"
            android:maxEms="4"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headLayout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
