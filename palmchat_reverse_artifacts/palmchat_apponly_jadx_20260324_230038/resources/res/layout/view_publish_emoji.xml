<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#fefefe"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_header"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <View
            android:background="@color/Fb"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/face"
                android:padding="5dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/icon_input_face"
                android:scaleType="fitCenter"/>
        </LinearLayout>
        <View
            android:background="@color/Fb"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/add_area"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_soft_input_height">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/faceLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zenmen.palmchat.ui.widget.expression.ExpressionViewPager
                android:id="@+id/faceViewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_above="@+id/facePagerIndicator"/>
            <LinearLayout
                android:gravity="top|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/facePagerIndicator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/expression_pager_indicator"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/faceSetting"
                android:background="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="@dimen/expression_setting_height">
                <View
                    android:background="@color/Fb"
                    android:layout_width="match_parent"
                    android:layout_height="0.3dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:background="#c0c0c0"
                        android:visibility="gone"
                        android:layout_width="0.3dp"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:id="@+id/input_expression_emoji"
                        android:background="@drawable/bg_selector_expression_item"
                        android:layout_width="59.7dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/icon_input_expression_emoji"
                        android:scaleType="centerInside"/>
                    <View
                        android:background="#c0c0c0"
                        android:layout_width="0.3dp"
                        android:layout_height="match_parent"/>
                    <View
                        android:background="#c0c0c0"
                        android:visibility="gone"
                        android:layout_width="0.3dp"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
