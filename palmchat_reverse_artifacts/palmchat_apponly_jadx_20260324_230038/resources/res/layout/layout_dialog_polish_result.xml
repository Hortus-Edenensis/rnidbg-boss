<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_polish_dialog_bg"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/ic_polish_rule_bg"
            android:layout_width="320dp"
            android:layout_height="76dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:gravity="center"
                android:id="@+id/titleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="擦亮主页成功"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#999"
                android:gravity="center"
                android:id="@+id/content"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="曝光次数+5，明天继续擦亮，曝光+10，记得回来哦~"/>
            <ImageView
                android:layout_width="176dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="30dp"
                android:src="@drawable/ic_polish_succes_dialog"/>
            <View
                android:background="#e5e5e5"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="17dp"
                    android:textColor="#ccc"
                    android:gravity="center"
                    android:id="@+id/cancel"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="我知道了"
                    android:layout_weight="1"/>
                <View
                    android:background="#e5e5e5"
                    android:layout_width="1px"
                    android:layout_height="52dp"/>
                <TextView
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:textColor="#14cd64"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/confirm"
                    android:padding="14dp"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="继续加曝光"
                    android:singleLine="true"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
