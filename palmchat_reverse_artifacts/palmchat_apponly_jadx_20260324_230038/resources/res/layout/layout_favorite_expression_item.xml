    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:background="@drawable/selector_bg_face_item"
        android:padding="3dp"
        android:layout_width="@dimen/favorite_expression_item_size"
        android:layout_height="@dimen/favorite_expression_item_size"
        android:scaleType="fitCenter"/>
</LinearLayout>
