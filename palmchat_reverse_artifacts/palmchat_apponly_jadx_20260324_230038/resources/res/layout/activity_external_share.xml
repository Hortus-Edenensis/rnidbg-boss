<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lyt_share_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="#ff333333"
            android:id="@+id/container_text"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="30dp"
            android:maxLines="6"/>
        <RelativeLayout
            android:id="@+id/container_link"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="30dp">
            <ImageView
                android:id="@+id/img_link_icon"
                android:layout_width="92dp"
                android:layout_height="92dp"/>
            <TextView
                android:textSize="18dp"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:id="@+id/tv_link_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:lines="2"
                android:layout_toRightOf="@+id/img_link_icon"
                android:layout_alignTop="@+id/img_link_icon"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#ff999999"
                android:id="@+id/tv_link_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:maxLines="3"
                android:layout_toRightOf="@+id/img_link_icon"
                android:layout_alignBottom="@+id/img_link_icon"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/container_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="27dp">
            <com.zenmen.palmchat.route.share.NineGridView
                android:id="@+id/view_nine_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/item_send_friends"
            android:background="@drawable/selector_settings_item_background"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="51dp">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="23dp"
                android:layout_marginLeft="18dp"
                android:src="@drawable/ic_share_friends"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:text="发送给朋友"/>
        </RelativeLayout>
        <View
            android:id="@+id/view_divider"
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="17dp"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/item_send_moments"
            android:background="@drawable/selector_settings_item_background"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="51dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginLeft="18dp"
                android:src="@drawable/ic_share_moments"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:text="分享到好友圈"/>
        </RelativeLayout>
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
