<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/text_color_ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/lin_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <ImageView
            android:layout_width="180dp"
            android:layout_height="143dp"
            android:layout_marginTop="56dp"
            android:src="@drawable/image_group_empty"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Gd"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tip_text"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/group_list_tip"
            android:singleLine="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lyt_group_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar">
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_color_gray"
            android:gravity="center"
            android:id="@+id/group_text"
            android:background="@color/color_FFFFFF"
            android:paddingLeft="12dp"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:text="@string/group_chat_title"/>
        <com.zenmen.palmchat.widget.DividerView
            android:id="@+id/divider"
            android:background="@color/Fb"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <ListView
        android:gravity="top"
        android:id="@+id/group_list"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="#00000000"
        android:stackFromBottom="false"
        android:scrollingCache="false"
        android:cacheColorHint="#00000000"
        android:divider="@null"
        android:layout_below="@+id/lyt_group_text"/>
    <View
        android:background="@color/Fb"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_below="@+id/group_list"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/text_color_999"
        android:gravity="center_horizontal"
        android:id="@+id/group_count"
        android:background="@color/color_FFFFFF"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/group_list"
        android:layout_centerHorizontal="true"/>
    <ListView
        android:id="@+id/search_result_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"/>
</RelativeLayout>
