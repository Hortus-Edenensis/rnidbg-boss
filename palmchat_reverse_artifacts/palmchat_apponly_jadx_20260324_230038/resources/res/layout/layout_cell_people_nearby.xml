<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/lbs_cell_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/ic_dynamic_cell_peoplenearby"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/lbs_cell_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/settings_item_fujinderen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/lbs_cell_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/text_normal_content"/>
    <TextView
        android:id="@+id/lbs_badge"
        android:visibility="visible"
        android:layout_marginLeft="10dp"
        android:text="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/lbs_cell_title"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/discover_tab_red_dot_big"/>
    <View
        android:id="@+id/lbs_reddot"
        android:background="@drawable/red_circle_lbs_notify"
        android:visibility="visible"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/lbs_cell_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/lbs_new"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:src="@drawable/ic_new"
        android:scaleType="fitStart"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/lbs_cell_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/lbs_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/lbs_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lbs_label_layout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="40dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:id="@+id/lbs_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:lines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/lbs_label_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/lbs_label_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/icon_nearby_entrance_label"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/red_circle_lbs_notify"
                android:layout_width="9dp"
                android:layout_height="9dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.discovercell.widget.CellBannerView
                android:id="@+id/new_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"/>
            <FrameLayout
                android:id="@+id/new_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.zenmen.palmchat.discovercell.widget.CellFoldView
                    android:id="@+id/new_icon_fold"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"/>
                <com.zenmen.palmchat.discovercell.widget.CellBubbleView
                    android:id="@+id/new_icon_bubble"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/lbs_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@drawable/list_ic_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
