<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/prompt_dialog"
        android:background="@drawable/video_top_wifikey_diversion_bg"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/color_222222"
                android:ellipsize="end"
                android:id="@+id/prompt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="@string/video_top_wifikey_guide_dialog_title"
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/text_size_right"
                android:textColor="@color/color_666666"
                android:ellipsize="end"
                android:id="@+id/prompt_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginRight="12dp"
                android:text="@string/video_top_wifikey_guide_dialog_subtitle"
                android:maxLines="1"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_size_middle"
            android:textColor="@color/color_FFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/video_top_wifikey_diversion_topbar_btn_bg"
            android:layout_width="88dp"
            android:layout_height="30dp"
            android:text="@string/video_top_wifikey_guide_dialog_btn"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
