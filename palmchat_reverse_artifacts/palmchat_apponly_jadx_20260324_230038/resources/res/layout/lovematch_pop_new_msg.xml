<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/lovematch_pop_new_msg_0"
    android:background="@mipmap/lovematch_pop_new_msg_bg"
    android:paddingLeft="32dp"
    android:paddingTop="18dp"
    android:paddingRight="20dp"
    android:paddingBottom="36dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#ff808d"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/close"
            android:padding="2dp"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginLeft="20dp"
            android:src="@mipmap/lovematch_pop_generic_close"
            android:scaleType="fitCenter"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp">
        <FrameLayout
            android:background="@drawable/lovematch_pop_generic_circle_border"
            android:padding="2dp"
            android:layout_width="64dp"
            android:layout_height="64dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:esv_shape="circle"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/sex"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <TextView
                android:textSize="16dp"
                android:textColor="#f63f6e"
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#666666"
                        android:id="@+id/msg"
                        android:background="@drawable/lovematch_pop_new_msg_msg"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="13dp"
                        android:paddingBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </LinearLayout>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:id="@+id/reply"
                    android:background="@drawable/lovematch_pop_new_msg_reply"
                    android:paddingLeft="16dp"
                    android:paddingTop="6dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
