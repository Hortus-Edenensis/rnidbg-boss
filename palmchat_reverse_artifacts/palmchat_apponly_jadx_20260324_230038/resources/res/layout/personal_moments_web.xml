<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/personal_moments_header_year"/>
    <View
        android:id="@+id/higher_margin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="23dp"/>
    <View
        android:id="@+id/short_margin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/personal_moments_date_header"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/album_click_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_weight="1">
            <RelativeLayout
                android:background="@drawable/shape_shape_moment_personal_feed_bg"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/B4"
                    android:textColor="#454545"
                    android:ellipsize="end"
                    android:id="@+id/album_web_content"
                    android:paddingTop="1dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_below="@+id/album_web_content">
                    <ImageView
                        android:id="@+id/album_web"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_default_link"
                        android:scaleType="centerCrop"/>
                    <TextView
                        android:textSize="@dimen/B4"
                        android:textColor="#454545"
                        android:ellipsize="end"
                        android:id="@+id/album_web_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_toLeftOf="@+id/send_fail_ic"
                        android:layout_toRightOf="@+id/album_web"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/send_fail_ic"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="5dp"
                        android:src="@drawable/status_fail_hint"
                        android:scaleType="centerCrop"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
