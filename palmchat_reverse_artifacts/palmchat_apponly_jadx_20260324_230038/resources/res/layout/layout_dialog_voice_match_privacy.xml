<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="390dp">
        <ImageView
            android:id="@+id/top_banner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/ic_vm_privacy_dialog_top_bg"
            android:scaleType="fitXY"/>
        <View
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/top_banner"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="语音速配/视频匹配用户协议"
                android:textAlignment="center"/>
            <FrameLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="48dp"
                android:layout_marginBottom="15dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/btnLayout1"
                    android:background="@drawable/voice_match_privacy_cancel_btn_bg"
                    android:padding="4dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="20dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:gravity="center"
                        android:id="@+id/text1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="拒绝"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/btnLayout2"
                    android:background="@drawable/voice_match_invite_btn_bg"
                    android:padding="4dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:gravity="center"
                        android:id="@+id/text2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="同意"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
