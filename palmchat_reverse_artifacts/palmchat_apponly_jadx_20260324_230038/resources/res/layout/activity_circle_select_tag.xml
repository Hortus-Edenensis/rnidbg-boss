<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <TextView
                android:textSize="15dp"
                android:textColor="#ff4a90e2"
                android:id="@+id/circle_select_tag_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:text="添加"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="15dp"
                android:textColorHint="@color/text_color_999"
                android:id="@+id/circle_select_tag_edit"
                android:background="@color/white"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:hint="输入自定义标签名称"
                android:cursorVisible="true"
                android:singleLine="true"
                android:maxLength="50"
                android:layout_toLeftOf="@+id/circle_select_tag_add"
                android:inputType="text"
                android:textCursorDrawable="@null"
                style="@style/settings_main_text_black"/>
        </RelativeLayout>
        <LinearLayout
            android:background="@color/text_color_999"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="10.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_color_999"
            android:gravity="center_vertical"
            android:id="@+id/circle_tv_label_tag_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="群标签"/>
        <ListView
            android:id="@+id/circle_select_tag_list"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
</LinearLayout>
