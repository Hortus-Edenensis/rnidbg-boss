<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/float_audio"
        android:background="@drawable/voip_minisize_window_bg"
        android:paddingTop="18dp"
        android:layout_width="65dp"
        android:layout_height="85dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/voip_minisize_window_icon"/>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/Ga"
            android:id="@+id/audio_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="00:00"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/float_video"
        android:padding="9dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/float_remote"
            android:layout_width="66dp"
            android:layout_height="127dp"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="12dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/voip_mizsmall_icons"/>
        <com.zenmen.media.rtc.CameraView
            android:layout_gravity="right"
            android:id="@+id/float_local"
            android:layout_width="24dp"
            android:layout_height="32dp"
            android:layout_marginRight="2dp"/>
    </FrameLayout>
</LinearLayout>
