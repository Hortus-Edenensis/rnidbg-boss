<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:visibility="gone"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/gift_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/iv_card_bg"
                    android:layout_width="261dp"
                    android:layout_height="135dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="261dp"
                    android:layout_height="135dp">
                    <TextView
                        android:textSize="@dimen/B3"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="10dp"
                        android:singleLine="true"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="234dp"
                            android:layout_height="70dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="11dp"
                            android:src="@drawable/ic_buy_vip_gift_desc_bg_b"
                            android:layout_centerHorizontal="true"/>
                        <ImageView
                            android:id="@+id/iv_flower"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:layout_marginLeft="3.5dp"
                            android:layout_marginTop="10dp"
                            android:src="@drawable/ic_chat_flowers_buy_vip_gift_tips"
                            android:scaleType="centerCrop"/>
                        <TextView
                            android:textSize="@dimen/B4"
                            android:textColor="#202020"
                            android:ellipsize="end"
                            android:id="@+id/tv_desc"
                            android:layout_width="98dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="72dp"
                            android:layout_marginTop="27dp"
                            android:maxLines="2"/>
                        <RelativeLayout
                            android:layout_width="62dp"
                            android:layout_height="29dp"
                            android:layout_marginLeft="180dp"
                            android:layout_marginTop="32dp">
                            <ImageView
                                android:id="@+id/iv_btn_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/white"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:id="@+id/iv_btn_text"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:maxLines="1"/>
                        </RelativeLayout>
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
