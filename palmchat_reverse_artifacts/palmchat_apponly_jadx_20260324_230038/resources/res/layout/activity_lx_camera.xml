<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_camera"
    android:background="#000"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:windowDrawsSystemBarBackgrounds="false">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/adcontainer"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"/>
    <ImageView
        android:id="@+id/camera_imageview"
        android:background="@android:color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/videoViewLayout"
        android:background="@android:color/black"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/camera_control_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/close"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="55dp"
                android:layout_marginBottom="55dp"
                android:src="@drawable/ic_camera_arrow"
                android:layout_alignParentBottom="true"/>
            <com.zenmen.media.MButton
                android:id="@+id/camera_record_button"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="20dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14dp"
                android:id="@+id/desTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="162dp"
                android:text="@string/camera_record"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/swap"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="55dp"
                android:layout_marginBottom="55dp"
                android:src="@drawable/ic_camera_swap"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/result_btn_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_alignParentBottom="true">
            <Button
                android:id="@+id/edit"
                android:visibility="invisible"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="编辑"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/revert"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_camera_revert"
                android:text="返回"
                android:layout_toLeftOf="@+id/edit"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/ok"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_camera_ok"
                android:text="确定"
                android:layout_toRightOf="@+id/edit"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
