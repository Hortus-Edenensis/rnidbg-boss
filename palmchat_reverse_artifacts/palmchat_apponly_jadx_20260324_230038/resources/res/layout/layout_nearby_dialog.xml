<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="19dp"
        android:textColor="@color/text_color_black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nearby_dialog_location_title"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="@color/text_color_black"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/nearby_dialog_location_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/selector_area"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">
        <ImageView
            android:id="@+id/selector"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:src="@drawable/selector_icon_check"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/text_color_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_dialog_show_again"/>
    </LinearLayout>
</LinearLayout>
