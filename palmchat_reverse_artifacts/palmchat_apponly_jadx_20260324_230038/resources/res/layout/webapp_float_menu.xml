<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_webapp_btn_more"
        android:paddingLeft="12.5dp"
        android:paddingTop="4dp"
        android:paddingRight="12.5dp"
        android:paddingBottom="4dp"
        android:layout_width="45dp"
        android:layout_height="28dp"
        android:src="@drawable/webapp_btn_more_black_selector"
        android:onClick="onClick"/>
    <View
        android:id="@+id/v_webapp_float_menu_divider"
        android:background="#33000000"
        android:layout_width="0.5dp"
        android:layout_height="16.9dp"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/iv_webapp_btn_close"
        android:paddingLeft="12.5dp"
        android:paddingTop="4dp"
        android:paddingRight="12.5dp"
        android:paddingBottom="4dp"
        android:layout_width="45dp"
        android:layout_height="28dp"
        android:src="@drawable/webapp_btn_close_black_selector"
        android:layout_alignParentRight="true"
        android:onClick="onClick"/>
</RelativeLayout>
