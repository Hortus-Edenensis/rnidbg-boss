<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_chatting_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <SurfaceView
            android:layout_gravity="center"
            android:id="@+id/group_chatting_video_view"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"/>
        <com.zenmen.media.common.WaitingTextView
            android:gravity="center"
            android:id="@+id/group_chatting_waiting_video"
            android:background="#1affffff"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="视频正在接入"/>
        <ImageView
            android:id="@+id/group_chatting_head_image"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/manychats_icon_default_portrait"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/group_chatting_bottom_linearlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/group_chatting_mute"
                android:layout_width="57px"
                android:layout_height="57px"
                android:layout_marginLeft="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/manychats_voice_mute"/>
            <TextView
                android:textSize="@dimen/text_size_tiny"
                android:textColor="#fff"
                android:ellipsize="end"
                android:id="@+id/group_chatting_username"
                android:background="#9a000000"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginBottom="3dp"
                android:text="Long text to demonstrate problem with TextView in GridLayout taking up too much space despit"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/group_chatting_voice_detect"
            android:background="@drawable/manychats_shape_video_call_group_chatting_item_control"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/group_chatting_talking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"
                android:layout_marginBottom="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/group_chatting_hide"
            android:background="#99323232"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/group_chatting_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
