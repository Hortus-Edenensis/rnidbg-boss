<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#88000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_captcha_dialog_mid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginRight="28dp">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp"
            android:text="请完成安全验证"/>
        <RelativeLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="200dp">
            <WebView
                android:id="@+id/dialogWebView"
                android:visibility="invisible"
                android:layout_width="300dp"
                android:layout_height="200dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/progress_img"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/custom_progress_icon"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/retryView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_captcha_error"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#666"
                    android:id="@+id/retryTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/captcha_error_text"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"/>
    </LinearLayout>
</LinearLayout>
