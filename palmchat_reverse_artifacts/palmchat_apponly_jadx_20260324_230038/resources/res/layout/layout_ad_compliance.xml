<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/shape_ad_compliance_dialog_bg"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="310dp">
    <ImageView
        android:id="@+id/ad_logo"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="25dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#333333"
        android:id="@+id/ad_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:id="@+id/ad_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:singleLine="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:id="@+id/ad_developer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_permissions_privacy_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff2a72cc"
            android:id="@+id/ad_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_permission_list"/>
        <View
            android:background="#999999"
            android:layout_width="0.5dp"
            android:layout_height="15dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff2a72cc"
            android:id="@+id/ad_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_privacy"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ad_download"
        android:background="@drawable/shape_ad_compliance_download_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="32dp"
        android:text="立即下载"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:id="@+id/ad_refuse_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="放弃下载"
        android:singleLine="true"/>
</LinearLayout>
