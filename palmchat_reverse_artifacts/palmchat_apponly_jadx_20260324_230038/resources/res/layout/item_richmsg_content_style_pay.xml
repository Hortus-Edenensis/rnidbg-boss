<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_richmsg_subitem_background"
    android:paddingLeft="15dp"
    android:paddingTop="10dp"
    android:paddingRight="15dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/header_icon"
            android:visibility="visible"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_default_link"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_middle"
            android:textColor="@color/text_color_black"
            android:ellipsize="end"
            android:id="@+id/header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="红包退还通知"
            android:maxLines="1"
            android:layout_toRightOf="@+id/header_icon"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="#888888"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="退款金额"
        android:maxLines="1"/>
    <TextView
        android:textSize="40dp"
        android:textColor="#000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        android:text="0.14元"
        android:maxLines="1"/>
    <View
        android:id="@+id/sepView"
        android:background="@drawable/shape_pay_dot"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layerType="software"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/labelLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"/>
</LinearLayout>
