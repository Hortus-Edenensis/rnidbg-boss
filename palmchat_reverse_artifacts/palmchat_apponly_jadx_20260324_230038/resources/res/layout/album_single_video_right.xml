<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_moments_single_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="62dp"
        android:layout_marginTop="-30dp"
        android:layout_marginRight="@dimen/moment_item_padding">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#808080"
                android:id="@+id/create_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#4b73bf"
                android:id="@+id/video_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="hahahah"/>
        </LinearLayout>
        <com.zenmen.palmchat.ui.widget.common.ClickShowMoreLayout
            android:id="@+id/item_text_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:show_line="5"
            app:text_color="@color/normal_font_color"/>
        <RelativeLayout
            android:id="@+id/item_video_field"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="4dp">
            <ImageView
                android:id="@+id/video_cover"
                android:background="#eeeeee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <com.zenmen.palmchat.widget.RoundCornerCoverView
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/video_play_btn"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/video_play"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
    <include layout="@layout/include_album_single_bottom_right"/>
</LinearLayout>
