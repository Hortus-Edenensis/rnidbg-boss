<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/moment_message_tips"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/message_tips_bg"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="center_vertical"
            android:id="@+id/message_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/status_fail_hint"
            android:scaleType="centerCrop"
            app:esv_shape="circle"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#222222"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/unsend_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="图片发送失败"
            android:singleLine="true"
            android:drawableRight="@drawable/moments_msg_arrow"
            android:drawablePadding="2dp"/>
    </LinearLayout>
</FrameLayout>
