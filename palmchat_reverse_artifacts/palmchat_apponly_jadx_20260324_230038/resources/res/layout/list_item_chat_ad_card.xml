<?xml version="1.0" encoding="utf-8"?>
<com.zenmen.palmchat.ad.VisibleDetectView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visible_detect"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/chat_unread_sep"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="@dimen/text_size_tiny"
                android:textColor="#999"
                android:gravity="center"
                android:id="@+id/chat_unread_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="@string/chat_unread_separator"
                android:layout_centerInParent="true"/>
            <View
                android:background="#cfcfcf"
                android:layout_width="66dp"
                android:layout_height="1dp"
                android:layout_marginRight="9dp"
                android:layout_toLeftOf="@+id/chat_unread_text"
                android:layout_centerVertical="true"/>
            <View
                android:background="#cfcfcf"
                android:layout_width="66dp"
                android:layout_height="1dp"
                android:layout_marginLeft="9dp"
                android:layout_toRightOf="@+id/chat_unread_text"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="time"
            style="@style/text_chat_time"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/ad_dimen_16">
                <com.wifi.ad.core.feedbanner.NestOppoNativeAdContainer
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.wifi.ad.core.feedbanner.ClearLogoNativeAdContainer
                        android:id="@+id/native_ad_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ad_dimen_12">
                        <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAdContainer
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/ad_top_area"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <com.zenmen.palmchat.widget.LXPortraitView
                                        android:id="@+id/portrait"
                                        android:layout_width="@dimen/chat_item_portrait_view_size"
                                        android:layout_height="@dimen/chat_item_portrait_view_size"
                                        android:src="@drawable/default_portrait"
                                        android:scaleType="centerCrop"/>
                                    <LinearLayout
                                        android:orientation="vertical"
                                        android:id="@+id/row_rec_location"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_toRightOf="@+id/portrait"
                                        android:layout_marginStart="@dimen/ad_dimen_10">
                                        <TextView
                                            android:textSize="@dimen/text_size_tiny"
                                            android:textColor="@color/text_color_gray"
                                            android:ellipsize="end"
                                            android:id="@+id/name"
                                            android:visibility="gone"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                                            android:maxWidth="@dimen/list_item_text_width"
                                            android:text="nameaaaaaaaaaaaaaaaaaaaddddddddddddddddaaaaaaaa"
                                            android:singleLine="true"/>
                                        <TextView
                                            android:textSize="17dp"
                                            android:textColor="#222222"
                                            android:id="@+id/ad_app_name"
                                            android:clickable="true"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"/>
                                        <TextView
                                            android:textSize="12dp"
                                            android:textColor="#666666"
                                            android:id="@+id/ad_info"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="3dp"
                                            android:singleLine="true"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/ad_drop"
                                        android:background="@drawable/square_generic_list_item_ad_drop_bg"
                                        android:paddingLeft="6dp"
                                        android:paddingTop="2dp"
                                        android:paddingRight="6dp"
                                        android:paddingBottom="2dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="12dp">
                                        <TextView
                                            android:textSize="11dp"
                                            android:textColor="#bbbbbb"
                                            android:id="@+id/ad_sign"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"/>
                                        <ImageView
                                            android:layout_width="8dp"
                                            android:layout_height="8dp"
                                            android:layout_marginLeft="3dp"
                                            android:src="@drawable/native_ad_close"
                                            android:scaleType="fitCenter"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginStart="48dp">
                                    <FrameLayout
                                        android:id="@+id/ad_icon_container"
                                        android:layout_width="208dp"
                                        android:layout_height="117dp">
                                        <FrameLayout
                                            android:id="@+id/ad_video_wrapper"
                                            android:visibility="gone"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent">
                                            <FrameLayout
                                                android:id="@+id/ad_video"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"/>
                                            <com.zenmen.palmchat.chat.ad.AdRoundCornerCoverView
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"/>
                                        </FrameLayout>
                                        <com.zenmen.palmchat.widget.EffectiveShapeView
                                            android:id="@+id/ad_img"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:scaleType="fitXY"
                                            app:esv_shape="round_rectangle"
                                            app:radius_x_dp="8dp"
                                            app:radius_y_dp="8dp"/>
                                        <LinearLayout
                                            android:gravity="center_vertical"
                                            android:layout_gravity="bottom"
                                            android:orientation="horizontal"
                                            android:background="@drawable/square_generic_list_item_ad_main_bg"
                                            android:paddingLeft="8dp"
                                            android:paddingTop="9dp"
                                            android:paddingRight="8dp"
                                            android:paddingBottom="8dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:id="@+id/ad_logo"
                                                android:layout_width="10dp"
                                                android:layout_height="10dp"
                                                android:scaleType="fitCenter"/>
                                            <Space
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"/>
                                            <FrameLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content">
                                                <FrameLayout
                                                    android:layout_width="50dp"
                                                    android:layout_height="20dp">
                                                    <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                                                        android:layout_gravity="center_horizontal"
                                                        android:id="@+id/app_download_btn"
                                                        android:tag="huawei_download_btn"
                                                        android:paddingLeft="9dp"
                                                        android:paddingTop="4dp"
                                                        android:paddingRight="9dp"
                                                        android:paddingBottom="4dp"
                                                        android:visibility="gone"
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        app:hiad_fixedWidth="true"
                                                        app:hiad_maxWidth="45dp"
                                                        app:hiad_minWidth="45dp"
                                                        app:hiad_textColor="#ffffff"
                                                        app:hiad_textSize="10dp"/>
                                                </FrameLayout>
                                                <TextView
                                                    android:textSize="9dp"
                                                    android:textColor="#ffffff"
                                                    android:gravity="center"
                                                    android:id="@+id/ad_action"
                                                    android:paddingLeft="7dp"
                                                    android:paddingTop="2dp"
                                                    android:paddingRight="7dp"
                                                    android:paddingBottom="2dp"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"/>
                                            </FrameLayout>
                                        </LinearLayout>
                                        <com.zenmen.palmchat.ad.ShakeView
                                            android:id="@+id/shake"
                                            android:visibility="gone"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"/>
                                    </FrameLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="48dp"
                                    android:layout_marginTop="13dp">
                                    <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayoutLine
                                        android:id="@+id/ad_com_info_layout"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </com.wifi.ad.core.feedbanner.NestHuaWeiNativeAdContainer>
                    </com.wifi.ad.core.feedbanner.ClearLogoNativeAdContainer>
                </com.wifi.ad.core.feedbanner.NestOppoNativeAdContainer>
                <View
                    android:id="@+id/audio_read"
                    android:background="@drawable/red_circle"
                    android:visibility="gone"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginLeft="7dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/multi_choice"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="-10dp"
                    android:src="@drawable/icon_green_unchecked"
                    android:scaleType="center"
                    android:layout_alignParentRight="true"/>
                <FrameLayout
                    android:id="@+id/template_ad_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ad_dimen_16"/>
            </RelativeLayout>
            <View
                android:id="@+id/message_area"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</com.zenmen.palmchat.ad.VisibleDetectView>
