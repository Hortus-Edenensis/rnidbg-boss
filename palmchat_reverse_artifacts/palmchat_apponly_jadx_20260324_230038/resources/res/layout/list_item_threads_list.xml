<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/selector_thread_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="@dimen/dimen_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zenmen.palmchat.widget.LXPortraitView
            android:id="@+id/icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:text_size="10dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/lyt_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:layout_toLeftOf="@+id/date"
                        app:alignItems="center"
                        app:flexDirection="row"
                        app:flexWrap="nowrap"
                        app:justifyContent="flex_start">
                        <TextView
                            android:textSize="@dimen/B2"
                            android:textColor="@color/Gb"
                            android:ellipsize="end"
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="标题"
                            android:lines="1"
                            app:layout_flexShrink="1"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/extraLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_flexShrink="0">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/iv_vip"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginLeft="6dp"
                                android:src="@drawable/vip_icon_normal_small"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/iv_temp_chat"
                                android:layout_width="32dp"
                                android:layout_height="14dp"
                                android:layout_marginLeft="@dimen/dimen_6"
                                android:src="@drawable/icon_temp_chat"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="@dimen/dimen_6"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/iv_ai_chat"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:layout_marginLeft="@dimen/dimen_6"
                                android:src="@drawable/ai_chat_msg_aitag"
                                android:scaleType="fitXY"
                                android:layout_marginStart="@dimen/dimen_6"/>
                            <TextView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_official"
                                android:layout_marginLeft="6dp"
                                style="@style/official_text_tag"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/iv_super_greetings"
                                android:layout_width="60dp"
                                android:layout_height="16dp"
                                android:layout_marginLeft="@dimen/dimen_6"
                                android:src="@drawable/icon_super_greetings_tag"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="@dimen/dimen_6"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/iv_conversation_specialattention"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginLeft="@dimen/dimen_6"
                                android:src="@drawable/icon_conversation_specialattention"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="@dimen/dimen_6"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/disturbIv"
                                android:layout_width="@dimen/dimen_14"
                                android:layout_height="@dimen/dimen_14"
                                android:layout_marginLeft="@dimen/dimen_6"
                                android:src="@drawable/icon_thread_item_nodisturb"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="@dimen/dimen_6"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#ff3abc"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_intimacy_score"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="6dp"
                                android:text="100°"
                                android:drawableLeft="@drawable/ic_intimacy_thread_flag"
                                android:drawablePadding="2dp"/>
                        </LinearLayout>
                    </com.google.android.flexbox.FlexboxLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/message_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="40dp"
                        android:layout_below="@+id/lyt_title">
                        <com.zenmen.palmchat.widget.RhythmView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/rhy_view"
                            android:visibility="gone"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginRight="2dp"/>
                        <TextView
                            android:textSize="@dimen/B4"
                            android:textColor="@color/Gd"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/additionMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dimen_5"
                            android:text="@string/thread_draft"
                            android:maxEms="12"
                            android:singleLine="true"
                            android:layout_marginEnd="@dimen/dimen_5"/>
                        <FrameLayout
                            android:id="@+id/loop_message_layout"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="消息"
                            style="@style/thread_item_sub_title"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时间"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        style="@style/text_small_content"/>
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/message_area"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textColor="@color/Ab"
                            android:gravity="center"
                            android:id="@+id/notification_red_dot"
                            android:background="@drawable/red_circle"
                            android:paddingBottom="0.5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dimen_18"
                            android:minWidth="@dimen/dimen_18"
                            android:text="1"
                            style="@style/main_tab_unread_text"/>
                        <View
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/notification_red_dot_nodisturb"
                            android:background="@drawable/red_circle"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                    </FrameLayout>
                </RelativeLayout>
            </RelativeLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
