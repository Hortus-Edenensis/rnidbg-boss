<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/red_text_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/square_tab_select_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:id="@+id/rl_tool_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <LinearLayout
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:layout_toLeftOf="@+id/square_go_publish">
            <ImageView
                android:id="@+id/square_msg_box"
                android:padding="2dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/icon_square_msg_box"
                android:layout_toLeftOf="@+id/square_go_publish"/>
            <TextView
                android:textSize="9dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_praise_count_red_dot"
                android:background="@drawable/shape_red_dot_praise"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="-13dp"
                android:minWidth="14dp"
                android:layout_toRightOf="@+id/square_msg_box"
                android:layout_above="@+id/square_msg_box"/>
            <View
                android:id="@+id/square_msg_dot"
                android:background="@drawable/shape_red_dot_message"
                android:visibility="invisible"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginLeft="-13dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/square_go_publish"
            android:background="@drawable/bg_square_btn_publish"
            android:layout_width="69dp"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/btn_nearby_filter"
        android:paddingLeft="20dp"
        android:visibility="invisible"
        android:layout_width="50dp"
        android:layout_height="30dp"
        android:src="@drawable/icon_nearby_filter_normal"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
