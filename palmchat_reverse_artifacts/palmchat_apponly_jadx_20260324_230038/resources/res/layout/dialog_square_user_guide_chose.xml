<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/dialog_square_user_guide_chose_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/square_user_guid_dialog_bg"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:layout_marginTop="57dp"
                        android:layout_marginRight="30dp">
                        <TextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:id="@+id/change_next"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#666666"
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="换一批"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginLeft="6dp"
                                android:src="@drawable/square_user_guid_dialog_refresh"/>
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginRight="20dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="top|right"
                    android:id="@+id/close"
                    android:padding="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true">
                    <View
                        android:background="@drawable/square_user_guid_dialog_close"
                        android:layout_width="12dp"
                        android:layout_height="12dp"/>
                </LinearLayout>
            </RelativeLayout>
            <EditText
                android:textSize="14dp"
                android:textColor="#222222"
                android:textColorHint="#c9c9c9"
                android:gravity="top|left"
                android:id="@+id/content"
                android:background="@drawable/dialog_square_user_guide_chose_text_bg"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="30dp"
                android:maxLines="2"
                android:overScrollMode="always"/>
            <LinearLayout
                android:id="@+id/location_rl"
                android:background="@drawable/dialog_square_user_guide_chose_text_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="30dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/square_user_guid_dialog_location"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="12dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/publish_btn"
                android:background="@drawable/dialog_square_user_guide_chose_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="46dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="46dp"
                android:layout_marginBottom="21dp"
                android:text="发布"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
