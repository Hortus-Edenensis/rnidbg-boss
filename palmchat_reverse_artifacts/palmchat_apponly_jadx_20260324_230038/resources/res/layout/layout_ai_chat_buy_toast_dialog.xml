<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/ai_chat_buy_toast_bottom_bg"
            android:layout_width="match_parent"
            android:layout_height="280dp"/>
        <View
            android:background="@drawable/ai_chat_act_toast_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="180dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/other_avatar_img"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/default_portrait"
                    android:scaleType="fitXY"
                    app:esv_shape="circle"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="25dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="20dp"
                    android:src="@drawable/ai_chat_act_item_like_bg"
                    android:scaleType="fitXY"/>
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/mine_avatar_img"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginLeft="20dp"
                    android:src="@drawable/default_portrait"
                    android:scaleType="fitXY"
                    app:esv_shape="circle"/>
            </LinearLayout>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_name_title"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:text="“很高兴和你度过这段时光”"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_desc_title"
                android:layout_width="272dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="你对AI虚拟人的守护已结束，是否继续守护他？"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_button"
                android:background="@drawable/ai_chat_act_item_btn_bg"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:text="继续守护"/>
        </LinearLayout>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/close_img"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="56dp"
        android:src="@drawable/light_get_buy_dialog_close"
        android:scaleType="fitXY"/>
</LinearLayout>
