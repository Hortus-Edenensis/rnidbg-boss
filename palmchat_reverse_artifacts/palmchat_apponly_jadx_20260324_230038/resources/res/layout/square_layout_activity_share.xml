<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="88dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/square_shape_share_card_bg"
                    android:paddingLeft="16dp"
                    android:paddingTop="20dp"
                    android:paddingRight="13dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="16dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/recommend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/square_share_recommend"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="17dp"
                                android:textColor="#222222"
                                android:id="@+id/tv_recommend"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="本地新鲜事"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="#999999"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="附近的人可见"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/recommend_choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/square_share_unselected"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/moments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/square_share_moments"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="17dp"
                                android:textColor="#222222"
                                android:id="@+id/tv_moment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="连信朋友圈"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="#999999"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="仅连信好友可见"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/moments_choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/square_share_unselected"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/friends"
                    android:background="@drawable/square_shape_share_card_bg"
                    android:paddingLeft="16dp"
                    android:paddingTop="20dp"
                    android:paddingRight="13dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="16dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="15dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="连信好友"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#999999"
                            android:layout_gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="仅选中的好友可见"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/friends_recycler"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#666666"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/friends_more"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更多好友"
                        android:drawableRight="@drawable/square_share_more"
                        android:drawablePadding="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/contacts"
                    android:background="@drawable/square_shape_share_card_bg"
                    android:paddingLeft="16dp"
                    android:paddingTop="20dp"
                    android:paddingRight="13dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="16dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="15dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="通讯录好友"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#999999"
                            android:layout_gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="仅选中的好友可见"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/Aa"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/contacts_permission"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="请先授权通讯录访问权限 &gt;"
                        android:drawableLeft="@drawable/square_share_permission"
                        android:drawablePadding="4dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/contacts_recycler"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#666666"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/contacts_more"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更多好友"
                        android:drawableRight="@drawable/square_share_more"
                        android:drawablePadding="3dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/square_share_bottom_fade"
            android:layout_width="match_parent"
            android:layout_height="108dp"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/confirm"
            android:background="@drawable/square_btn_bg_24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            android:text="发布"/>
    </FrameLayout>
</LinearLayout>
