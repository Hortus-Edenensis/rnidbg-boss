<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="visible"
    android:layout_width="80dp"
    android:layout_height="80dp">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/cell_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/icon_tab_cell_default2"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"
        app:esv_shape="round_rectangle"
        app:radius_x_dp="12dp"
        app:radius_y_dp="12dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#222"
        android:ellipsize="end"
        android:id="@+id/cell_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="title"
        android:maxLength="6"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.zenmen.palmchat.widget.TabCellUnReadView
        android:id="@+id/cell_unread"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="-3dp"
        android:layout_toRightOf="@+id/cell_icon"
        android:layout_alignTop="@+id/cell_icon"/>
    <RelativeLayout
        android:id="@+id/cell_label_relativelayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:ellipsize="none"
            android:id="@+id/cell_label"
            android:background="@drawable/cell_view_tab_item_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="哈哈"
            android:singleLine="true"
            android:maxLength="6"
            android:textAlignment="center"/>
    </RelativeLayout>
</RelativeLayout>
