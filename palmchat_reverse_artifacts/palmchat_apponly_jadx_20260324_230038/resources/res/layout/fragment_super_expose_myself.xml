<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_super_expose_myself_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_layout"
        android:layout_below="@+id/top_view">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/top_image_layout"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/spuper_expose_home_contaner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp">
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/fragment_super_expose_intro_gradient_left"
                        android:layout_width="38dp"
                        android:layout_height="2dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#ff222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_marginRight="14dp"
                        android:text="产品介绍"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/fragment_super_expose_intro_gradient_right"
                        android:layout_width="38dp"
                        android:layout_height="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/intro_layout"
                    android:paddingTop="10dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:src="@drawable/spuper_expose_home_myself_content_bg"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <RelativeLayout
                android:id="@+id/order_history"
                android:background="@drawable/spuper_expose_home_item_bg"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="12dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#ff222222"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="订单记录"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="19dp"
                    android:layout_marginRight="14dp"
                    android:src="@drawable/spuper_expose_home_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/super_expose_intro_layout"
                android:background="@drawable/spuper_expose_home_item_bg"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="24dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#ff222222"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="超级曝光付费说明"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="19dp"
                    android:layout_marginRight="14dp"
                    android:src="@drawable/spuper_expose_home_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/bottom_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@+id/to_super"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ff222222"
                android:id="@+id/des_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ff222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10倍曝光，人气飙升"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/to_super"
            android:background="@drawable/radio20_color14cd64"
            android:layout_width="108dp"
            android:layout_height="39dp"
            android:layout_marginRight="24dp"
            android:text="一键开启曝光"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <com.zenmen.palmchat.widget.LightingAnimationView
            android:id="@+id/anim_view1"
            android:layout_width="108dp"
            android:layout_height="39dp"
            android:layout_marginRight="24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:la_w="25dp"/>
    </RelativeLayout>
</RelativeLayout>
