<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:padding="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/circle_promise_tuijian"
            style="@style/settings_main_text_black"/>
        <CheckBox
            android:id="@+id/ck_promise"
            android:padding="11dp"
            android:layout_marginRight="10dp"
            android:button="@drawable/selector_checkbox_background"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/settings_checkbox_size"/>
    </RelativeLayout>
</LinearLayout>
