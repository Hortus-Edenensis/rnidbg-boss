<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="top"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_contact_alert_dialog_style1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="12dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="38dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_contact_alert_logo"/>
                <TextView
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="@color/text_color_202020"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"/>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="10dp"
                    android:text="1"
                    style="@style/contact_alert_red_dot"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/btn_cancel"
                android:padding="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_contact_alert_dialog_close"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="@dimen/text_size_normal"
                android:textColor="#484a50"
                android:ellipsize="end"
                android:id="@+id/apply_text"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"/>
            <LinearLayout
                android:id="@+id/info_layout"
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/apply_text">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/header_icon1"
                    android:visibility="gone"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/default_portrait"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"/>
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/header_icon2"
                    android:visibility="gone"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginLeft="11dp"
                    android:src="@drawable/default_portrait"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"/>
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/header_icon3"
                    android:visibility="gone"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginLeft="11dp"
                    android:src="@drawable/default_portrait"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/info_layout"
                android:layout_centerHorizontal="true"
                style="@style/btn_green_solid">
                <ImageView
                    android:id="@+id/icon_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="接受"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textStyle="normal"
        android:textColor="#9b9b9b"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_ignore"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/enhanced_recommend_ignore"/>
</LinearLayout>
