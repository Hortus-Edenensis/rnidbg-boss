<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_corner_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/camera_location_permission"
            android:layout_width="170dp"
            android:layout_height="142dp"
            android:layout_marginTop="4dp"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="开启超真实的社交体验"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="允许获取地理位置"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#aaaaaa"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_per_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="您的位置信息将用来获取附近用户；附近用户可以看到你；聊天时可以分享位置给其他用户；发帖时分享位置等。"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/action"
            android:background="@drawable/selector_btn_green"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="26dp"
            android:text="立即开启"/>
    </LinearLayout>
    <View
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:background="@drawable/camera_location_permission_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="14dp"/>
</FrameLayout>
