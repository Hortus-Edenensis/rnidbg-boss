<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:visibility="gone"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/gift_layout"
                android:background="@drawable/list_item_chat_gift_tips_new_bg"
                android:layout_width="wrap_content"
                android:layout_height="74dp"
                android:layout_marginLeft="35dp"
                android:layout_marginRight="35dp"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/iv_flower"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="16dp"
                    android:layout_toRightOf="@+id/iv_flower"
                    android:layout_centerVertical="true">
                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:alignItems="center"
                        app:flexWrap="nowrap">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/tv_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            app:layout_flexShrink="1"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_flexShrink="0">
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="("/>
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_lianxindou_16"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:id="@+id/tv_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=")"/>
                        </LinearLayout>
                    </com.google.android.flexbox.FlexboxLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff6b8e"
                        android:ellipsize="end"
                        android:id="@+id/tv_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
