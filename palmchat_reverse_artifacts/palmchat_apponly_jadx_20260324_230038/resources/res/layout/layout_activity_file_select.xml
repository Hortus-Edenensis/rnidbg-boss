<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/file_list_view"
            android:background="@color/white"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:fadingEdgeLength="0dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="#ffffffff"
            android:divider="@drawable/list_item_divider_with_file"
            android:dividerHeight="1dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/permission_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="148dp"
                android:text="无法访问本地文件"
                style="@style/main_tab_text"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="40dp"
                android:text="你已关闭「允许访问以管理所有文件」\10权限，开启后才能使用此功能"
                style="@style/main_tab_text"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="40dp"
                android:text="部分系统可能暂不支持开启此权限，请\10等待系统升级后再尝试。"
                style="@style/main_tab_text"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:enabled="true"
                android:gravity="center"
                android:id="@+id/action_btn_permission"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="65dp"
                android:layout_marginRight="65dp"
                android:layout_marginBottom="160dp"
                android:text="前往开启权限"
                style="@style/big_button_green"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
