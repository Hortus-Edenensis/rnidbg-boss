<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="15dp"
    android:paddingRight="16dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="415dp">
    <TextView
        android:textSize="@dimen/dimen_18"
        android:textStyle="bold"
        android:textColor="#333333"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <ImageView
        android:id="@+id/img_close"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:layout_marginRight="-5dp"
        android:src="@drawable/icon_square_wish_dialog_close"
        android:layout_alignParentRight="true"/>
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/img_banner"
        android:background="@drawable/square_topic_guide_banner_bg"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="19dp"
        android:scaleType="fitXY"
        android:layout_below="@+id/tv_title"
        app:esv_shape="round_rectangle"
        app:radius_x_dp="14dp"
        app:radius_y_dp="14dp"/>
    <FrameLayout
        android:id="@+id/fl_portrait"
        android:background="@drawable/shape_white_circle"
        android:padding="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-22dp"
        android:layout_below="@+id/img_banner"
        android:layout_centerHorizontal="true">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/img_portrait"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:esv_shape="circle"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dimen_14"
        android:textColor="#333333"
        android:id="@+id/tv_greet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:layout_below="@+id/fl_portrait"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dimen_13"
        android:textColor="#666666"
        android:id="@+id/tv_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="9dp"
        android:maxLines="1"
        android:layout_below="@+id/tv_greet"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:orientation="horizontal"
        android:id="@+id/btn_confirm"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="57dp"
        android:layout_marginRight="57dp"
        android:text="立即参与"
        android:layout_alignParentBottom="true"
        style="@style/btn_green_solid"/>
</RelativeLayout>
