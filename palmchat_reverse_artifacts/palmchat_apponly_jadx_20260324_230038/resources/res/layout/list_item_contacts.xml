<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/group_indicator"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:text="A"
            style="@style/text_middle_content_B3_Gd"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/special_attention_indicator"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_conversation_specialattention_indicator"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#999"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="特别关注"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/selector_settings_item_background"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zenmen.palmchat.widget.LXPortraitView
            android:layout_gravity="center_vertical"
            android:id="@+id/portrait"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="5dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="测试一个很长的名字很长的名字"
                    android:lines="1"
                    android:maxEms="10"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    style="@style/text_normal_content"/>
                <TextView
                    android:id="@+id/tv_official"
                    android:visibility="visible"
                    android:layout_marginLeft="4dp"
                    android:layout_toRightOf="@+id/nick_name"
                    android:layout_centerVertical="true"
                    style="@style/official_text_tag"/>
                <ImageView
                    android:id="@+id/iv_vip"
                    android:visibility="visible"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="4dp"
                    android:src="@drawable/vip_icon_normal_small"
                    android:layout_toRightOf="@+id/tv_official"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ff3abc"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_intimacy_score"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="22dp"
                    android:text="100°"
                    android:drawableLeft="@drawable/ic_intimacy_thread_flag"
                    android:drawablePadding="2dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/color_divider_contact"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="1px"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="1px"/>
</LinearLayout>
