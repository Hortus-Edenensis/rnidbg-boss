<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row_rec_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_item_portrait_view_size_margin_right_top"
                android:layout_toRightOf="@+id/portrait">
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@color/text_color_gray"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    android:maxWidth="@dimen/list_item_text_width"
                    android:text="nameaaaaaaaaaaaaaaaaaaaddddddddddddddddaaaaaaaa"
                    android:singleLine="true"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/gift_cl_content"
                    android:background="@drawable/gift_ic_card_left_background"
                    android:layout_width="215dp"
                    android:layout_height="107dp"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.zenmen.palmchat.widget.EffectiveShapeView
                        android:id="@+id/gift_iv_image"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginLeft="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:id="@+id/gift_tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/gift_tv_content"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#999999"
                        android:id="@+id/gift_tv_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/gift_tv_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#999999"
                    android:id="@+id/gift_tv_tips"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    android:layout_marginTop="6dp"
                    android:text="当前版本无法查看礼物效果，请升级版本！"/>
            </LinearLayout>
            <View
                android:id="@+id/audio_read"
                android:background="@drawable/red_circle"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginLeft="7dp"
                android:layout_toRightOf="@+id/row_rec_location"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
