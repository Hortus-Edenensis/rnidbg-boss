<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_smallvideo_field"
        android:background="@drawable/background_smallvideo"
        android:clickable="true"
        android:layout_width="220dp"
        android:layout_height="304dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="7dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/wine_head"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_default_link"
                android:scaleType="centerCrop"
                android:layout_alignParentRight="true"
                app:esv_shape="circle"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_color_202020"
                android:ellipsize="end"
                android:id="@+id/wine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="asdfasdf"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/text_color_202020"
            android:ellipsize="end"
            android:id="@+id/wine_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="7dp"
            android:text="titletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitle"
            android:maxLines="1"/>
        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="214dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:cardCornerRadius="4dp">
            <com.zenmen.palmchat.widget.AspectRatioFrameLayout
                android:id="@+id/video_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/smallvideo_cover"
                android:background="@drawable/icon_webapp_default"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/video_progress"
                android:visibility="gone"
                android:layout_width="50dp"
                android:layout_height="50dp"
                style="@style/LocationLoadingProgressBar"/>
        </androidx.cardview.widget.CardView>
        <View
            android:background="#e5e5e5"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"/>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">
            <ImageView
                android:id="@+id/source_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_web_app"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="9dp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/source_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="小应用"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
