<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#222"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:text="安全验证"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#222"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:text="系统检测行为存在风险，请拖动下方滑块进行安全验证，多次验证失败将可能无法正常使用连信。"/>
    <RelativeLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <WebView
            android:id="@+id/dialogWebView"
            android:visibility="invisible"
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/progress_img"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/custom_progress_icon"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/retryView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_captcha_error"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#666"
                android:id="@+id/retryTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/captcha_error_text"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
