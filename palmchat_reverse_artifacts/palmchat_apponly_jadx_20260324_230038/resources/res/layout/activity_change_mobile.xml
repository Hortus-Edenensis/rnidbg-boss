<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button2"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/text_color_999"
        android:id="@+id/validate_mobile_tip_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/text_size_big2"
        android:layout_marginTop="@dimen/text_size_27"
        android:layout_marginRight="@dimen/text_size_big2"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/text_size_50"
        android:layout_marginLeft="@dimen/text_size_big2"
        android:layout_marginTop="@dimen/text_size_45"
        android:layout_marginRight="@dimen/text_size_big2">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/country_code_area"
            android:background="@drawable/selector_edit_text_underline_green"
            android:layout_width="@dimen/text_size_64"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/unread_small_dot"
            android:layout_alignParentLeft="true">
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@android:color/black"
                android:id="@+id/country_code_text"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_8"
                android:textColor="@android:color/black"
                android:gravity="center_horizontal"
                android:id="@+id/country_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <EditText
            android:textSize="@dimen/text_size_normal"
            android:textColor="@android:color/black"
            android:textColorHint="@color/edit_text_hint_color"
            android:gravity="center_vertical"
            android:id="@+id/mobile_edit"
            android:background="@drawable/selector_edit_text_underline_green"
            android:paddingLeft="@dimen/text_size_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/your_mobile_number"
            android:layout_toRightOf="@+id/country_code_area"
            android:inputType="number"/>
    </RelativeLayout>
</LinearLayout>
