<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_circle_voucher_list_block"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/feed_dp_4"
        android:layout_marginBottom="@dimen/feed_dp_10">
        <TextView
            android:textSize="@dimen/feed_dp_11"
            android:textColor="@color/text_color_202020"
            android:background="@drawable/shape_white_round_corner_13dp"
            android:paddingLeft="@dimen/dp_10"
            android:paddingTop="@dimen/feed_dp_6"
            android:paddingRight="@dimen/dp_10"
            android:paddingBottom="@dimen/feed_dp_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/feed_dp_12"
            android:text="券红包中心"
            android:drawableLeft="@drawable/ic_voucher_list"
            android:drawablePadding="@dimen/feed_dp_5"/>
        <View
            android:layout_gravity="top|right"
            android:id="@+id/ic_circle_voucher_list_dot"
            android:background="@drawable/red_circle"
            android:visibility="gone"
            android:layout_width="@dimen/feed_dp_6"
            android:layout_height="@dimen/feed_dp_6"/>
    </FrameLayout>
</LinearLayout>
