<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_search2"/>
    <RelativeLayout
        android:id="@+id/permission_fail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp">
        <ImageView
            android:id="@+id/permission_icon"
            android:layout_width="180dp"
            android:layout_height="143dp"
            android:src="@drawable/new_me_ic_phone_binding_permission"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/permission_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/permission_granted_guide_contact_title"
            android:layout_below="@+id/permission_icon"
            android:layout_centerHorizontal="true"
            style="@style/text_normal_content"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Gd"
            android:id="@+id/permission_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_granted_guide_contact_detail"
            android:layout_below="@+id/permission_text"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:enabled="true"
            android:id="@+id/permission_add"
            android:background="@drawable/selector_btn_green_normal"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="80dp"
            android:layout_below="@+id/permission_sub_text"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/text_color_btn_green"
                android:id="@+id/permission_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permission_granted_guide_contact_button"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/contacts_list_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:gravity="top"
            android:id="@+id/contacts_list"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000"
            android:layout_above="@+id/one_key_area"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#9b9b9b"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_empty_view"
            android:background="#ebebeb"
            android:paddingTop="29dp"
            android:paddingBottom="29dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/no_contact_tip"/>
        <FrameLayout
            android:id="@+id/one_key_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_alignParentBottom="true">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.93"/>
            <TextView
                android:textSize="17dp"
                android:layout_gravity="center"
                android:id="@+id/btn_one_key_add"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/recommend_friend_result_title"
                style="@style/btn_green_solid"/>
        </FrameLayout>
    </RelativeLayout>
    <ListView
        android:gravity="top"
        android:id="@+id/contacts_search_list"
        android:visibility="gone"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:stackFromBottom="false"
        android:scrollingCache="false"
        android:cacheColorHint="#00000000"/>
</LinearLayout>
