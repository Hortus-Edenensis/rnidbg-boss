<?xml version="1.0" encoding="utf-8"?>
<com.zenmen.palmchat.paidservices.superexpose.msgtab.ui.recycler.SuperExposeTabRecyclerItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:tag="layout/super_expose_num_layout_item_0"
    android:layout_width="169dp"
    android:layout_height="230dp">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/super_num_item_icon_dft_bg"
        android:scaleType="fitXY"
        app:esv_shape="round_rectangle"
        app:radius_x_dp="8dp"
        app:radius_y_dp="8dp"/>
    <LinearLayout
        android:layout_gravity="bottom|left"
        android:orientation="vertical"
        android:background="@drawable/super_num_item_bottom_bg"
        android:paddingLeft="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/tag_layout_1"
                android:background="@drawable/super_num_item_tag_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp">
                <View
                    android:id="@+id/tag_green_bg_1"
                    android:background="@drawable/super_num_item_green_tag_bg"
                    android:layout_width="4dp"
                    android:layout_height="4dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/item_tag_1"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginLeft="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/tag_layout_2"
                android:background="@drawable/super_num_item_tag_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="4dp">
                <View
                    android:id="@+id/tag_green_bg_2"
                    android:background="@drawable/super_num_item_green_tag_bg"
                    android:layout_width="4dp"
                    android:layout_height="4dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/item_tag_2"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginLeft="1dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/name_age_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:maxWidth="120dp"
                android:lines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/distance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:text="16.5km"
            android:includeFontPadding="false"/>
    </LinearLayout>
</com.zenmen.palmchat.paidservices.superexpose.msgtab.ui.recycler.SuperExposeTabRecyclerItemLayout>
