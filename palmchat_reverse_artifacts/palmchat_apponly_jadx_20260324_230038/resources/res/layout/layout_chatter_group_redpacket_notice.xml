<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lyt_net_status"
    android:background="#ffdfdf"
    android:paddingLeft="20dp"
    android:paddingTop="10dp"
    android:paddingRight="20dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/group_redpacket_notice_icon"
            android:layout_width="14dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_group_redpacket"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_color_666666"
            android:id="@+id/group_redpacket_notice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="红包总额："
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            android:textColor="#e02020"
            android:id="@+id/group_redpacket_notice_acount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="888.88元"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_color_666666"
            android:id="@+id/group_redpacket_notice_issue_amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="已发放："
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            android:textColor="#e02020"
            android:id="@+id/group_redpacket_notice_issue_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="88.88元"
            android:maxLines="1"
            android:drawableRight="@drawable/ic_group_redpacket_notice_next"
            android:drawablePadding="5dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/text_color_666666"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/group_redpacket_notice_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/group_redpacket_countdown_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:textSize="@dimen/text_size_middle"
            android:textColor="#e02020"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/group_redpacket_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1天 23:23:23"
            android:maxLines="1"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/text_size_middle"
            android:textColor="#e02020"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/group_redpacket_countdown_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距离拆红包："
            android:maxLines="1"
            android:drawableLeft="@drawable/ic_group_redpacket_cutdown"
            android:drawablePadding="4dp"
            android:layout_toLeftOf="@+id/group_redpacket_countdown"/>
    </RelativeLayout>
</LinearLayout>
