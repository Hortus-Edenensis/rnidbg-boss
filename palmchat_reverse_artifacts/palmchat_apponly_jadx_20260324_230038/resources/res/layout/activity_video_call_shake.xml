<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_full_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/deep_local_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/remote_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <SurfaceView
            android:id="@+id/remote_view"
            android:background="@android:color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/callee_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/callee_background_blur"
        android:background="#dadada"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/local_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <SurfaceView
        android:id="@+id/up_remote_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/surface_cover_view"
        android:background="@android:color/black"
        android:visibility="gone"
        android:drawingCacheQuality="high"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="@dimen/text_size_tiny"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/connection_quality_toast"
        android:background="@drawable/shape_video_toast_view"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="@string/video_call_connection_toast"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/video_headimage_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="45dp"
        android:layout_marginRight="12dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/portrait"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp">
            <TextView
                android:textSize="@dimen/A2"
                android:textStyle="bold"
                android:textColor="@color/Ab"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/B3"
                android:textColor="@color/Ab"
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/include_toast_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/audio_headimage_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/audio_portrait"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/A2"
                android:textStyle="bold"
                android:textColor="@color/Ab"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/audio_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/B2"
                android:textColor="@color/Ab"
                android:layout_gravity="center_horizontal"
                android:id="@+id/audio_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/twenty_toast_content"
            android:background="@drawable/shape_video_toast_view"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:text="@string/video_call_call_later"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/video_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="@dimen/B2"
            android:textColor="@color/Ab"
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_call_duration_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/switch_audio_container"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="4dp"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/switch_audio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/selector_video_call_switch_audio_no_frame"
                        android:scaleType="centerInside"/>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/C2"
                    android:textColor="@color/Ab"
                    android:id="@+id/switch_audio_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/switch_audio"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/right_switch_audio_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true">
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="4dp"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/right_switch_audio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/selector_video_call_switch_audio_no_frame"
                        android:scaleType="centerInside"/>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/C2"
                    android:textColor="@color/Ab"
                    android:id="@+id/right_switch_audio_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/switch_audio_accept"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/silence_area"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/silence_btn"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size"
                    android:src="@drawable/selector_video_call_silence"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/silence_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/video_call_mute"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/switch_audio_bottom_container"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_weight="1">
                <FrameLayout
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="4dp"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size">
                    <ImageView
                        android:id="@+id/switch_audio_bottom_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/selector_video_call_switch_audio"
                        android:scaleType="centerInside"/>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/switch_audio_bottom_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/switch_audio"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/hangup_btn"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size"
                    android:src="@drawable/selector_video_call_hangup"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/hangup_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/handsfree_area"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/handsfree_btn"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size"
                    android:src="@drawable/video_call_handfree_disable"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/handsfree_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/video_call_hands_off"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/switch_camera_container"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_weight="1">
                <FrameLayout
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="4dp"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size">
                    <ImageView
                        android:id="@+id/switch_camera_button"
                        android:background="@drawable/selector_video_call_button_backround"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/selector_video_call_switch_camera"
                        android:scaleType="centerInside"/>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/switch_camera_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/switch_camera"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/view_stub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/accept_btn_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/accept_btn"
                    android:layout_width="@dimen/video_call_button_size"
                    android:layout_height="@dimen/video_call_button_size"
                    android:layout_marginTop="26dp"
                    android:src="@drawable/selector_video_call_accept"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/accept_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/video_call_accept"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/swap_screen_btn"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="45dp"
        android:src="@drawable/selector_video_call_swap_screen"/>
</FrameLayout>
