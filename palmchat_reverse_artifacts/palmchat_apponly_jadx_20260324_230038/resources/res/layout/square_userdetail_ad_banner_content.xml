<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/square_userdetail_ad_banner_content_0"
    android:background="@drawable/square_userdetail_ad_banner_content_main_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="54dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/ad_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:esv_shape="round_rectangle"
                app:radius_x_dp="4dp"
                app:radius_y_dp="4dp"/>
            <FrameLayout
                android:id="@+id/ad_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.zenmen.palmchat.widget.RoundCornerCoverView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cornerRad="4dp"/>
            <com.zenmen.palmchat.ad.ShakeView
                android:id="@+id/shake"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/ad_close"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/square_userdetail_ad_banner_content_del"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp">
            <TextView
                android:textSize="17dp"
                android:textColor="#222222"
                android:id="@+id/ad_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#666666"
                            android:id="@+id/ad_app_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/square_userdetail_ad_banner_content_sign_bg"
                            android:paddingLeft="3dp"
                            android:paddingTop="2.5dp"
                            android:paddingRight="3dp"
                            android:paddingBottom="2.5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp">
                            <ImageView
                                android:id="@+id/ad_icon"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginRight="2dp"
                                android:scaleType="fitCenter"/>
                            <TextView
                                android:textSize="6dp"
                                android:textColor="#939191"
                                android:id="@+id/ad_sign"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="20dp">
                        <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/app_download_btn"
                            android:tag="huawei_download_btn"
                            android:paddingLeft="11dp"
                            android:paddingTop="3dp"
                            android:paddingRight="11dp"
                            android:paddingBottom="3dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hiad_fixedWidth="true"
                            app:hiad_maxWidth="60dp"
                            app:hiad_minWidth="60dp"
                            app:hiad_textColor="#ffffff"
                            app:hiad_textSize="12dp"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/ad_action"
                        android:background="@drawable/square_userdetail_ad_generic_action_bg"
                        android:paddingLeft="11dp"
                        android:paddingTop="3dp"
                        android:paddingRight="11dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:minWidth="70dp"
                        android:minHeight="23dp"
                        android:text="@string/ad_show_more"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayout
            android:id="@+id/ad_com_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
