<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/selector_richmsg_subitem_background"
    android:paddingLeft="15dp"
    android:paddingTop="16dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/B2"
        android:textColor="@color/Gb"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="title"
        android:maxLines="1"/>
    <TextView
        android:textSize="@dimen/C1"
        android:textColor="@color/Gd"
        android:ellipsize="end"
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="12.12"
        android:maxLines="1"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="166dp"
        android:layout_marginTop="13dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="166dp"
            android:src="@drawable/ic_default_link"
            android:scaleType="centerCrop"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="4dp"
            app:radius_y_dp="4dp"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Ab"
            android:id="@+id/readNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginBottom="5dp"
            android:text="test"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/B4"
        android:textColor="@color/Gd"
        android:ellipsize="end"
        android:id="@+id/digest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="24dp"
        android:text="contentcontentcontentcontentcontentcontentcontentcontentcontentcontentcontentcontentcontent"
        android:maxLines="5"/>
</LinearLayout>
