<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="15dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textColor="#363636"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enhanced_recommend_feedback_option_title"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#f85644"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*"/>
        </LinearLayout>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/feedback_radioGroup"
            android:paddingLeft="3dp"
            android:paddingTop="7dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <RadioButton
                android:id="@+id/radioButton1"
                android:paddingLeft="7dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:button="@drawable/selector_btn_green_checkbox"
                android:text="@string/enhanced_recommend_feedback_option_1"
                style="@style/feedback_radiobutton_text"/>
            <RadioButton
                android:id="@+id/radioButton2"
                android:paddingLeft="7dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:button="@drawable/selector_btn_green_checkbox"
                android:text="@string/enhanced_recommend_feedback_option_2"
                style="@style/feedback_radiobutton_text"/>
        </RadioGroup>
        <TextView
            android:textSize="17dp"
            android:textColor="#363636"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enhanced_recommend_feedback_edit_title"/>
        <EditText
            android:textSize="@dimen/text_size_small"
            android:textColor="#4a4a4a"
            android:textColorHint="#bababa"
            android:gravity="left"
            android:id="@+id/feedback_content_edit"
            android:background="@drawable/enhanced_recommend_feedback_edit_bg"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:hint="@string/enhanced_recommend_feedback_edit_hint"
            android:maxLength="140"
            android:lineSpacingMultiplier="1.1"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/submit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            style="@style/btn_green_solid">
            <TextView
                android:enabled="true"
                android:textSize="@dimen/text_size_normal"
                android:textColor="@color/text_color_btn_green"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:text="@string/enhanced_recommend_feedback_submit"
                android:drawablePadding="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_size_xxsmall"
            android:textColor="#999999"
            android:layout_gravity="center_horizontal"
            android:id="@+id/feedback_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            android:text="@string/enhanced_recommend_feedback_tip"/>
    </LinearLayout>
</LinearLayout>
