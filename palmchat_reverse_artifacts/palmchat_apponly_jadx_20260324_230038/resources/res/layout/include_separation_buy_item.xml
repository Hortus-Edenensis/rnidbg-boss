<?xml version="1.0" encoding="utf-8"?>
<com.zenmen.square.ui.widget.MapSeparationBuyItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="90dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/map_separation_buy_item_white_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14dp"
                android:textColor="#999999"
                android:id="@+id/separation_item_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="24小时"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/separation_item_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="20豆"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/separation_item_result"
            android:background="@drawable/map_separation_item_result_white_bg"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:text="约43豆/天"
            android:maxLines="1"/>
        <View
            android:id="@+id/separation_buy_green_layout"
            android:background="@drawable/map_separation_buy_item_green_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/separation_item_red"
        android:background="@drawable/map_separation_item_red_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:maxWidth="80dp"
        android:text="强烈推荐"
        android:lines="1"/>
</com.zenmen.square.ui.widget.MapSeparationBuyItemLayout>
