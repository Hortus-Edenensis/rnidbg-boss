<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/portrait"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row_rec_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/portrait">
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@color/text_color_gray"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:paddingLeft="11dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="240dp"
                    android:text="nameaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                    android:singleLine="true"/>
                <FrameLayout
                    android:id="@+id/view_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
