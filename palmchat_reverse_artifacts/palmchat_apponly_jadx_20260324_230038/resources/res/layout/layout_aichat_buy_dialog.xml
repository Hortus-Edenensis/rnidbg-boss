<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ai_chat_buy_all_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/ai_chat_show_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="bottom"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="100dp"/>
            <FrameLayout
                android:background="@drawable/ai_chat_buy_top_bg"
                android:layout_width="match_parent"
                android:layout_height="193dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <com.zenmen.palmchat.widget.EffectiveShapeView
                        android:id="@+id/other_avatar_img"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/default_portrait"
                        android:scaleType="fitXY"
                        app:esv_shape="circle"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="25dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="20dp"
                        android:src="@drawable/ai_chat_act_item_like_bg"
                        android:scaleType="fitXY"/>
                    <com.zenmen.palmchat.widget.EffectiveShapeView
                        android:id="@+id/mine_avatar_img"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginLeft="20dp"
                        android:src="@drawable/default_portrait"
                        android:scaleType="fitXY"
                        app:esv_shape="circle"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/ai_name_title"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:maxWidth="180dp"
                        android:text="守护Tutu的小丸子"
                        android:lines="1"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/name_time_layout"
                        android:layout_width="match_parent"
                        android:layout_height="22dp">
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="守护剩余时间："
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#ff463c"
                            android:gravity="center"
                            android:id="@+id/name_time_view"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="25"/>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="天"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <ImageView
                        android:id="@+id/sex_img"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_female"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#cacccf"
                        android:gravity="center"
                        android:id="@+id/location_name_view"
                        android:background="@drawable/ai_chat_buy_text_bg"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginLeft="6dp"
                        android:text="上海"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#cacccf"
                        android:gravity="center"
                        android:id="@+id/ai_tag_name"
                        android:background="@drawable/ai_chat_buy_text_bg"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginLeft="6dp"
                        android:text="AI虚拟人"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <View
                        android:background="#f5f5f5"
                        android:layout_width="19dp"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#999999"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:text="守护特权"
                        android:includeFontPadding="false"/>
                    <View
                        android:background="#f5f5f5"
                        android:layout_width="19dp"
                        android:layout_height="1dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="77dp"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="52dp"
                            android:layout_marginLeft="-4dp"
                            android:src="@drawable/ai_chat_buy_chat"/>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:text="聊天"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:id="@+id/ai_chat_buy_chat_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="和他随时随地畅聊"
                            android:lines="2"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="77dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="52dp"
                            android:layout_marginLeft="-4dp"
                            android:src="@drawable/ai_chat_buy_yuyin"/>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:text="语音内容"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:id="@+id/ai_chat_buy_yuyin_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="收听他的语音消息"
                            android:lines="2"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="77dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="52dp"
                            android:layout_marginLeft="-4dp"
                            android:src="@drawable/ai_chat_buy_pic"/>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:text="专享照片"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:id="@+id/ai_chat_buy_pic_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="查看他的专享照片"
                            android:lines="2"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="77dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="52dp"
                            android:layout_marginLeft="-4dp"
                            android:src="@drawable/ai_chat_buy_video"/>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:text="专享视频"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:id="@+id/ai_chat_buy_video_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="查看他的专享视频"
                            android:lines="2"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="101dp"
                    android:layout_marginTop="15dp">
                    <FrameLayout
                        android:id="@+id/sku_buy_layout1"
                        android:layout_width="90dp"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:id="@+id/sku_buy_detail1"
                            android:background="@drawable/ai_chat_buy_sku_normal_bg"
                            android:layout_width="match_parent"
                            android:layout_height="92dp">
                            <TextView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:textColor="#222222"
                                android:id="@+id/sku_buy_1_time"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginTop="8dp"
                                android:text="1个月"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#222222"
                                android:id="@+id/sku_buy_1_price"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp"
                                android:maxWidth="82dp"
                                android:text="100连信豆"
                                android:lines="1"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#cacccf"
                                android:id="@+id/sku_buy_1_num"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp"
                                android:maxWidth="82dp"
                                android:text="10元/月"
                                android:lines="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/sku_buy_top1"
                            android:background="@drawable/ai_chat_buy_sku_item_top_bg"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:maxWidth="86dp"
                            android:text="限时折扣"
                            android:lines="1"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/sku_buy_layout2"
                        android:visibility="gone"
                        android:layout_width="90dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:id="@+id/sku_buy_detail2"
                            android:background="@drawable/ai_chat_buy_sku_normal_bg"
                            android:layout_width="match_parent"
                            android:layout_height="92dp">
                            <TextView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:textColor="#222222"
                                android:id="@+id/sku_buy_2_time"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginTop="8dp"
                                android:text="3个月"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#222222"
                                android:id="@+id/sku_buy_2_price"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp"
                                android:maxWidth="82dp"
                                android:text="198连信豆"
                                android:lines="1"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#cacccf"
                                android:id="@+id/sku_buy_2_num"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp"
                                android:maxWidth="82dp"
                                android:text="6.6元/月"
                                android:lines="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/sku_buy_top2"
                            android:background="@drawable/ai_chat_buy_sku_item_top_bg"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:maxWidth="86dp"
                            android:text="限时折扣"
                            android:lines="1"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/sku_buy_layout3"
                        android:visibility="gone"
                        android:layout_width="90dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:id="@+id/sku_buy_detail3"
                            android:background="@drawable/ai_chat_buy_sku_normal_bg"
                            android:layout_width="match_parent"
                            android:layout_height="92dp">
                            <TextView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:textColor="#222222"
                                android:id="@+id/sku_buy_3_time"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginTop="8dp"
                                android:text="12个月"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#222222"
                                android:id="@+id/sku_buy_3_price"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp"
                                android:maxWidth="82dp"
                                android:text="600连信豆"
                                android:lines="1"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="#cacccf"
                                android:id="@+id/sku_buy_3_num"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp"
                                android:maxWidth="82dp"
                                android:text="5元/月"
                                android:lines="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/sku_buy_top3"
                            android:background="@drawable/ai_chat_buy_sku_item_top_bg"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:maxWidth="86dp"
                            android:text="限时折扣"
                            android:lines="1"/>
                    </FrameLayout>
                </LinearLayout>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ai_sku_btn"
                    android:background="@drawable/ai_chat_act_item_btn_bg"
                    android:layout_width="280dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:text="延长守护"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="40dp">
                    <ImageView
                        android:id="@+id/privacy_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_super_expose_dialog_privacy"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#999999"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/bug_info_text1"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginLeft="4dp"
                        android:text="我已阅读并同意"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#2b94fa"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/bug_info_text2"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:text="《连信守护服务协议》"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/close_img"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:src="@drawable/ai_chat_buy_close"
                android:scaleType="fitXY"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
