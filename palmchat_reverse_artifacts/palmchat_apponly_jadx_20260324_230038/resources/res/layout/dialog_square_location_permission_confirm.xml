<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_white_corner_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="温馨提示"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#999"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="15dp"
            android:text="授权位置信息，才能让动态被更多附近的人看到。"/>
        <RelativeLayout
            android:id="@+id/location_rl"
            android:background="@drawable/shape_f5f5f5_20"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon_location"
                android:background="@drawable/bg_multi_publish_icon_tag"
                android:padding="3dp"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/square_multi_publish_location"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/Gb"
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="请授权位置信息"
                android:lines="1"
                android:layout_toRightOf="@+id/icon_location"/>
        </RelativeLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/action"
            android:background="@drawable/selector_btn_green"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="30dp"
            android:text="直接发布"/>
    </LinearLayout>
    <View
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:background="@drawable/camera_location_permission_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="14dp"/>
</FrameLayout>
