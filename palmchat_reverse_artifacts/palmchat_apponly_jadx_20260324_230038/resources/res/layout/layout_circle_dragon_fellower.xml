<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/text_color_363636"
            android:layout_gravity="center_vertical"
            android:id="@+id/circle_dragon_create_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="1:"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/text_color_363636"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/circle_dragon_create_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:text="昵称昵称昵称昵称昵称昵称昵称昵称昵称昵称昵称昵称:"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="5"/>
        <EditText
            android:textSize="15dp"
            android:textColor="@color/text_color_202020"
            android:textColorHint="#ffcccccc"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/circle_dragon_create_publisher"
            android:background="@drawable/selector_edit_text_underline_green"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:hint="填写内容"
            android:singleLine="true"
            android:maxLength="100"
            android:textCursorDrawable="@null"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/text_color_202020"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/circle_dragon_create_publisher_tv"
            android:background="@drawable/selector_edit_text_underline_green"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:maxLength="100"
            android:textCursorDrawable="@null"/>
    </LinearLayout>
</LinearLayout>
