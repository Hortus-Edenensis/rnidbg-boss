<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="188dp">
            <ImageView
                android:id="@+id/ad_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <FrameLayout
                android:id="@+id/ad_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.zenmen.palmchat.widget.AdRoundCornerCoverView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ad_corner_radius="12dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/ad_close"
                android:padding="2dp"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:src="@mipmap/wkmine_bannerview_content_large_close"
                android:scaleType="fitCenter"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:background="@drawable/wkmine_bannerview_content_large_area_bg"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#ffffff"
                        android:id="@+id/ad_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp">
                        <TextView
                            android:textSize="10dp"
                            android:textColor="#ffffff"
                            android:id="@+id/ad_app_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/wkmine_bannerview_content_large_sign_bg"
                            android:paddingLeft="4dp"
                            android:paddingTop="1dp"
                            android:paddingRight="4dp"
                            android:paddingBottom="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp">
                            <ImageView
                                android:id="@+id/ad_icon"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginRight="2dp"
                                android:scaleType="fitCenter"/>
                            <TextView
                                android:textSize="6dp"
                                android:textColor="#dbdbdb"
                                android:id="@+id/ad_sign"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="30dp">
                        <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/app_download_btn"
                            android:tag="huawei_download_btn"
                            android:paddingLeft="12dp"
                            android:paddingTop="4dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hiad_fixedWidth="true"
                            app:hiad_maxWidth="60dp"
                            app:hiad_minWidth="60dp"
                            app:hiad_textColor="#ffffff"
                            app:hiad_textSize="13dp"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/ad_action"
                        android:background="@drawable/wkmine_bannerview_content_large_action_bg"
                        android:paddingLeft="12dp"
                        android:paddingTop="4dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:minWidth="75dp"
                        android:minHeight="26dp"
                        android:text="@string/generic_ad_action_download"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayout
                android:id="@+id/ad_com_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
