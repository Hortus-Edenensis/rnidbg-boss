<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/mContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="13dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="85dp">
            <ImageView
                android:id="@+id/icon"
                android:background="@drawable/ic_intimacy_free_gift_bg"
                android:padding="14dp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_intimacy_free_gift_default"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="top|center_horizontal"
                android:id="@+id/tip_text"
                android:background="@drawable/ic_intimacy_unfriend_gift_tip_bg"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginLeft="-23dp"
                android:text="大兄弟聊起来"
                android:layout_toRightOf="@+id/icon"
                android:layout_alignParentLeft="@+id/icon"/>
        </RelativeLayout>
        <TextView
            android:textColorHighlight="@color/link_url_highlight"
            android:id="@+id/sys_notify_textview"
            android:background="@drawable/gray_round_rect_systeminfo"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="点击立即送出免费礼物，快速开聊"
            style="@style/text_chat_notification"/>
    </LinearLayout>
</RelativeLayout>
