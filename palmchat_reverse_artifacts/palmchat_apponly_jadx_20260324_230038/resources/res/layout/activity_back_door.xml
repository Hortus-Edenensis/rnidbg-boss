<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/activity_horizontal_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back_door_channel"/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_channel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0000-0000-0000-0000"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/build_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back_door_build_time"/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_build_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0000-0000-0000-0000"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/msgCountLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="消息总量："/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_msg_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0000-0000-0000-0000"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tjLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="太极key："/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/taichiconfig"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:text="0000-0000-0000-0000"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/UDLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="新分流key："/>
                <TextView
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/UDconfig"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:text="0000-0000-0000-0000"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/serverType"
                android:id="@+id/servertype"
                android:background="@color/colorGreen"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
            <Button
                android:id="@+id/btn_pwd_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/back_door_pwd_mode"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
