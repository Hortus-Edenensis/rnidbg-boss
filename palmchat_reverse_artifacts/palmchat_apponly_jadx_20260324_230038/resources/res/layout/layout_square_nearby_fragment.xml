<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:square="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.square.ui.widget.SquarePullHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            square:finishText="完成刷新"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zenmen.listui.list.BaseRecyclerView
                android:id="@+id/recycler_view_feeds"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fastScrollEnabled="false"/>
            <com.zenmen.square.ui.widget.NearByStateView
                android:id="@+id/square_feeds_list_state"
                android:background="@color/white"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/unlock_cover"
        android:background="@drawable/square_nearby_unlock_cover_bg"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/join_vip"
            android:background="@drawable/square_nearby_unlock_cover_join"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="15dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="280dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#14cd64"
            android:id="@+id/see_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/map_find_tab_no_layout"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/map_find_tab_no_img"
            android:layout_width="355dp"
            android:layout_height="418dp"
            android:layout_marginTop="45dp"
            android:src="@drawable/map_find_tab_no_all_bg"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/map_find_tab_no_button"
            android:background="@drawable/map_find_tab_no_botton_green_bg"
            android:layout_width="295dp"
            android:layout_height="48dp"
            android:layout_marginBottom="82dp"
            android:text="进入地图找人"/>
    </FrameLayout>
</RelativeLayout>
