<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="28dp"
    android:paddingBottom="28dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_refresh_layout_header"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_smart_pull_header_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_square_loading"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#333333"
            android:id="@+id/tv_refresh_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/iv_smart_pull_header_progress"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/Aa"
        android:gravity="center"
        android:id="@+id/tv_smart_pull_header"
        android:background="@drawable/shape_pull_header_text_bg"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:includeFontPadding="false"
        android:layout_centerInParent="true"/>
</RelativeLayout>
