<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <LinearLayout
        android:background="@color/white"
        android:paddingLeft="@dimen/feed_dp_12"
        android:paddingRight="@dimen/feed_dp_12"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#f5f5f5">
        <com.zenmen.palmchat.widget.ClearEditText
            android:textColorHint="@color/divider_gray"
            android:layout_gravity="center"
            android:id="@+id/et_circle_name"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:hint="请输入群名称"
            android:singleLine="true"
            android:maxLength="15"
            android:textCursorDrawable="@null"
            style="@style/text_normal_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/feed_dp_15"
        android:paddingTop="@dimen/feed_dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:id="@+id/cb_circle_name_modify_permit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@drawable/selector_btn_green_checkbox"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#999990"
            android:id="@+id/circle_name_permission_tips"
            android:paddingLeft="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="只有群主和管理员可修改群名称"/>
    </LinearLayout>
</LinearLayout>
