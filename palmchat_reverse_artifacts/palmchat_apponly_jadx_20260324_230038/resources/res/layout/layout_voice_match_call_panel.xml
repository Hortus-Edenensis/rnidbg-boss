<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_match_call_panel"
    android:background="@drawable/voice_match_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back"
            android:paddingLeft="16dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_voice_match_back"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/report_iv"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:src="@drawable/ic_vm_report"/>
            <ImageView
                android:id="@+id/float_iv"
                android:padding="6dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vm_mini"/>
        </LinearLayout>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="语音速配"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/audio_headimage_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="144dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/A2"
            android:textStyle="bold"
            android:textColor="@color/Ab"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/audio_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="dadsfasdfasdfasdffa"
            android:singleLine="true"
            android:shadowColor="@color/black"
            android:shadowRadius="2"/>
        <TextView
            android:textSize="@dimen/B2"
            android:textColor="@color/Ab"
            android:layout_gravity="center_horizontal"
            android:id="@+id/calling_hint_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="dadsfasdfasdfasdffa"
            android:shadowColor="@color/black"
            android:shadowRadius="2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/contact_layout"
        android:background="@drawable/voice_match_info_background"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <RelativeLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:gravity="center"
                android:id="@+id/call_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="53dp"
                android:minWidth="60dp"
                android:text="00:00"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#999"
                android:gravity="center"
                android:id="@+id/state_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="83dp"
                android:text="通话中"
                android:layout_centerHorizontal="true"/>
            <com.opensource.svgaplayer.SVGAImageView
                android:id="@+id/svga"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="12dp"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_toLeftOf="@+id/call_duration">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/user_icon"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginTop="26dp"
                    android:src="@drawable/ic_default_portrait"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    app:esv_shape="circle"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#222"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AAAAAAAAAA"
                    android:singleLine="true"/>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/level_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#222"
                        android:gravity="center"
                        android:background="@drawable/voice_match_level_text_bg"
                        android:paddingLeft="19dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="7dp"
                        android:text="Lv.1"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/vm_level_1"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/call_duration">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/self_icon"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginTop="26dp"
                    android:src="@drawable/ic_default_portrait"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    app:esv_shape="circle"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#222"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/self_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AAAAAAAAAA"
                    android:singleLine="true"/>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/level_self"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#222"
                        android:gravity="center"
                        android:background="@drawable/voice_match_level_text_bg"
                        android:paddingLeft="19dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="7dp"
                        android:text="Lv.1"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/vm_level_1"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#222"
                android:gravity="center"
                android:id="@+id/about_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于他"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/about_gender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_vm_male"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/des_layout_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="18dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vm_item_tag"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#222"
                android:gravity="center_vertical"
                android:id="@+id/des1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="他在上海，收入5万/年"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/des_layout_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="18dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vm_item_tag"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#222"
                android:gravity="center_vertical"
                android:id="@+id/des2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="接受约会，拓展人脉，交个朋友"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/invite_tv"
            android:background="@drawable/ic_vm_selector_invite_bg"
            android:layout_width="208dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="我要公开身份"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/public_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="聊满3分钟自动公开身份"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="103dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/button_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contact_layout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/invite_video_layout"
        android:background="@drawable/ic_video_match_invite_video_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="70dp"
        android:layout_marginBottom="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/invite_video_ic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_video_match_invite_video"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#f43bad"
            android:id="@+id/invite_video_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="邀ta视频"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/topic_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="136dp"
        android:src="@drawable/ic_vm_topic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/topic_iv_bubble"
        android:background="@drawable/ic_vm_topic_bubble"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="7dp"
        android:layout_marginBottom="2dp"
        android:text="不知道聊什么？试试随机话题吧~"
        app:layout_constraintBottom_toTopOf="@+id/topic_iv"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/silence_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/silence_iv"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_vm_silence_normal"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#222"
                android:id="@+id/silence_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="静音"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/hangup_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/hangup_iv"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_re_voip_hangup"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#222"
                android:id="@+id/hangup_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="拒绝"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/speaker_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/speaker_iv"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_vm_speaker_normal"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#222"
                android:id="@+id/speaker_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="免提"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/accept_layout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/accept_iv"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_re_voip_accept"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#222"
                android:id="@+id/accept_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="接听"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/finish_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/finish_user_icon"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="34dp"
            android:src="@drawable/ic_default_portrait"
            android:scaleType="centerCrop"
            app:esv_shape="circle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/finish_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="AAAAAAAAAA"
                android:singleLine="true"/>
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/level_finish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#222"
                    android:gravity="center"
                    android:background="@drawable/voice_match_level_text_bg_white"
                    android:paddingLeft="19dp"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="7dp"
                    android:text="Lv.1"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/vm_level_1"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#999"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/finish_during"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="通话时间00:30，继续匹配吧~"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/voice_match_comment_bg"
            android:layout_width="208dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#999"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/finish_comment_bad"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="不满意"
                android:singleLine="true"
                android:drawableLeft="@drawable/ic_vm_comment_bad"
                android:layout_weight="1"/>
            <View
                android:background="#f5f5f5"
                android:layout_width="1dp"
                android:layout_height="24dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#999"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/finish_comment_good"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="还不错"
                android:singleLine="true"
                android:drawableLeft="@drawable/ic_vm_comment_good"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.zenmen.palmchat.framework.bridge.voicomatch.MatchPropInfoCardView
            android:id="@+id/rematch_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/risk_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="none"
            android:id="@+id/risk_tv"
            android:background="@drawable/voice_match_secure_notice_bg"
            android:padding="10dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系统检测到对方言论可能涉及违规，如有不适，请立即投诉。"
            android:singleLine="true"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
