<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_square_nearby_item_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_content"
        android:paddingLeft="6dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.palmchat.widget.LXPortraitView
            android:id="@+id/iv_nearby_avatar"
            android:tag="binding_1"
            android:layout_width="86dp"
            android:layout_height="86dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:show_wave="true"
            app:venus_init_radius="30dp"
            app:venus_max_radius="43dp"
            app:venus_portrait_margin="10dp"
            app:venus_text_size="10dp"/>
        <com.zenmen.palmchat.widget.LightingAnimationView
            android:id="@+id/anim_view"
            android:visibility="visible"
            android:layout_width="86dp"
            android:layout_height="86dp"
            app:la_colors="#00FFFFFF,#E6FFFFFF,#E6FFFFFF,#00FFFFFF"
            app:la_positions="0,0.4,0.5,1"
            app:la_w="25dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_nearby_avatar"
            app:layout_constraintLeft_toLeftOf="@+id/iv_nearby_avatar"
            app:layout_constraintRight_toRightOf="@+id/iv_nearby_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_nearby_avatar"/>
        <ImageView
            android:id="@+id/iv_label"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="86dp"
            android:layout_height="18dp"
            android:layout_marginTop="66dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_nearby_avatar"
            app:layout_constraintRight_toRightOf="@+id/iv_nearby_avatar"
            app:layout_constraintStart_toStartOf="@+id/iv_nearby_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_nearby_avatar"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/tv_nearby_user_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            app:alignItems="center"
            app:flexDirection="row"
            app:flexWrap="nowrap"
            app:justifyContent="flex_start"
            app:layout_constraintLeft_toRightOf="@+id/iv_nearby_avatar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_nearby_avatar">
            <TextView
                android:textSize="16dp"
                android:ellipsize="end"
                android:id="@+id/tv_nearby_name"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_flexGrow="0"
                app:layout_flexShrink="1"/>
            <ImageView
                android:id="@+id/iv_feed_sex"
                android:tag="binding_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="6dp"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <ImageView
                android:id="@+id/iv_feed_ai_chat"
                android:visibility="gone"
                android:layout_width="52dp"
                android:layout_height="18dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ai_chat_find_logo_bg_pp"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <TextView
                android:id="@+id/tv_official"
                android:tag="binding_5"
                android:layout_marginLeft="6dp"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"
                style="@style/official_text_tag"/>
            <ImageView
                android:id="@+id/iv_vip"
                android:tag="binding_6"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="6dp"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <RelativeLayout
                android:id="@+id/rl_super_expose_item_enter"
                android:tag="binding_7"
                android:background="@drawable/ic_super_expose_item_enter"
                android:visibility="gone"
                android:layout_width="54dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0">
                <RelativeLayout
                    android:background="@color/transparent"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@+id/iv_super_expose_item_enter_arrow"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_super_expose_item_enter_arrow"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_feed_map_separation"
                android:visibility="gone"
                android:layout_width="46dp"
                android:layout_height="18dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/feed_map_separation_icon"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_flexGrow="1"
                app:layout_flexShrink="0"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/Gd"
                android:id="@+id/tv_nearby_distance"
                android:tag="binding_8"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <TextView
                android:textSize="12dp"
                android:id="@+id/tv_nearby_online_state"
                android:tag="binding_9"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <com.zenmen.listui.widget.LeftDrawableText
            android:textSize="12dp"
            android:textColor="@color/Aa"
            android:gravity="center_vertical"
            android:id="@+id/btn_say_hi"
            android:tag="binding_10"
            android:background="@drawable/bg_text_green_26"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="12dp"
            android:drawableLeft="@drawable/icon_say_hi_left"
            android:drawablePadding="3dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_nearby_user_desc"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/Gb"
            android:ellipsize="end"
            android:id="@+id/iv_nearby_user_profile"
            android:tag="binding_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="@+id/tv_nearby_user_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_nearby_user_desc"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/Gd"
            android:ellipsize="end"
            android:id="@+id/iv_nearby_desc"
            android:tag="binding_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="@+id/iv_nearby_user_profile"
            app:layout_constraintTop_toBottomOf="@+id/iv_nearby_user_profile"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#14cd64"
            android:ellipsize="end"
            android:id="@+id/iv_nearby_desc_polish"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ta刚刚擦亮了主页，我也去擦亮&gt;"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="@+id/iv_nearby_user_profile"
            app:layout_constraintTop_toBottomOf="@+id/iv_nearby_user_profile"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#f80c61"
            android:ellipsize="end"
            android:id="@+id/iv_nearby_amulet_desc"
            android:tag="binding_13"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawableRight="@drawable/ic_amulet_find_guide_arrow"
            android:drawablePadding="2dp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_nearby_user_profile"
            app:layout_constraintTop_toBottomOf="@+id/iv_nearby_user_profile"/>
        <FrameLayout
            android:id="@+id/hs_nearby_feed_list"
            android:tag="binding_14"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="@+id/tv_nearby_user_desc"
            app:layout_constraintTop_toBottomOf="@+id/iv_nearby_user_profile">
            <com.zenmen.square.ui.widget.NearByFeedContainer
                android:orientation="horizontal"
                android:id="@+id/ll_feed_pic_container"
                android:tag="binding_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/blur_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
