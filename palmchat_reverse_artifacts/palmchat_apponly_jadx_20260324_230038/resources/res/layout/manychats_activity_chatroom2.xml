<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/userlist_txt"
        android:layout_width="302dp"
        android:layout_height="151dp"
        android:layout_marginTop="36dp"
        android:text="TextView"
        android:layout_marginStart="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/currUser_txt"/>
    <TextView
        android:id="@+id/currUser_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="当前用户:"
        android:layout_marginStart="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/refuse_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:text="挂断"
        android:layout_marginStart="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userlist_txt"/>
    <Button
        android:id="@+id/accept_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:text="接听"
        android:layout_marginStart="80dp"
        app:layout_constraintStart_toEndOf="@+id/refuse_btn"
        app:layout_constraintTop_toBottomOf="@+id/userlist_txt"/>
</androidx.constraintlayout.widget.ConstraintLayout>
