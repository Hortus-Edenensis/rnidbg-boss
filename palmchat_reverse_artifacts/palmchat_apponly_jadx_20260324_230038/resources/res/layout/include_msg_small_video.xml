<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_smallvideo_field"
        android:background="@drawable/background_smallvideo"
        android:clickable="true"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="5dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="2dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/wine_head"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_default_link"
                android:scaleType="centerCrop"
                android:layout_alignParentRight="true"
                app:esv_shape="circle"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_color_202020"
                android:ellipsize="end"
                android:id="@+id/wine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="asdfasdf"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/text_color_202020"
            android:ellipsize="end"
            android:id="@+id/wine_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="4dp"
            android:text="titletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitle"
            android:maxLines="1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="126.5dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/smallvideo_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/test_avatar"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/video_play"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="#e5e5e5"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="6dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp">
            <ImageView
                android:id="@+id/source_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_default_link"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="7dp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/source_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="视频号"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
