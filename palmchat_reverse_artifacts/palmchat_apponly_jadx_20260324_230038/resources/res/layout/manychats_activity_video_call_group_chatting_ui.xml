<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/rootFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/group_chatting_head_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_chatting_head_scroll_layout"
                android:layout_width="match_parent"
                android:layout_height="500dp">
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/group_chatting_item_control_container"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/group_chatting_recyclerview_bob"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/group_chatting_item_control_container_bob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.zenmen.media.common.NiceImageView
                    android:id="@+id/group_chatting_bob_calling_alice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/default_portrait"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/group_chatting_invite_btn_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/manychats_small_screen"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/manychats_small_screen"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textColor="@android:color/white"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/manychats_meeting_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="meeting no"
                        android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/group_chatting_invite_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:src="@drawable/manychats_icon_add"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/group_chatting_secret_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/group_chatting_invite_describe_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@android:color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/group_chatting_invite_describe_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="uid"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@android:color/darker_gray"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="邀请你进行语音通话"/>
        </LinearLayout>
        <com.zenmen.media.common.WaitingTextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/manychats_globle_toast"
            android:background="@drawable/shape_video_toast_view"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text=""/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/video_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/group_chatting_duration_text"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manychats_waiting_accept_call"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/group_chatting_mute_btn_container"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/group_chatting_mute_btn"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_voip_voice_ban_normal_3x"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/group_chatting_mute_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/manychats_video_call_mute"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/group_chatting_handsfree_btn_container"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/group_chatting_handsfree_btn"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_voip_speaker_normal_3x"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/group_chatting_handsfree_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/manychats_voice_hands_off_open"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/group_chatting_open_camera_btn_container"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/group_chatting_open_camera_btn"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_voip_video_tape_normal_3x"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@android:color/white"
                    android:id="@+id/group_chatting_open_camera_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/manychats_video_open"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/group_chatting_camera_swap"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginRight="52dp"
                    android:src="@drawable/manychats_selector_video_call_switch_camera"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/group_chatting_hangup_btn_container"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/group_chatting_hangup_btn"
                        android:clickable="true"
                        android:layout_width="@dimen/manychats_video_call_button_size"
                        android:layout_height="@dimen/manychats_video_call_button_size"
                        android:src="@drawable/manychats_selector_video_call_hangup"/>
                    <TextView
                        android:textSize="@dimen/text_size_tiny"
                        android:textColor="@android:color/white"
                        android:id="@+id/group_chatting_hangup_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/manychats_video_call_hangup"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/group_chatting_accept_btn_container"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/group_chatting_accept_btn"
                        android:clickable="true"
                        android:layout_width="@dimen/manychats_video_call_button_size"
                        android:layout_height="@dimen/manychats_video_call_button_size"
                        android:src="@drawable/manychats_selector_video_call_accept"/>
                    <TextView
                        android:textSize="@dimen/text_size_tiny"
                        android:textColor="@android:color/white"
                        android:id="@+id/group_chatting_accept_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/manychats_video_call_accept"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <com.zenmen.media.common.WaitingTextView
        android:textColor="@android:color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/group_chatting_join_ing"
        android:background="#aa000000"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/manychats_join_ing"
        android:maxEms="15"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
</FrameLayout>
