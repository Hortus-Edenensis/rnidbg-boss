<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:background="@drawable/shape_gift_quick_send_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="5dp">
    <TextView
        android:textSize="10dp"
        android:textColor="#9f6100"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="免费礼物"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/contentLayout"
        android:background="@drawable/shape_gift_quick_send_bg_inner2"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="1dp">
        <ImageView
            android:id="@+id/icon"
            android:padding="4dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chat_input_header_panel_gift"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="4dp">
            <TextView
                android:textSize="10dp"
                android:textColor="#666666"
                android:id="@+id/giftName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="免费礼物"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <ImageView
                    android:id="@+id/giftPriceIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/ic_lianxindou_10"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#666666"
                    android:id="@+id/giftPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="免费免费免费免费免费"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
