<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/square_item_video_field"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:layout_gravity="center"
        android:id="@+id/exo_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="zoom"
        app:surface_type="texture_view"
        app:use_controller="false"/>
    <ImageView
        android:id="@+id/square_video_cover"
        android:background="#eeeeee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.zenmen.palmchat.widget.RoundCornerCoverView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/square_video_play_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_video_play_btn_40"
        android:layout_centerInParent="true"/>
    <ProgressBar
        android:id="@+id/square_video_progress"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        style="@style/VideoLoadingProgressBar"/>
</RelativeLayout>
