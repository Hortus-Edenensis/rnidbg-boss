<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.square.lxpager.SquareViewPager2
        android:id="@+id/square_detail_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zenmen.square.show.ShowListStateView
        android:id="@+id/list_state"
        android:background="@color/black"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/back_arrow"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/iv_back"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="32dp"
            android:layout_height="44dp"
            android:src="@drawable/selector_arrow_white"
            android:layout_centerVertical="true"
            android:onClick="onArrowPress"/>
        <ImageView
            android:id="@+id/iv_more"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_square_show_more"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_publish"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="67dp"
            android:layout_height="44dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_square_show_publish"
            android:layout_toLeftOf="@+id/iv_more"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/small_gift_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/large_gift_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</RelativeLayout>
