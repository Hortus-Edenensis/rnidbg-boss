<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_white_corner_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="30dp">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/square_publish_back_tips_image"
        android:layout_width="139dp"
        android:layout_height="133dp"
        android:layout_marginTop="15dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="确定放弃发布吗？"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#aaaaaa"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="返回后，当前内容将被清除"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="25dp">
        <TextView
            android:textSize="16dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/shape_stroke_gray_corner_24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="115dp"
            android:layout_height="wrap_content"
            android:text="放弃"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/selector_btn_green"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="115dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:text="留下"/>
    </LinearLayout>
</LinearLayout>
