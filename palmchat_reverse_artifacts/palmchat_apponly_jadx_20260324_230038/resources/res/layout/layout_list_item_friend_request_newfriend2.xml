<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/msg_friend_all_layout"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/background"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginLeft="8dp">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:layout_gravity="center_vertical"
                android:id="@+id/portrait"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                app:esv_shape="round_rectangle"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/red_dot"
                android:background="@drawable/shape_red_dot_message"
                android:visibility="visible"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="4dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1">
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="13dp"
                app:alignItems="center"
                app:flexDirection="row"
                app:flexWrap="nowrap"
                app:justifyContent="flex_start">
                <TextView
                    android:textSize="16dp"
                    android:ellipsize="end"
                    android:id="@+id/friend_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="名称ddddddddddddddddddddddddddddddddddddddddddd"
                    android:lines="1"
                    android:singleLine="true"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="1"
                    style="@style/text_normal_content"/>
                <ImageView
                    android:id="@+id/iv_feed_sex"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/icon_sex_female"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="0"/>
                <TextView
                    android:id="@+id/tv_official"
                    android:visibility="gone"
                    android:layout_marginLeft="6dp"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="0"
                    style="@style/official_text_tag"/>
                <ImageView
                    android:id="@+id/iv_vip"
                    android:visibility="visible"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/vip_icon_normal_small"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="0"/>
            </com.google.android.flexbox.FlexboxLayout>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/friend_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="30岁 上海 商业服务"
                android:singleLine="true"
                style="@style/text_middle_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#999"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/friend_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="你好，加个好友吧"
                android:singleLine="true"
                style="@style/text_middle_content"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp">
            <com.zenmen.listui.widget.LeftDrawableText
                android:textSize="12dp"
                android:textColor="@color/Aa"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_say_hi_ai"
                android:background="@drawable/bg_text_green_26"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="@string/square_default_chat_user"
                android:drawableLeft="@drawable/icon_say_hi_left"
                android:drawablePadding="3dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/profile_uid_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/text_color_btn_new_friend_btn"
                    android:gravity="center"
                    android:id="@+id/profile_button"
                    android:background="@drawable/selector_btn_new_friend_bg"
                    android:layout_width="54dp"
                    android:layout_height="26dp"
                    android:layout_marginRight="10dp"
                    android:text="资料"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/Gh"
                    android:gravity="center"
                    android:id="@+id/confirm_button"
                    android:background="@drawable/selector_small_button_green"
                    android:layout_width="54dp"
                    android:layout_height="26dp"
                    android:text="聊聊"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <com.zenmen.palmchat.conversations.threadsnew.newfriend.ImageListsView
        android:orientation="horizontal"
        android:id="@+id/image_list"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="85dp"
        android:layout_marginBottom="8dp"/>
</LinearLayout>
