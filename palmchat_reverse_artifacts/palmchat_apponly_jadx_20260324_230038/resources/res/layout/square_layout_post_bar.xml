<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/Ca"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="16dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/img_picture"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_details_pic"
                android:scaleType="centerCrop"
                app:esv_shape="round_rectangle"
                app:radius_x_dp="4dp"
                app:radius_y_dp="4dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/img_shadow"
                android:background="@drawable/bg_square_public_progress_shadow"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_square_post_bar_refresh"
                android:scaleType="centerInside"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/C1"
            android:textColor="@color/Gb"
            android:id="@+id/tv_status"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/square_post_bar_uploading"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/C1"
            android:textColor="@color/Ga"
            android:id="@+id/tv_percent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="0%"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/C1"
            android:id="@+id/btn_retry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="4dp"
            android:text="@string/square_post_bar_retry"
            style="@style/small_button_green"/>
        <ImageView
            android:id="@+id/img_close"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_square_post_bar_close"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/pb_progress"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_square_post_bar_progress_line"
        android:layout_alignParentBottom="true"
        style="?android:attr/progressBarStyleHorizontal"/>
</RelativeLayout>
