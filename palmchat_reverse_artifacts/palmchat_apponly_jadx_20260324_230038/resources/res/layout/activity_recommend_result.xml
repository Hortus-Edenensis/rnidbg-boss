<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_chat"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_send_successful"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/color_text_bcbcbc"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/recommend_friend_send_succeed_tips"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="20dp"
        android:textColor="#ffb91f"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/recommend_friend_send_succeed_tips2"
        android:includeFontPadding="false"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="191dp"
        android:layout_height="142dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/ic_addfriends_pic"
        android:scaleType="centerInside"/>
    <TextView
        android:id="@+id/btn_enter_nearby"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="46dp"
        android:text="@string/recommend_friend_btn_nearby"
        style="@style/btn_green_solid"/>
</LinearLayout>
