<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp">
        <TextView
            android:textSize="@dimen/B3"
            android:textColor="@color/Gd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="期待你的加入"/>
        <TextView
            android:textSize="@dimen/B1"
            android:textStyle="bold"
            android:textColor="@color/Gb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="附近的人-有趣的灵魂近在身边"/>
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="top|right"
            android:id="@+id/img_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_auth_login_back_guide"
            android:scaleType="centerCrop"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="16dp"
            app:radius_y_dp="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <TextView
                android:textSize="@dimen/text_size_normal"
                android:textStyle="bold"
                android:textColor="@color/Gc"
                android:gravity="center"
                android:id="@+id/btn_quit"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="拒绝"
                android:layout_weight="1"
                style="@style/big_button_gray"/>
            <TextView
                android:textSize="@dimen/text_size_normal"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_continue"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="25dp"
                android:text="继续"
                android:layout_weight="1"
                style="@style/big_button_green"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
