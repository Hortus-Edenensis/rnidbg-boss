<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/account_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/portrait"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp">
                <TextView
                    android:textSize="@dimen/B2"
                    android:textColor="@color/Gb"
                    android:id="@+id/nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/C1"
                    android:textColor="@color/Gd"
                    android:id="@+id/account"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:singleLine="false"/>
            </LinearLayout>
        </LinearLayout>
        <com.zenmen.palmchat.widget.ClearEditText
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_color_black"
            android:id="@+id/edit_text"
            android:background="@drawable/selector_edit_text_underline_green"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="1dp"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="50dp"
            android:singleLine="true"
            android:maxLength="50"
            android:textCursorDrawable="@null"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gd"
            android:id="@+id/tips"
            android:paddingLeft="5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="false"/>
        <RelativeLayout
            android:layout_gravity="bottom"
            android:id="@+id/contentLayout"
            android:background="@drawable/shape_light_green_underline"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="#aaa"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="1dp"
                android:text="30"
                android:layout_alignBottom="@+id/edit_text_sign"
                android:layout_alignParentRight="true"/>
            <EditText
                android:textSize="@dimen/B2"
                android:textColor="@color/Gb"
                android:id="@+id/edit_text_sign"
                android:background="@null"
                android:paddingLeft="8dp"
                android:paddingRight="1dp"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_toLeftOf="@+id/count"
                android:textCursorDrawable="@null"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
