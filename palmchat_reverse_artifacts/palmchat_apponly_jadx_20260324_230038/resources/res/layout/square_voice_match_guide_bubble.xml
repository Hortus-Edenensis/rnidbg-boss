<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/square_voice_match_guide_bubble_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/content_layout"
        android:background="@drawable/shape_voice_match_guide_bg"
        android:padding="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.zenmen.palmchat.widget.lxviewswitcher.CustomLoopingViewSwitcher
            android:id="@+id/head_layout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/des_layout"
            android:paddingLeft="6dp"
            android:paddingRight="16dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/head_layout"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语音速配"
                android:singleLine="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#fff"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3人在等待"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/reddot"
        android:background="@drawable/shape_voice_match_guide_unread"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="36dp"
        android:text="3"/>
</FrameLayout>
