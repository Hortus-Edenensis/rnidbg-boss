<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.widget.photoview.PhotoView
        android:id="@+id/photoview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zenmen.palmchat.widget.byakugallery.TouchImageView
        android:id="@+id/photoview_big"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/mask"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"/>
    <ProgressBar
        android:id="@+id/prsbar"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:layout_centerInParent="true"
        style="@style/LocationLoadingProgressBar"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/expiredLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pic_expired"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#888"
            android:paddingTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_load_fail_404"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/file_type_gif"
        android:background="#dd222222"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="58dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="left"
        android:id="@+id/photo_mask_text"
        android:background="@drawable/bg_album_blur"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
