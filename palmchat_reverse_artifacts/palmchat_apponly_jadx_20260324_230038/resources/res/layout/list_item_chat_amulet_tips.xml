<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:visibility="gone"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/gift_layout"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_centerInParent="true">
                <RelativeLayout
                    android:background="@drawable/ic_chat_amulet_guide_bg"
                    android:layout_width="match_parent"
                    android:layout_height="83dp"
                    android:layout_marginLeft="54dp"
                    android:layout_centerVertical="true">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="54dp"
                        android:layout_toLeftOf="@+id/guide_btn"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="#5e0028"
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="这么喜欢TA？"
                            android:singleLine="true"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#5e0028"
                            android:id="@+id/content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="送TA独一无二挂件"
                            android:singleLine="true"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#fff"
                        android:gravity="center"
                        android:id="@+id/guide_btn"
                        android:background="@drawable/ic_chat_amulet_guide_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="赠送"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <com.zenmen.palmchat.widget.LXPortraitView
                    android:id="@+id/amuletHead"
                    android:visibility="visible"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:src="@drawable/ic_chat_amulet_guide_head"
                    android:scaleType="centerCrop"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
