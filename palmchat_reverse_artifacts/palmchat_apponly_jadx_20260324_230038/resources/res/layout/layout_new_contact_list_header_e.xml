<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/recommendation_item"
        android:background="@drawable/shape_f5f5f5_bg_radius_14"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp">
        <com.zenmen.palmchat.widget.SocialPortraitView
            android:id="@+id/portrait_imageview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="14dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/confirm_button"
            android:layout_toRightOf="@+id/portrait_imageview"
            android:layout_centerVertical="true">
            <TextView
                android:ellipsize="end"
                android:id="@+id/recommendation_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KaKa"
                android:singleLine="true"
                style="@style/text_normal_content"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/phone_describe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="describe"
                android:singleLine="true"
                style="@style/text_middle_content"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/confirm_button"
            android:background="@drawable/selector_btn_green_invite"
            android:visibility="visible"
            android:layout_width="55dp"
            android:layout_height="27dp"
            android:layout_marginRight="14dp"
            android:text="@string/contact_add_friend"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/new_contact_apply_area"
        android:background="@drawable/new_contact_area_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/contact_ic_chat_d"
            android:scaleType="centerCrop"/>
        <TextView
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="新的朋友"
            android:layout_toRightOf="@+id/iv_avatar"
            android:layout_centerVertical="true"
            style="@style/text_normal_content"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/notification_red_dot"
            android:background="@drawable/red_circle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/unread_dot_text_bg_size"
            android:minWidth="@dimen/unread_dot_text_bg_size"
            android:text="1"
            android:layout_toRightOf="@+id/tv_text"
            android:layout_centerVertical="true"
            style="@style/main_tab_unread_text"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/enhanced_contact_area"
        android:background="@drawable/new_contact_area_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/icon_menu_maybe_circle"
                android:scaleType="centerCrop"/>
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_item_may_known"
                style="@style/text_normal_content"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/enhanced_contact_new"
                android:background="@drawable/red_circle"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/unread_dot_text_bg_size"
                android:layout_marginLeft="10dp"
                android:minWidth="@dimen/unread_dot_text_bg_size"
                android:text="1"
                style="@style/main_tab_unread_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_online"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="20dp"
            android:layout_toRightOf="@+id/ll_content"
            android:layout_centerVertical="true">
            <com.zenmen.palmchat.widget.SocialPortraitView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_online"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_online_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上线了"
                android:singleLine="true"
                style="@style/text_small_content_Gc_C1"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_phone_contact"
        android:background="@drawable/new_contact_area_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/icon_menu_add2_circle"
                android:scaleType="centerCrop"/>
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机联系人"
                style="@style/text_normal_content"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/group_chat_area"
        android:background="@drawable/new_contact_area_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/contact_ic_chat_e"
                android:scaleType="centerCrop"/>
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_chat_item_title"
                style="@style/text_normal_content"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
