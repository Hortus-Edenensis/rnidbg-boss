<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/icon_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iconIv"
            android:visibility="gone"
            android:layout_width="54dp"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/videosdk_add"
            android:scaleType="fitCenter"/>
        <ImageView
            android:id="@+id/tab_icon"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/tabbar_icon_default"
            android:scaleType="centerCrop"/>
    </RelativeLayout>
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/dynamic_icon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="fitCenter"
        android:layout_centerInParent="true"
        app:esv_shape="circle"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/Ga"
        android:id="@+id/tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="消息"
        android:singleLine="true"
        android:layout_below="@+id/icon_layout"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/noticeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginRight="-12dp"
        android:layout_alignTop="@+id/icon_layout"
        android:layout_alignRight="@+id/icon_layout">
        <View
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/red_dot0"
            android:background="@drawable/red_circle"
            android:visibility="invisible"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="10dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/Ab"
            android:gravity="center"
            android:id="@+id/red_text0"
            android:background="@drawable/red_circle"
            android:paddingBottom="0.5dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:minWidth="18dp"
            android:text="99+"/>
    </FrameLayout>
</merge>
