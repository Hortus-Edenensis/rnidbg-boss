<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/square_interact_header_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/super_expose_v2_message_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#222222"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="12dp"
                    android:text="被曝光数"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp">
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#ff222222"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/num1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0w"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ff999999"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="较上周"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/image1"
                        android:layout_width="6dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="4dp"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/label1"
                        android:background="#222222"
                        android:layout_width="10dp"
                        android:layout_height="1.4dp"
                        android:layout_marginLeft="4dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ff999999"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/text1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/super_expose_v2_message_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#222222"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="12dp"
                    android:text="被点赞数"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp">
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#ff222222"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/num2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ff999999"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="较上周"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/image2"
                        android:layout_width="6dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="4dp"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/label2"
                        android:background="#222222"
                        android:layout_width="10dp"
                        android:layout_height="1.4dp"
                        android:layout_marginLeft="4dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ff999999"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/text2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/super_expose_v2_message_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#222222"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="12dp"
                    android:text="被评论数"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp">
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#ff222222"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/num3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0w"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ff999999"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="较上周"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/image3"
                        android:layout_width="6dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="4dp"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/label3"
                        android:background="#222222"
                        android:layout_width="10dp"
                        android:layout_height="1.4dp"
                        android:layout_marginLeft="4dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#ff999999"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/text3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="16dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#ff999999"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/btn"
                android:background="@drawable/super_expose_v2_btn_bg"
                android:layout_width="wrap_content"
                android:layout_height="32dp">
                <com.zenmen.palmchat.widget.MSVGAImageView
                    android:id="@+id/hot_svga"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="2dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#ff222222"
                    android:id="@+id/btn_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text="立即曝光"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
