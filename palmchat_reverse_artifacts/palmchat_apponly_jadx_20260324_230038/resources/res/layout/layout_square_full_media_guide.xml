<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#66000000"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/guide_eara"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/guide_vertical_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/square_updown_guide_arrow"/>
            <ImageView
                android:id="@+id/guide_vertical_hand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/square_updown_guide_hand"/>
            <ImageView
                android:id="@+id/guide_horizontal_arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/moments_right_guide_arrow"/>
            <ImageView
                android:id="@+id/guide_horizontal_hand"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/moments_right_guide_hand"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/B3"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/guide_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="上滑查看下个动态"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/B3"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/guide_btn"
        android:background="@drawable/bg_square_btn_transparant_20"
        android:layout_width="103dp"
        android:layout_height="32dp"
        android:layout_marginTop="15dp"
        android:text="知道了"/>
</LinearLayout>
