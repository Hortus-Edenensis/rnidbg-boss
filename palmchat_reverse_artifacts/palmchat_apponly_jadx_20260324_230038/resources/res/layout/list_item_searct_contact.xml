<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/cat_divider"
        android:background="@color/cate_bg_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <RelativeLayout
        android:id="@+id/categoryContainer"
        android:background="#fff"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:id="@+id/category"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="联系人"
            android:layout_alignParentBottom="true"
            style="@style/text_middle_B3_content"/>
        <View
            android:background="#dbdbdb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="#fff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/selector_settings_item_background"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <com.zenmen.palmchat.widget.SocialPortraitView
                android:layout_gravity="center_vertical"
                android:id="@+id/portrait"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="测试一个很长的名字"
                    android:singleLine="true"
                    style="@style/text_normal_content"/>
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="测试一个很长的名字"
                    android:singleLine="true"
                    style="@style/text_middle_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/more_container"
            android:background="@drawable/selector_settings_item_background"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#dbdbdb"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#1d2422"
                android:gravity="center_vertical"
                android:id="@+id/more_text"
                android:paddingLeft="8dp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:drawableRight="@drawable/icon_arrow_net_status_tips"
                android:drawablePadding="5dp"/>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:background="#dbdbdb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</LinearLayout>
