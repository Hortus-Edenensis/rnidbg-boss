<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_call_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/video_call_icon_loading_fail_bg"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/float_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/video_call_swap_screen_normal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/audio_headimage_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="144dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/audio_portrait"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/A2"
            android:textStyle="bold"
            android:textColor="@color/Ab"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/audio_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="dadsfasdfasdfasdffa"
            android:singleLine="true"
            android:shadowColor="@color/black"
            android:shadowRadius="2"/>
        <TextView
            android:textSize="@dimen/B2"
            android:textColor="@color/Ab"
            android:layout_gravity="center_horizontal"
            android:id="@+id/calling_hint_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="dadsfasdfasdfasdffa"
            android:shadowColor="@color/black"
            android:shadowRadius="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/silence_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/silence_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_re_voip_silence"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@android:color/white"
                android:id="@+id/silence_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="静音"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/hangup_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/hangup_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_re_voip_hangup"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@android:color/white"
                android:id="@+id/hangup_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="拒绝"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/speaker_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/speaker_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_re_voip_speaker"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@android:color/white"
                android:id="@+id/speaker_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="免提"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/accept_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/accept_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_re_voip_accept"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@android:color/white"
                android:id="@+id/accept_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="接听"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/white"
        android:id="@+id/call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="174dp"
        android:shadowColor="@color/black"
        android:shadowRadius="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
