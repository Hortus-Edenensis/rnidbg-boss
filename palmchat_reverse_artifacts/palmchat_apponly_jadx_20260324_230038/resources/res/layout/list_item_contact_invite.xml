<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0px"/>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/cate_text_color"
            android:gravity="center_vertical"
            android:id="@+id/group_indicator"
            android:background="@color/cate_bg_color"
            android:paddingLeft="12dp"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:text="A"/>
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="51dp">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_check"
            android:background="@drawable/selector_btn_green_checkbox"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginLeft="12dp"/>
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:layout_gravity="center_vertical"
            android:id="@+id/portrait"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/text_color_black"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="测试一个很长的名字"
                android:singleLine="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/text_color_black"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/color_divider_contact"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="1px"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="1px"/>
</LinearLayout>
