<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row_rec_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/portrait">
                <include
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    layout="@layout/include_item_chat_name_layout"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp">
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/audioContainer"
                            android:background="@drawable/selector_message_left_audio_item_background_bubble"
                            android:clickable="true"
                            android:layout_width="220dp"
                            android:layout_height="52dp">
                            <RelativeLayout
                                android:id="@+id/audioControlLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true">
                                <ImageView
                                    android:id="@+id/play_icon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_audio_bg_play_normal_new_right"
                                    android:layout_centerVertical="true"/>
                                <com.zenmen.palmchat.widget.NoneClickableSeekBar
                                    android:id="@+id/play_seek_bar"
                                    android:paddingLeft="8dp"
                                    android:paddingRight="8dp"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/audio_seekbar_style_left"
                                    android:thumb="@drawable/ic_audio_seekbar_thumb_normal_new"
                                    android:thumbOffset="7dp"
                                    android:layout_toLeftOf="@+id/play_length"
                                    android:layout_toRightOf="@+id/play_icon"
                                    android:layout_centerVertical="true"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:splitTrack="false"
                                    android:thumbTintMode="multiply"/>
                                <TextView
                                    android:textSize="13dp"
                                    android:textColor="@color/Gb"
                                    android:id="@+id/play_length"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="4dp"
                                    android:text="0:02"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <ImageView
                                android:gravity="left"
                                android:id="@+id/audio"
                                android:visibility="visible"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:scaleType="center"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="17dp"
                                android:textColor="#222222"
                                android:id="@+id/audio_during"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:layout_toLeftOf="@+id/audio_during_label"
                                android:layout_alignBaseline="@+id/audio_during_label"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:textColor="#222222"
                                android:id="@+id/audio_during_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="@string/audio_during_second"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:translationY="-4dp"/>
                        </RelativeLayout>
                        <View
                            android:id="@+id/audio_read"
                            android:background="@drawable/red_circle"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginLeft="2dp"
                            android:layout_toRightOf="@+id/audioContainer"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/audio_attach_download_fail"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/status_fail"
                            android:layout_toRightOf="@+id/audioContainer"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/status_pending"
                            android:visibility="gone"
                            android:layout_marginLeft="5dp"
                            android:src="@drawable/custom_progress_icon"
                            android:layout_toRightOf="@+id/audioContainer"
                            android:layout_centerInParent="true"
                            style="@style/ChatListProgressIndicator"/>
                    </RelativeLayout>
                    <FrameLayout
                        android:id="@+id/ai_audio_lock_layout"
                        android:visibility="gone"
                        android:layout_width="250dp"
                        android:layout_height="60dp"/>
                </FrameLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
