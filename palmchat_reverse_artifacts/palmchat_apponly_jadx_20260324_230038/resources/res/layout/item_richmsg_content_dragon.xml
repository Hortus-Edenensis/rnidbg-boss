<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/circle_dragon_inchatter"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#9b9b9b"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="群接龙"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_color_black"
            android:ellipsize="end"
            android:id="@+id/dragon_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/richmsg_width"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#9b9b9b"
            android:id="@+id/dragon_publisher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#9b9b9b"
            android:id="@+id/dragon_publish_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:background="#f1f1f1"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="5dp"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_color_black"
            android:id="@+id/dragon_join_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#9b9b9b"
            android:id="@+id/dragon_end_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="结束时间"/>
        <View
            android:id="@+id/line_divider_bottom"
            android:background="#f1f1f1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="5dp"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="#008578"
            android:gravity="center"
            android:id="@+id/dragon_join"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:text="去接龙"/>
    </LinearLayout>
</LinearLayout>
