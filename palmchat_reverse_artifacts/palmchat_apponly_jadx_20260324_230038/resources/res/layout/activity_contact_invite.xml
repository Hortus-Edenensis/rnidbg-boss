<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/back_arrow"
            android:padding="10dp"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/selector_arrow_back"
            android:scaleType="fitCenter"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="50dp"
            android:text="通讯录好友"
            android:singleLine="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_contact_invite_search_view"
        android:padding="2dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="58dp"
        android:layout_marginRight="10dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon_search"
            android:background="@drawable/ic_search_contact_invite"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="7dp"/>
        <EditText
            android:textSize="13dp"
            android:textColor="@color/text_color_black"
            android:textColorHint="#c5c5c5"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_edit_text"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:hint="@string/string_search"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"
            android:textCursorDrawable="@null"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/contacts_list_area"
        android:background="@color/color_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="56dp">
        <ListView
            android:gravity="top"
            android:id="@+id/contacts_list"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:stackFromBottom="false"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000"
            android:divider="#00000000"
            android:dividerHeight="0dp"/>
        <TextView
            android:textSize="@dimen/text_size_48"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/char_indicator"
            android:background="@drawable/shape_gray_rectangle_round_corner"
            android:visibility="gone"
            android:layout_width="79dp"
            android:layout_height="79dp"
            android:text="A"/>
        <com.zenmen.palmchat.widget.CharIndexView
            android:layout_gravity="right"
            android:id="@+id/index_view"
            android:layout_width="24dp"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <View
            android:background="#e7dec6"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_toLeftOf="@+id/btn_send"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="12dp"
                android:textColor="#666666"
                android:id="@+id/tv_send_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已选择0/0"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#eb4a50"
                android:ellipsize="end"
                android:id="@+id/tv_send_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="所有短信都将以免费短信形式发出"
                android:singleLine="true"
                android:layout_below="@+id/tv_send_num"/>
        </LinearLayout>
        <TextView
            android:enabled="false"
            android:textSize="17dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/btn_send"
            android:background="@drawable/selector_contact_invite_btn"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:text="短信邀请"
            android:singleLine="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</FrameLayout>
