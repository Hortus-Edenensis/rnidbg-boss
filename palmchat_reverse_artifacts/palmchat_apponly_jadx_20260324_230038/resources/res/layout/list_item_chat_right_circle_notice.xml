<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/realcontentLayout"
                android:background="@drawable/selector_circle_msg_item_background_right"
                android:paddingLeft="9dp"
                android:paddingTop="9dp"
                android:paddingRight="9dp"
                android:layout_width="@dimen/list_item_text_width"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/chat_item_portrait_margin_left_or_right"
                android:layout_toLeftOf="@+id/portrait">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#9b9b9b"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@+id/notice_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="群公告"
                    android:drawableLeft="@drawable/circle_note_msg_icon"
                    android:drawablePadding="6dp"/>
                <View
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"/>
                <TextView
                    android:textSize="@dimen/dimen_16"
                    android:textColor="@color/text_color_send"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@+id/notice_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="titletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitle"/>
                <ImageView
                    android:id="@+id/notice_image"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginBottom="6dp"
                    android:scaleType="centerCrop"/>
                <View
                    android:background="#f1f1f1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="3dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#566b94"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/notice_action"
                    android:padding="9dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="titletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitle"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/realcontentLayout"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
