<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_portrait"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/user_render_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/waiting"
        android:background="#40000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/roomchat_member_waiting"
        android:scaleType="center"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/speaking"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/roomchat_member_speaking"
        android:scaleType="center"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|right"
        android:orientation="horizontal"
        android:id="@+id/user_extra_info_layout"
        android:background="@drawable/room_user_name_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_margin="8dp">
        <ImageView
            android:id="@+id/user_render_mic"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/microphone_enable_icon"/>
    </LinearLayout>
</FrameLayout>
