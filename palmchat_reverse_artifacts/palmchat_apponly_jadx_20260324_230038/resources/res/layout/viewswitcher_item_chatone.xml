<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/avatar"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/default_portrait"
                android:scaleType="fitXY"
                app:esv_shape="circle"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#fff"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/chat_item_chatone_tag_bg"
                android:layout_width="46dp"
                android:layout_height="19dp"
                android:text="聊一个"
                android:singleLine="true"
                android:textAlignment="center"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/B2"
                        android:textColor="@color/Gb"
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标题"
                        android:lines="1"
                        app:layout_flexShrink="1"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/message_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="40dp"
                        android:layout_below="@+id/title">
                        <TextView
                            android:textSize="@dimen/B4"
                            android:textColor="#ff463c"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/additionMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dimen_5"
                            android:text="[新]"
                            android:maxEms="12"
                            android:singleLine="true"
                            android:layout_marginEnd="@dimen/dimen_5"/>
                        <TextView
                            android:id="@+id/message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="消息"
                            style="@style/thread_item_sub_title"/>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
