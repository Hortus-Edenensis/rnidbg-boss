<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_filter_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.zenmen.listui.widget.LeftDrawableText
                android:id="@+id/btn_all"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/btn_nearby_filter_all"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.zenmen.listui.widget.LeftDrawableText
                android:id="@+id/btn_male"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/btn_nearby_filter_male"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.zenmen.listui.widget.LeftDrawableText
                android:id="@+id/btn_female"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:drawablePadding="5dp"
                style="@style/btn_nearby_filter_female"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/Gb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/square_title_nearby_filter_dialog"
        android:layout_above="@+id/ll_filter_btn_container"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_filter_dialog_close"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:layout_width="28dp"
        android:layout_height="24dp"
        android:layout_marginRight="2dp"
        android:src="@drawable/icon_dialog_close"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
