<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#b4000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/trip_map_release_time_layout_bg"
        android:layout_width="320dp"
        android:layout_height="287dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="选择到达时间"
                android:includeFontPadding="false"/>
            <RelativeLayout
                android:id="@+id/trip_time_picker_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp">
                <View
                    android:background="@drawable/shape_f5f5f5_radius_24"
                    android:layout_width="240dp"
                    android:layout_height="48dp"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/time_picker_view"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.picker.wheel.WheelPicker
                        android:id="@+id/wv_time_day"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:wheel_atmospheric="true"
                        app:wheel_curved="true"
                        app:wheel_cyclic="false"
                        app:wheel_focus_item_half_height="24dp"
                        app:wheel_item_space="22dp"
                        app:wheel_item_text_color="#99222222"
                        app:wheel_item_text_size="@dimen/B2"
                        app:wheel_selected_item_text_color="#222222"
                        app:wheel_selected_item_text_size="@dimen/B2"/>
                    <com.zenmen.palmchat.widget.picker.wheel.WheelPicker
                        android:id="@+id/wv_time_hour"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:wheel_atmospheric="true"
                        app:wheel_curved="true"
                        app:wheel_cyclic="false"
                        app:wheel_focus_item_half_height="24dp"
                        app:wheel_item_space="22dp"
                        app:wheel_item_text_color="#99222222"
                        app:wheel_item_text_size="@dimen/B2"
                        app:wheel_selected_item_text_color="#222222"
                        app:wheel_selected_item_text_size="@dimen/B2"/>
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/trip_map_release_info_button"
                android:background="@drawable/trip_map_release_info_button_bg"
                android:layout_width="280dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:text="确认"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/trip_release_info_time_close"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/trip_map_release_time_close_bg"/>
    </FrameLayout>
</FrameLayout>
