<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_top_30_corner_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_circle_remove_member"
        android:background="@drawable/selector_top_30_round_corner"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/Ba"
            android:id="@+id/tv_remove_member"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除成员"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_circle_remove_and_black_user"
        android:background="@drawable/selector_settings_item_background"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/Ba"
            android:id="@+id/tv_circle_remove_and_black_user"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除成员并禁止加群"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_circle_cancel"
        android:background="@drawable/selector_settings_item_background"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/feed_dp_13">
        <TextView
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            style="@style/settings_main_text_black"/>
    </LinearLayout>
</LinearLayout>
