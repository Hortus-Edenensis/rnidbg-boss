<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/frame_generic_vip_entrance_content_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="23dp"
        android:paddingTop="33dp"
        android:paddingRight="23dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="156dp"
            android:layout_height="109dp"
            android:src="@drawable/frame_generic_vip_entrance_content_desc"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#222222"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="超级会员免广告"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#84440c"
            android:gravity="center"
            android:id="@+id/vip_entrance"
            android:background="@drawable/frame_generic_vip_entrance_content_entrance"
            android:paddingLeft="15dp"
            android:paddingTop="12dp"
            android:paddingRight="15dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="立即免广告"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="17dp"
        android:src="@drawable/frame_generic_vip_entrance_content_close"
        android:scaleType="fitCenter"/>
</FrameLayout>
