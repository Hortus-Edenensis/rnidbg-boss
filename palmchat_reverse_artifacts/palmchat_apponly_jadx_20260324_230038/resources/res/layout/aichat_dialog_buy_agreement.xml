<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/B1"
            android:textStyle="bold"
            android:textColor="@color/Gb"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:paddingTop="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请阅读并同意以下条款"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Ga"
            android:layout_gravity="center"
            android:id="@+id/agreement"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="30dp"
            android:maxWidth="300dp"
            android:text="《连信守护服务协议》"
            android:lineSpacingExtra="2dp"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/confirm"
            android:visibility="visible"
            android:layout_width="280dp"
            android:layout_height="48dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/login_privacy_dialog_btn_agree"
            style="@style/btn_green_solid"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="top|right"
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ic_login_agreement_dialog_close"/>
</FrameLayout>
