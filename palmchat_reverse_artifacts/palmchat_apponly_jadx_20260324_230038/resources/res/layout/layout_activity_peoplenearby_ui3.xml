<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/Ab"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_chat"/>
    <RelativeLayout
        android:id="@+id/permission_fail"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/permission_icon"
            android:layout_width="180dp"
            android:layout_height="143dp"
            android:layout_marginTop="56dp"
            android:src="@drawable/image_near_permission"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/permission_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/permission_granted_guide"
            android:layout_below="@+id/permission_icon"
            android:layout_centerHorizontal="true"
            style="@style/text_normal_content"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Gd"
            android:id="@+id/text_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_nearby"
            android:layout_below="@+id/permission_text"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:enabled="true"
            android:gravity="center"
            android:id="@+id/permission_add"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="80dp"
            android:text="@string/permission_add"
            android:layout_below="@+id/text_desc"
            android:layout_centerHorizontal="true"
            style="@style/btn_green_solid"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/location_fail"
        android:background="@color/white"
        android:paddingLeft="42dp"
        android:paddingRight="42dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="108dp"
            android:layout_height="112dp"
            android:layout_marginTop="123dp"
            android:layout_marginBottom="23dp"
            android:src="@drawable/nearby_unable_load"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#afafaf"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/nearby_unable_load"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/get_neearby_fail"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="180dp"
            android:layout_height="143dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="23dp"
            android:src="@drawable/image_near_permission"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Gd"
            android:gravity="center_horizontal"
            android:id="@+id/loc_fail_tv"
            android:paddingLeft="42dp"
            android:paddingRight="42dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nearby_no_one_using"
            android:layout_weight="1"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/more_friends_area"
        android:background="@color/nearby_more_friends"
        android:paddingLeft="17dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/nearby_more_friends_left_ic"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="17dp"
            android:src="@drawable/upload_contact_icon"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Gd"
            android:id="@+id/nearby_more_friends_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_more_friends"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/nearby_more_friends_right_ic"
            android:layout_toRightOf="@+id/nearby_more_friends_left_ic"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/nearby_more_friends_right_ic"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="9dp"
            android:src="@drawable/upload_contact_jiantou"
            android:scaleType="centerCrop"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/nearby_greeting_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="66dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/new_greet_area"
            android:background="@drawable/shape_black_nearby_greet"
            android:paddingLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerInParent="true">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:textSize="@dimen/text_size_normal"
                android:textColor="@color/text_color_gray"
                android:id="@+id/nearby_img"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                app:esv_shape="circle"/>
            <TextView
                android:textSize="@dimen/C1"
                android:textColor="@color/Ga"
                android:id="@+id/peoplenearby_new_greet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_new_greet"
                android:singleLine="true"/>
            <ImageView
                android:id="@+id/peoplenearby_message_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/peoplenearby_message_and"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/car_view"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginLeft="-45dp"
            android:scaleType="fitCenter"
            android:layout_toRightOf="@+id/new_greet_area"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/nearby_map_find_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="66dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/shape_black_nearby_greet"
            android:paddingLeft="12dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/C1"
                android:textColor="@color/Ga"
                android:id="@+id/nearby_map_find_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_new_greet"
                android:singleLine="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/peoplenearby_message_and"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.palmchat.widget.SlideUpLayout
            android:id="@+id/slide_up_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:default_panel="front"
            app:duration="500"
            app:percent="0.3">
            <com.zenmen.palmchat.widget.PinnedSectionListView
                android:id="@+id/peoplenearby_list"
                android:background="@color/color_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@drawable/selector_settings_item_background"
                android:divider="@null"
                android:footerDividersEnabled="false"/>
            <ListView
                android:id="@+id/peoplenearby_bottom_list"
                android:background="@color/color_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@drawable/selector_settings_item_background"
                android:divider="@null"
                android:footerDividersEnabled="false"/>
        </com.zenmen.palmchat.widget.SlideUpLayout>
        <com.zenmen.square.ui.widget.FindMapEntryView
            android:layout_gravity="bottom|right"
            android:id="@+id/rl_find_map_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
