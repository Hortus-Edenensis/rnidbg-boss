<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selector_settings_item_background"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="@dimen/group_item_height">
    <ImageView
        android:id="@+id/cell_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/icon_tab_cell_default"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/cell_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/cell_icon"
        android:layout_centerVertical="true"
        style="@style/text_normal_content"/>
    <TextView
        android:textSize="@dimen/text_size_tiny"
        android:textColor="#999"
        android:ellipsize="end"
        android:id="@+id/cell_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/cell_title"
        android:layout_centerVertical="true"/>
    <com.zenmen.palmchat.widget.TabCellUnReadView
        android:id="@+id/cell_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/cell_subtitle"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/arrowIcon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/list_ic_arrow"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
