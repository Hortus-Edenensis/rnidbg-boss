<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.ad.VisibleDetectView
        android:id="@+id/visible_detect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/ad_root_parent_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:tag="nest_native_ui_root_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.zenmen.palmchat.widget.EffectiveShapeView
                            android:id="@+id/ad_app_icon"
                            android:clickable="true"
                            android:layout_width="42dp"
                            android:layout_height="46dp"
                            android:scaleType="fitXY"
                            app:esv_shape="circle"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="13dp"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#222222"
                                android:id="@+id/ad_app_name"
                                android:clickable="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#999999"
                                android:id="@+id/ad_infor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:singleLine="true"/>
                        </LinearLayout>
                        <include
                            android:id="@+id/vip_entrance"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            layout="@layout/frame_generic_vip_entrance"/>
                        <FrameLayout
                            android:layout_gravity="top"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginTop="2dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/ad_drop"
                                android:background="@drawable/nest_square_generic_list_item_ad_drop_bg"
                                android:paddingLeft="6dp"
                                android:paddingTop="2dp"
                                android:paddingRight="6dp"
                                android:paddingBottom="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="11dp"
                                    android:textColor="#bbbbbb"
                                    android:id="@+id/ad_sign"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <ImageView
                                    android:id="@+id/ad_native_close"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginLeft="3dp"
                                    android:src="@drawable/native_ad_close"
                                    android:scaleType="fitCenter"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="56dp"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/ad_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"/>
                        <FrameLayout
                            android:id="@+id/ad_main_normal"
                            android:layout_width="208dp"
                            android:layout_height="117dp"
                            android:layout_marginTop="8dp">
                            <FrameLayout
                                android:id="@+id/ad_video_wrapper"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <FrameLayout
                                    android:id="@+id/ad_video"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                                <com.zenmen.palmchat.widget.RoundCornerCoverView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </FrameLayout>
                            <com.zenmen.palmchat.widget.EffectiveShapeView
                                android:id="@+id/ad_img"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                app:esv_shape="round_rectangle"
                                app:radius_x_dp="8dp"
                                app:radius_y_dp="8dp"/>
                            <FrameLayout
                                android:id="@+id/interactive_type_all_layout"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <FrameLayout
                                    android:id="@+id/interactive_type_layout"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                                <com.zenmen.palmchat.widget.RoundCornerCoverView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </FrameLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:layout_gravity="bottom"
                                android:orientation="horizontal"
                                android:id="@+id/ad_down_button_layout_normal"
                                android:background="@drawable/nest_square_generic_list_item_ad_main_bg"
                                android:paddingTop="9dp"
                                android:paddingBottom="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/ad_logo_normal"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginLeft="8dp"
                                    android:scaleType="fitCenter"/>
                                <Space
                                    android:id="@+id/ad_normal_space"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:id="@+id/ad_down_yaoyiyao_layout"
                                    android:tag="ad_down_yaoyiyao_layout"
                                    android:background="@drawable/nest_bg_square_btn_ad_down"
                                    android:layout_width="129dp"
                                    android:layout_height="24dp">
                                    <LinearLayout
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/ad_yaoyiyao"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent">
                                        <ImageView
                                            android:id="@+id/yy_shake_bg"
                                            android:background="@drawable/ad_yaoyiyao"
                                            android:layout_width="13dp"
                                            android:layout_height="13dp"
                                            android:layout_marginLeft="5dp"/>
                                        <TextView
                                            android:textSize="12dp"
                                            android:textColor="#ffffff"
                                            android:gravity="center"
                                            android:id="@+id/yy_shake_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="5dp"
                                            android:text="摇一摇或"/>
                                    </LinearLayout>
                                    <FrameLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <FrameLayout
                                            android:layout_gravity="center_horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                                                android:layout_gravity="center_horizontal"
                                                android:id="@+id/app_download_btn"
                                                android:tag="huawei_download_btn"
                                                android:paddingLeft="7dp"
                                                android:paddingTop="3dp"
                                                android:paddingRight="7dp"
                                                android:paddingBottom="3dp"
                                                android:visibility="gone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                app:hiad_fixedWidth="true"
                                                app:hiad_maxWidth="70dp"
                                                app:hiad_minWidth="48dp"
                                                app:hiad_textColor="#ffffff"
                                                app:hiad_textSize="12dp"/>
                                            <TextView
                                                android:textSize="12dp"
                                                android:textColor="#ffffff"
                                                android:gravity="center"
                                                android:id="@+id/ad_action_normal"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="@string/ad_download_start"/>
                                        </FrameLayout>
                                    </FrameLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:layout_gravity="bottom|center_horizontal"
                                android:orientation="horizontal"
                                android:id="@+id/zhibo_layout"
                                android:background="@drawable/nest_bg_square_btn_ad_down"
                                android:visibility="gone"
                                android:layout_width="117dp"
                                android:layout_height="24dp"
                                android:layout_marginBottom="30dp">
                                <ImageView
                                    android:id="@+id/zhibo_gif_img"
                                    android:layout_width="12dp"
                                    android:layout_height="9dp"
                                    android:layout_marginLeft="9dp"
                                    android:layout_marginBottom="-1.5dp"/>
                                <TextView
                                    android:textSize="12dp"
                                    android:textColor="#ffffff"
                                    android:gravity="center"
                                    android:layout_width="87dp"
                                    android:layout_height="17dp"
                                    android:layout_marginLeft="2dp"
                                    android:text="点击进入直播间"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_gravity="right"
                                android:id="@+id/ad_logo_normal_169"
                                android:background="@drawable/nest_find_shu_adlogo_bg"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginRight="6dp"
                                android:scaleType="fitCenter"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/ad_main_group"
                            android:layout_width="218dp"
                            android:layout_height="138dp"
                            android:layout_marginTop="8dp">
                            <com.zenmen.palmchat.ad.nest.nativead.ui.square.NestSquareAdPager
                                android:id="@+id/ad_pager"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:layout_gravity="bottom"
                                android:orientation="horizontal"
                                android:background="@drawable/nest_square_generic_list_item_ad_main_bg"
                                android:paddingLeft="8dp"
                                android:paddingTop="9dp"
                                android:paddingRight="8dp"
                                android:paddingBottom="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="10dp">
                                <ImageView
                                    android:id="@+id/ad_logo_group"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:scaleType="fitCenter"/>
                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:id="@+id/ad_down_yaoyiyao_layout_group"
                                    android:tag="ad_down_yaoyiyao_layout_group"
                                    android:background="@drawable/nest_bg_square_btn_ad_down"
                                    android:layout_width="129dp"
                                    android:layout_height="24dp">
                                    <LinearLayout
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/ad_yaoyiyao_group"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent">
                                        <ImageView
                                            android:id="@+id/yy_shake_bg_group"
                                            android:background="@drawable/ad_yaoyiyao"
                                            android:layout_width="13dp"
                                            android:layout_height="13dp"
                                            android:layout_marginLeft="5dp"/>
                                        <TextView
                                            android:textSize="12dp"
                                            android:textColor="#ffffff"
                                            android:gravity="center"
                                            android:id="@+id/yy_shake_text_group"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="5dp"
                                            android:text="摇一摇或"/>
                                    </LinearLayout>
                                    <FrameLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <FrameLayout
                                            android:layout_gravity="center_horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                                                android:layout_gravity="center_horizontal"
                                                android:id="@+id/app_download_btn_group"
                                                android:tag="huawei_download_btn_group"
                                                android:paddingLeft="7dp"
                                                android:paddingTop="3dp"
                                                android:paddingRight="7dp"
                                                android:paddingBottom="3dp"
                                                android:visibility="gone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                app:hiad_fixedWidth="true"
                                                app:hiad_maxWidth="70dp"
                                                app:hiad_minWidth="48dp"
                                                app:hiad_textColor="#ffffff"
                                                app:hiad_textSize="12dp"/>
                                        </FrameLayout>
                                        <TextView
                                            android:textSize="12dp"
                                            android:textColor="#ffffff"
                                            android:gravity="center"
                                            android:id="@+id/ad_action_group"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/ad_download_start"/>
                                    </FrameLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:id="@+id/ad_discount_info_layout"
                            android:visibility="gone"
                            android:layout_width="120dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="7dp">
                            <TextView
                                android:textSize="11dp"
                                android:textColor="#ffff7733"
                                android:ellipsize="end"
                                android:id="@+id/ad_discount_info_textview"
                                android:background="@drawable/nest_ad_disinfo_bg"
                                android:paddingLeft="5dp"
                                android:paddingTop="2dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="满200减30"
                                android:lines="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayoutNew2
                    android:id="@+id/ad_com_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="56dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.zenmen.palmchat.ad.VisibleDetectView>
</FrameLayout>
