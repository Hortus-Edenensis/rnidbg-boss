<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/richmsg_width"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/include_chat_name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        layout="@layout/include_item_chat_name_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/file_container"
        android:background="@drawable/selector_richmsg_item_background"
        android:padding="1px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/headerLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">
            <ImageView
                android:id="@+id/header_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_default_link"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/B2"
                android:textColor="@color/Gb"
                android:ellipsize="end"
                android:id="@+id/header_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="header"
                android:maxLines="1"
                android:layout_toRightOf="@+id/header_icon"
                android:layout_centerVertical="true"/>
            <View
                android:background="@color/gap_line_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/realcontentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/footerLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp">
            <View
                android:background="@color/gap_line_color"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="@dimen/B3"
                android:textColor="@color/Gb"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/footer_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="footer"
                android:maxLines="1"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/sourceLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:layout_marginTop="5dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/source_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="8dp"
                android:src="@drawable/ic_default_link"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"
                app:esv_shape="circle"/>
            <TextView
                android:textSize="@dimen/C3"
                android:textColor="@color/Gd"
                android:ellipsize="end"
                android:id="@+id/source_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="8dp"
                android:text="source"
                android:maxLines="1"
                android:layout_toRightOf="@+id/source_icon"
                android:layout_centerVertical="true"/>
            <View
                android:background="@color/gap_line_color"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentTop="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
