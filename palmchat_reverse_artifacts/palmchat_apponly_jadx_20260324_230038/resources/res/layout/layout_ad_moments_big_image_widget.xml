<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="11dp"
        android:textColor="#bebebe"
        android:id="@+id/ad_permission"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/string_ad_permission"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#202020"
        android:ellipsize="end"
        android:id="@+id/ad_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:text="这是广告title"
        android:maxLines="2"
        android:layout_below="@+id/ad_permission"/>
    <ImageView
        android:id="@+id/ad_image"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        android:layout_below="@+id/ad_title"/>
    <RelativeLayout
        android:id="@+id/ad_attatch_banner"
        android:background="@drawable/ad_attach_bg"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_below="@+id/ad_image">
        <TextView
            android:textSize="12dp"
            android:textColor="#9b9b9b"
            android:gravity="center_vertical"
            android:id="@+id/ad_attatch_des"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginLeft="10dp"
            android:text="红包已到账"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/ad_attach_arrow"
            android:visibility="gone"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ad_download"
            android:layout_toLeftOf="@+id/ad_attatch_btn"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#009687"
            android:id="@+id/ad_attatch_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="领取"
            android:layout_alignParentRight="true"/>
        <com.zenmen.palmchat.ad.view.ProgressButton
            android:textSize="11dp"
            android:textColor="#1ba0ff"
            android:id="@+id/ad_attatch_progress_btn"
            android:padding="0dp"
            android:layout_width="64dp"
            android:layout_height="20dp"
            android:layout_marginRight="5dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#476ba3"
        android:id="@+id/ad_show_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ad_show_more"
        android:drawableRight="@drawable/ad_show_more"
        android:drawablePadding="6dp"
        android:layout_below="@+id/ad_attatch_banner"/>
    <RelativeLayout
        android:id="@+id/ad_tag_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_below="@+id/ad_image">
        <ImageView
            android:id="@+id/ad_tag1"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:src="@drawable/ad_tag"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#9b9b9b"
            android:id="@+id/ad_tag2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="大众点评"
            android:layout_toRightOf="@+id/ad_tag1"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/ad_tag3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_toRightOf="@+id/ad_tag1"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:id="@+id/ad_delete_click"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/ad_delete"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/ad_delete"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
