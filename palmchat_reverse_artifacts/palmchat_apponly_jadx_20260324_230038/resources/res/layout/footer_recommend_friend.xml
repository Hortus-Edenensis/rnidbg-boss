<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="94dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lyt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/text_color_aeaeae"
                android:gravity="center"
                android:id="@+id/tv_footer_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recommend_friend_footer_text1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/text_color_aeaeae"
                android:gravity="center"
                android:id="@+id/tv_footer_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/recommend_friend_footer_text2"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
