<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.widget.card.YcCardView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        app:ycCardBackgroundColor="#ffffff"
        app:ycCardCornerRadius="16dp"
        app:ycCardElevation="4dp"
        app:ycStartShadowColor="#19000000">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">
            <RelativeLayout
                android:id="@+id/content_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RelativeLayout
                    android:id="@+id/info_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.EffectiveShapeView
                        android:id="@+id/header_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/default_portrait"
                        android:scaleType="centerCrop"
                        android:layout_centerVertical="true"
                        app:esv_shape="round_rectangle"
                        app:radius_x_dp="8dp"
                        app:radius_y_dp="8dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="15dp"
                        android:layout_toRightOf="@+id/header_icon"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="@dimen/B3"
                            android:textStyle="bold"
                            android:textColor="@color/Gb"
                            android:ellipsize="end"
                            android:layout_gravity="top"
                            android:id="@+id/name"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            style="@style/text_normal_content"/>
                        <TextView
                            android:textSize="@dimen/B4"
                            android:textColor="@color/Gb"
                            android:ellipsize="end"
                            android:layout_gravity="bottom"
                            android:id="@+id/text"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"/>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/btn_text"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="70dp"
                android:text="完善"
                android:maxLength="4"
                style="@style/btn_green_solid_small"/>
        </LinearLayout>
    </com.zenmen.palmchat.widget.card.YcCardView>
</LinearLayout>
