<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/toolbar"
        android:background="@drawable/ic_top_bg"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/back"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="16dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_arrow_back"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/error_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        android:src="@drawable/webview_load_error_icon"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#b8b8b8"
        android:id="@+id/error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="页面加载失败了"
        android:layout_below="@+id/error_icon"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/error_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="64dp"
        android:layout_marginRight="100dp"
        android:layout_below="@+id/error_title"
        android:layout_centerHorizontal="true"
        style="@style/btn_green_solid">
        <TextView
            android:enabled="true"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/text_color_btn_green"
            android:gravity="center"
            android:id="@+id/action_textview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:text="点击重试"/>
    </LinearLayout>
</RelativeLayout>
