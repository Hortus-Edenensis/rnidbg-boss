<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:tag="layout/activity_super_expose_home_0"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/top_image_bg2"
        android:layout_width="match_parent"
        android:layout_height="295dp"
        android:src="@drawable/fragment_super_expose_my_dynamic_top_bg"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/top_image_bg1"
        android:layout_width="match_parent"
        android:layout_height="295dp"
        android:src="@drawable/fragment_super_expose_myself_top_bg"
        android:scaleType="fitXY"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/m_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/top_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:id="@+id/toolbar_view"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@+id/top_view">
        <ImageView
            android:id="@+id/back"
            android:padding="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:src="@drawable/truth_match_arrow_back"
            android:layout_centerVertical="true"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tablayout2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:tabBackground="@drawable/tab_ripple_clear"
            app:tabGravity="start"
            app:tabPadding="0dp"
            app:tabPaddingEnd="14dp"
            app:tabPaddingStart="14dp"
            app:tabRippleColor="@null"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:id="@+id/super_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超级曝光"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
