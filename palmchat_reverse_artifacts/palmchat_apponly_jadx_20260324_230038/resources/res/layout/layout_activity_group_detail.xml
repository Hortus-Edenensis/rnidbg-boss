<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/none_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="132dp"
            android:src="@drawable/ic_none"/>
        <TextView
            android:textSize="@dimen/text_size_big2"
            android:textColor="@color/text_color_202020"
            android:id="@+id/error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="23dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_below="@+id/toolbar"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:background="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="172dp">
                    <FrameLayout
                        android:id="@+id/greenBg"
                        android:background="#059b64"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="113dp"/>
                    <com.zenmen.palmchat.widget.EffectiveShapeView
                        android:id="@+id/portrait"
                        android:background="@android:color/transparent"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="31dp"
                        android:src="@drawable/default_portrait"
                        android:scaleType="centerCrop"
                        android:layout_centerHorizontal="true"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/portrait"
                        android:layout_centerHorizontal="true">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="#202020"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/nameMain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="name"
                            android:maxLines="1"
                            android:maxEms="15"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#9b9b9b"
                            android:ellipsize="marquee"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/memberCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/group_detail_mem_count"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:maxLength="30"/>
                    </LinearLayout>
                </RelativeLayout>
                <ImageView
                    android:background="@color/gap_line_color"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <TextView
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="#535353"
                    android:layout_gravity="center"
                    android:id="@+id/group_detail_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="55dp"
                    android:text="@string/group_detail_invest"/>
                <TextView
                    android:textSize="@dimen/title_bar_title_text_size"
                    android:textColor="#020202"
                    android:layout_gravity="center"
                    android:id="@+id/group_detail_des2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="55dp"
                    android:text="@string/realname_owner_realname_des"/>
                <TextView
                    android:textSize="@dimen/text_size_middle"
                    android:textColor="#009687"
                    android:layout_gravity="center"
                    android:id="@+id/group_green_tips"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="@string/group_invited_tips"/>
                <TextView
                    android:textSize="@dimen/text_size_small"
                    android:textColor="#888"
                    android:layout_gravity="center"
                    android:id="@+id/group_detail_realname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="12dp"
                    android:text="longlonglonglonglonglongdfadfadfasdfasdfasdfasdfasdfasdfasdfasdfasdfdadfadf"/>
            </LinearLayout>
        </ScrollView>
        <RelativeLayout
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="78dp">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:enabled="true"
                    android:gravity="center"
                    android:id="@+id/action"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:text="@string/group_detail_action"
                    android:layout_weight="1"
                    style="@style/btn_green_solid"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
