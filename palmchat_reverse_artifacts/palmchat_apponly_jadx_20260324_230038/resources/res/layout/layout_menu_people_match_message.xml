<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/people_match_message"
        android:layout_width="29dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/people_match_message_dot"
        android:background="@drawable/people_match_message_badge_bg"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:layout_constraintLeft_toRightOf="@+id/people_match_message"
        app:layout_constraintRight_toRightOf="@+id/people_match_message"
        app:layout_constraintTop_toTopOf="@+id/people_match_message"/>
    <TextView
        android:id="@+id/people_match_message_badge"
        android:visibility="gone"
        app:layout_constraintLeft_toRightOf="@+id/people_match_message"
        app:layout_constraintRight_toRightOf="@+id/people_match_message"
        app:layout_constraintTop_toTopOf="@+id/people_match_message"
        style="@style/pm_tab_red_dot_small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
