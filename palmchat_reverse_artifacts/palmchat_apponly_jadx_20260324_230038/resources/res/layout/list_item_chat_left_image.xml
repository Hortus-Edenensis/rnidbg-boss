<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row_rec_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/portrait">
                <include
                    android:id="@+id/include_chat_name_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    layout="@layout/include_item_chat_name_layout"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/chat_item_portrait_view_size_margin_left_top">
                    <RelativeLayout
                        android:id="@+id/image_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.zenmen.palmchat.widget.AutoResizeImageView
                            android:gravity="center_vertical"
                            android:id="@+id/image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                            android:scaleType="centerCrop"
                            android:maxWidth="@dimen/chat_image_size"
                            android:maxHeight="@dimen/chat_image_size"
                            app:maxSize="@dimen/chat_image_size"
                            app:side="left"/>
                        <View
                            android:id="@+id/image_click_area"
                            android:background="@drawable/selector_message_mask_left_item_background"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignLeft="@+id/image"
                            android:layout_alignTop="@+id/image"
                            android:layout_alignRight="@+id/image"
                            android:layout_alignBottom="@+id/image"/>
                        <ImageView
                            android:id="@+id/image_loading_fail"
                            android:paddingLeft="5dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_loading_fail"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <FrameLayout
                        android:id="@+id/ai_lock_layout"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.zenmen.palmchat.widget.AutoResizeImageView
                            android:gravity="center_vertical"
                            android:id="@+id/thumbnail_ai_blur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            android:maxWidth="@dimen/chat_image_size"
                            android:maxHeight="@dimen/chat_image_size"
                            app:ailock="show"
                            app:side="left"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="12dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ai_chat_msg_blur_lock_bg"
                            android:scaleType="fitXY"/>
                    </FrameLayout>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/sourceLayout"
                    android:background="@drawable/bg_message_source"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="4dp">
                    <ImageView
                        android:id="@+id/source_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="@dimen/text_size_tiny3"
                        android:textColor="#999999"
                        android:id="@+id/source_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
