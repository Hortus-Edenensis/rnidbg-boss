<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/people_match_guide_root"
    android:background="@drawable/people_match_super_like_guide_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/people_match_guide_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/people_match_guide_light"
        android:scaleX="3"
        android:scaleY="3"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/people_match_tv_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:text="你已解锁"
        android:layout_above="@+id/people_match_tv_super_like"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="60dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/people_match_tv_super_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="超级喜欢"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/people_match_iv_super_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:src="@drawable/people_match_super_like_star_icon"
        android:layout_below="@+id/people_match_tv_super_like"
        android:layout_centerInParent="true"/>
</RelativeLayout>
