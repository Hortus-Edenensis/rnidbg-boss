<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:visibility="gone"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/guide_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/style1_container"
                    android:background="@drawable/bg_chat_guide_txt_only_in_chat"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginLeft="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                    android:layout_marginRight="@dimen/chat_conetnt_margin_left_or_right_no_padding">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/color_222222"
                        android:ellipsize="end"
                        android:id="@+id/tv_content1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/style2_container"
                    android:background="@drawable/background_chat_guide_bg_in_chat"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginLeft="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                    android:layout_marginRight="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                    android:layout_centerInParent="true"
                    android:paddingStart="12dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/color_222222"
                            android:ellipsize="end"
                            android:id="@+id/tv_content2"
                            android:layout_width="99dp"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:includeFontPadding="false"/>
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="8dp"
                            android:src="@drawable/ic_chat_guide_feed_icon_arrow"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <RelativeLayout
                        android:id="@+id/style2_icon_container"
                        android:visibility="gone"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="12dp">
                        <com.zenmen.palmchat.widget.EffectiveShapeView
                            android:id="@+id/iv_style2_feed_thumb"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_round_corner_default_pic"
                            android:scaleType="centerCrop"/>
                        <ImageView
                            android:id="@+id/iv_video_icon"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_video_for_square_card_in_chat"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/color_222222"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_style2title"
                        android:background="@drawable/background_chat_guide_feed_bg_in_chat"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:maxLines="3"
                        android:includeFontPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/style3_container"
                    android:background="@drawable/background_chat_guide_bg_in_chat"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginLeft="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                    android:layout_marginRight="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                    android:layout_centerInParent="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/color_222222"
                            android:ellipsize="end"
                            android:id="@+id/tv_content3"
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"/>
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="8dp"
                            android:src="@drawable/ic_chat_guide_feed_icon_arrow"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/style3_icon_container"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp">
                        <com.zenmen.palmchat.widget.EffectiveShapeView
                            android:id="@+id/iv_style3_pic_thumb1"
                            android:visibility="gone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_round_corner_default_pic"
                            android:scaleType="centerCrop"/>
                        <com.zenmen.palmchat.widget.EffectiveShapeView
                            android:id="@+id/iv_style3_pic_thumb2"
                            android:visibility="gone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_round_corner_default_pic"
                            android:scaleType="centerCrop"
                            android:layout_marginStart="4dp"/>
                        <com.zenmen.palmchat.widget.EffectiveShapeView
                            android:id="@+id/iv_style3_pic_thumb3"
                            android:visibility="gone"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_round_corner_default_pic"
                            android:scaleType="centerCrop"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/chat_conetnt_margin_left_or_right_no_padding_loading"
                android:layout_toLeftOf="@+id/guide_container"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
