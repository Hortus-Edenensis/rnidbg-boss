<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#b4000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/release_all_info_layout"
        android:background="@drawable/trip_map_release_all_info_layout_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_width="150dp"
                android:layout_height="24dp"
                android:layout_marginTop="20dp"
                android:text="发布我的行程"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:id="@+id/trip_map_release_location_info_layout"
                android:background="@drawable/trip_map_release_location_info_bg"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="16dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="230dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="12dp">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#222222"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/trip_release_location_name"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:text="上海市浦东新区"
                        android:lines="1"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#999999"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/trip_release_location_address"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="4dp"
                        android:text="上海市浦东新区"
                        android:lines="1"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="30dp"
                    android:layout_height="39dp"
                    android:layout_marginRight="22dp"
                    android:src="@drawable/trip_release_location_left_bg"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/trip_map_release_time_info_layout"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="选择到达时间"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:id="@+id/trip_release_time_info_jt"
                    android:layout_width="10dp"
                    android:layout_height="18dp"
                    android:src="@drawable/trip_map_release_time_jt_bg"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#222222"
                    android:gravity="center_vertical"
                    android:id="@+id/trip_release_time_info_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="10dp"
                    android:text="今天 19:00"
                    android:includeFontPadding="false"
                    android:layout_toLeftOf="@+id/trip_release_time_info_jt"/>
            </RelativeLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="#999999"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="选择行程目的"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp">
                <GridLayout
                    android:id="@+id/trip_release_info_tag_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-5dp"
                    android:layout_marginTop="-6dp"
                    android:rowCount="4"/>
            </FrameLayout>
            <TextView
                android:textSize="10dp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/trip_info_desc_title"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="发布后，别人可以在地图发现页或动态中看到你的行程,行程过期或被解锁聊天5次后将会消失"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/trip_map_release_info_button"
                android:background="@drawable/trip_map_release_info_button_bg"
                android:layout_width="320dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="36dp"
                android:text="发布行程"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/trip_release_info_all_close"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/trip_map_release_close_bg"/>
    </FrameLayout>
</FrameLayout>
