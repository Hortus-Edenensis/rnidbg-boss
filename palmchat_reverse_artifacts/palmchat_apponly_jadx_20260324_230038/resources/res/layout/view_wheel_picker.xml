<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp">
    <View
        android:background="@drawable/shape_f5f5f5_radius_24"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_centerVertical="true"/>
    <com.zenmen.palmchat.widget.picker.wheel.WheelPicker
        android:id="@+id/wheel_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:wheel_atmospheric="true"
        app:wheel_curved="true"
        app:wheel_cyclic="false"
        app:wheel_focus_item_half_height="24dp"
        app:wheel_item_space="22dp"
        app:wheel_item_text_color="#99222222"
        app:wheel_item_text_size="@dimen/B2"
        app:wheel_selected_item_text_color="#222222"
        app:wheel_selected_item_text_size="@dimen/B2"/>
</RelativeLayout>
