<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/publish"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_feed_publish"
        android:scaleType="fitXY"/>
    <com.zenmen.square.dynamiclife.DynamicCornerImageView
        android:id="@+id/iv_iamge"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:layout_centerInParent="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="#222222"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:background="@drawable/shape_feed_text_bg_4"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:maxLines="4"/>
    <RelativeLayout
        android:id="@+id/thumb_content"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_video"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_video_play_26"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_dynamic_life_remember"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/icon_square_remember"
            android:layout_alignParentBottom="true"/>
        <com.zenmen.listui.widget.LeftDrawableText
            android:id="@+id/iv_pic_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:layout_alignParentRight="true"
            style="@style/icon_media_count"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:id="@+id/rl_super_expose_item_enter"
            android:background="@drawable/ic_super_expose_item_enter"
            android:visibility="gone"
            android:layout_width="54dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:layout_alignParentRight="true">
            <RelativeLayout
                android:background="@color/transparent"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/iv_super_expose_item_enter_arrow"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_super_expose_item_enter_arrow"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/view_num_layout"
            android:background="@drawable/dynamic_expose_home_listitem_view_bg"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_margin="4dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="9dp"
                android:layout_height="6dp"
                android:src="@drawable/dynamic_expose_home_view_bg"/>
            <TextView
                android:textSize="9dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/view_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text=""/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
