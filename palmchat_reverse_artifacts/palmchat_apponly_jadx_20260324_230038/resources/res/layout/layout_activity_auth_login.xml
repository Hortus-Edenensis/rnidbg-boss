<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/login_bg"
    android:background="@color/Gb"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="#999999"
        android:layout_gravity="right"
        android:id="@+id/visitor"
        android:padding="10dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginRight="8dp"
        android:text="游客模式"/>
    <ImageView
        android:id="@+id/login_icon"
        android:layout_width="70dp"
        android:layout_height="80dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_init_logo"
        android:scaleType="centerInside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/A1"
        android:textStyle="bold"
        android:textColor="@color/Ab"
        android:id="@+id/login_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/login_init_welcome"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_icon"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="10"/>
    <TextView
        android:textSize="@dimen/A1"
        android:textColor="@color/Gh"
        android:id="@+id/phone_number_mask"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1234****56789"/>
    <TextView
        android:textSize="@dimen/C2"
        android:textColor="@color/Gd"
        android:id="@+id/auth_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/login_auth_by_cmcc"
        android:layout_below="@+id/login_quick_logo"
        android:layout_centerHorizontal="true"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="4"/>
    <com.zenmen.palmchat.loginnew.view.AuthLoginButton
        android:id="@+id/login_btn"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="9"/>
    <TextView
        android:textSize="@dimen/B4"
        android:textColor="@color/Ge"
        android:id="@+id/other_login"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/login_other_text"
        android:layout_below="@+id/login_quick_logo"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/agreement_layout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginLeft="19dp"
        android:layout_marginRight="27dp"
        android:layout_below="@+id/auth_area">
        <ImageView
            android:id="@+id/img_select"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_login_privacy_quick_unselect"
            android:layout_below="@+id/tv_guide"/>
        <TextView
            android:textSize="@dimen/C2"
            android:textColor="@color/Gh"
            android:gravity="center"
            android:id="@+id/tv_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-4dp"
            android:layout_marginTop="6dp"
            android:text="我已同意 用户服务条款 和 用户隐私协议"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="3"/>
</LinearLayout>
