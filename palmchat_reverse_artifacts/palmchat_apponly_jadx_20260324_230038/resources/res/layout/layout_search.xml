<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#474747"
        android:gravity="center"
        android:id="@+id/cancel_search"
        android:layout_width="56dp"
        android:layout_height="20dp"
        android:text="取消"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <com.zenmen.palmchat.widget.ClearEditText
        android:textSize="@dimen/text_size_middle"
        android:textColor="@color/gen_statusBarTitleTextColor"
        android:textColorHint="#c5c5c5"
        android:gravity="center_vertical"
        android:id="@+id/search"
        android:background="@drawable/bg_moment_header_send"
        android:paddingLeft="10dp"
        android:paddingRight="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_edit_text_height"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:hint="@string/string_search"
        android:singleLine="true"
        android:drawableLeft="@drawable/search"
        android:drawablePadding="5dp"
        android:layout_toLeftOf="@+id/cancel_search"
        android:layout_centerVertical="true"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@null"/>
</RelativeLayout>
