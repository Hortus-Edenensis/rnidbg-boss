<?xml version="1.0" encoding="utf-8"?>
<com.zenmen.openapi.jssdk.widget.PermissionDialogView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/lx_auth_confirm_dialog_bg"
        android:paddingLeft="23dp"
        android:paddingTop="20dp"
        android:paddingRight="23dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/lx_permission_confirm_app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/lx_permission_confirm_app_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/lx_permission_confirm_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.5dp"
                android:layout_toRightOf="@+id/lx_permission_confirm_app_icon"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#222222"
                android:id="@+id/lx_permission_confirm_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.5dp"
                android:text="申请"
                android:layout_toRightOf="@+id/lx_permission_confirm_app_name"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:id="@+id/lx_permission_confirm_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_below="@+id/lx_permission_confirm_app_info"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#999999"
            android:id="@+id/lx_permission_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_below="@+id/lx_permission_confirm_content"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#202020"
            android:gravity="center"
            android:id="@+id/lx_permission_confirm_cancel"
            android:background="@drawable/lx_openapi_btn_bg_negative"
            android:layout_width="132dp"
            android:layout_height="36dp"
            android:layout_marginTop="33dp"
            android:text="@string/lx_open_api_denied"
            android:layout_below="@+id/lx_permission_target"
            android:layout_alignParentLeft="true"
            android:onClick="onClick"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/lx_permission_confirm_ok"
            android:background="@drawable/lx_openapi_btn_bg_positive"
            android:layout_width="132dp"
            android:layout_height="36dp"
            android:layout_marginTop="33dp"
            android:text="@string/lx_open_api_access"
            android:layout_below="@+id/lx_permission_target"
            android:layout_alignParentRight="true"
            android:onClick="onClick"/>
    </RelativeLayout>
</com.zenmen.openapi.jssdk.widget.PermissionDialogView>
