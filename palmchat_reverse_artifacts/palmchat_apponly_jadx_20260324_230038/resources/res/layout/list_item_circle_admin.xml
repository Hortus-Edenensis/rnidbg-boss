<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/color_222222"
        android:id="@+id/circle_tv_role_type_section_header"
        android:background="#f4f4f4"
        android:paddingLeft="@dimen/feed_dp_15"
        android:paddingTop="@dimen/feed_dp_6"
        android:paddingBottom="@dimen/feed_dp_6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:minHeight="60dp">
        <ImageView
            android:id="@+id/circle_iv_del_admin"
            android:visibility="gone"
            android:layout_width="@dimen/feed_dp_20"
            android:layout_height="@dimen/feed_dp_20"
            android:layout_marginLeft="@dimen/dimen_16"
            android:src="@drawable/ic_delete_circle"/>
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/avatarIv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="15dp"
            app:esv_shape="circle"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ff202020"
            android:id="@+id/nameTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="15dp"
            android:text="添加群管理员"
            android:singleLine="true"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
