<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/map_sepration_bug_success_bg"
        android:layout_width="308dp"
        android:layout_height="291dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="分身服务生效中"
                android:lines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#999999"
                android:gravity="center_horizontal"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="分身正在被优先展示，其他人可通过分身头像直接和你发起聊天"
                android:lines="2"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="14dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:layout_gravity="center"
                    android:id="@+id/map_separation_dialog_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    app:esv_shape="circle"/>
                <ImageView
                    android:layout_gravity="bottom|right"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:src="@drawable/location_separation_icon_bottom"
                    android:scaleType="fitXY"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/map_separation_bug_success_marquee_bg"
                android:layout_width="268dp"
                android:layout_height="25dp"
                android:layout_marginTop="11dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/map_separation_success_position_bg"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#0072ff"
                    android:ellipsize="marquee"
                    android:gravity="center_vertical"
                    android:id="@+id/map_separation_bug_success_marquee"
                    android:layout_width="220dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="4dp"
                    android:text="当前分身位置：上海市徐汇区张江镇海趣…"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="marquee_forever"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginTop="18dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#999999"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="剩余有效期："
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#999999"
                    android:gravity="center_vertical"
                    android:id="@+id/separation_success_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="23:44:56"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/location_separation_success_layout_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="-5dp"
            android:layout_marginRight="13dp"
            android:src="@drawable/location_separation_close"
            android:scaleType="fitXY"/>
    </FrameLayout>
</FrameLayout>
