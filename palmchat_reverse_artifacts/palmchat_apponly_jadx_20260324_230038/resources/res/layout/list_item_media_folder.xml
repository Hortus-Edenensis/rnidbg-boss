<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/folder_image_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="1dp"
        android:layout_centerVertical="true">
        <com.zenmen.palmchat.chat.MediaPickSquareImageView
            android:id="@+id/folder_image"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:scaleType="centerCrop"/>
        <ImageView
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:layout_width="79dp"
            android:layout_height="79dp"
            android:src="@drawable/media_folder_bg"
            android:scaleType="fitCenter"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_toRightOf="@+id/folder_image_layout"
        android:layout_centerVertical="true">
        <TextView
            android:id="@+id/folder_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/text_normal_content"/>
        <TextView
            android:id="@+id/folder_item_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/text_middle_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/folder_picked_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/icon_gender_item_select"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
