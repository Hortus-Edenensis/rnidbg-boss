<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="27dp"
    android:layout_marginRight="27dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/icon_dynamic_expose_v1_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#ff222222"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="发布成功"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:background="@drawable/super_expose_v2_publish_list_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="18dp"
                android:layout_marginBottom="10dp"/>
            <ImageView
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="18dp"
                android:layout_height="11dp"
                android:src="@drawable/super_expose_v2_publish_down"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="30dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#ff222222"
                android:gravity="center"
                android:id="@+id/btn_submit_txt"
                android:background="@drawable/icon_dynamic_expose_v1_dialog_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="我要上推荐"
                android:layout_alignParentBottom="true"/>
            <ImageView
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:src="@drawable/super_expose_v2_publish_up"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="183dp"
        android:layout_height="53dp"
        android:src="@drawable/super_expose_v2_publish_head"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/close_layout"
        android:padding="10dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentRight="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_dynamic_expose_v1_dialog_close"/>
    </FrameLayout>
</RelativeLayout>
