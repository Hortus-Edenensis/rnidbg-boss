<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@drawable/layout_dialog_superexpose_charge_success_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="right"
                android:id="@+id/dialog_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <ImageView
                    android:background="@drawable/dialog_wanliu_close_image"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="15dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ff222222"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充值成功"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ff999999"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/sub_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="是否立即获得%s，\10让异性主动撩你吧~"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/card_image"
                    android:background="@drawable/dialog_superexpose_charge_card_image_selector"
                    android:layout_width="94dp"
                    android:layout_height="87dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/btn_start"
                    android:background="@drawable/dialog_superexpose_charge_success_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开始曝光 "/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/btn_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
