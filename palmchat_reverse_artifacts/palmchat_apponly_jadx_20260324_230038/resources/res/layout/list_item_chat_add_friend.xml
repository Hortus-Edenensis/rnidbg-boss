<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingTop="1dp"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/agree_friend_request_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/chat_item_portrait_view_size"
                android:layout_marginTop="-1dp">
                <include
                    android:id="@+id/include_chat_name_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    layout="@layout/include_item_chat_name_layout"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right">
                    <TextView
                        android:textSize="@dimen/dimen_16"
                        android:typeface="sans"
                        android:textColor="@color/Gb"
                        android:textColorHighlight="@color/link_url_highlight_left"
                        android:gravity="center_vertical"
                        android:id="@+id/message"
                        android:background="@drawable/selector_message_left_item_background_bubble"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/list_item_text_width"
                        android:text="@string/add_friend_in_chat_apply_tips"
                        android:lineSpacingExtra="3dp"/>
                    <TextView
                        android:textSize="@dimen/B4"
                        android:textColor="#00be52"
                        android:id="@+id/tv_agree_friend_request"
                        android:background="@drawable/shape_agree_friend_in_message"
                        android:paddingLeft="@dimen/dimen_16"
                        android:paddingTop="@dimen/dimen_8"
                        android:paddingRight="@dimen/dimen_16"
                        android:paddingBottom="@dimen/dimen_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="@dimen/dimen_6"
                        android:text="@string/add_friend_in_chat_accept"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/B4"
                android:textColor="#00be52"
                android:id="@+id/tv_add_friend"
                android:background="@drawable/shape_agree_friend_in_message"
                android:paddingLeft="@dimen/dimen_16"
                android:paddingTop="@dimen/dimen_8"
                android:paddingRight="@dimen/dimen_16"
                android:paddingBottom="@dimen/dimen_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_friend_in_chat_add"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/C2"
                android:textColor="@color/Aa"
                android:id="@+id/tv_already_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_friend_in_chat_already_apply"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/C2"
                android:textColor="@color/Gd"
                android:id="@+id/tv_already_is_friend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_friend_in_chat_is_friend"
                android:layout_centerHorizontal="true"/>
            <View
                android:id="@+id/audio_read"
                android:background="@drawable/red_circle"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginLeft="7dp"
                android:layout_toRightOf="@+id/agree_friend_request_layout"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
