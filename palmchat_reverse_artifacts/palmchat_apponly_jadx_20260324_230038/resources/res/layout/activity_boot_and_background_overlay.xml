<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#cc000000"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:onClick="onClicked">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:src="@drawable/permission_guide_up_arrow"
            android:layout_above="@+id/text1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@android:color/white"
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="41dp"
            android:text="@string/swipe_list_to_find_palmchat"
            android:layout_above="@+id/preview_layout"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/preview_layout"
            android:background="@drawable/boot_and_backgroud_pv_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_guide_ic_logo"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/app_name"
                android:layout_toRightOf="@+id/icon"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/switch_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="17dp"
            android:textColor="@android:color/white"
            android:id="@+id/text2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="41dp"
            android:layout_below="@+id/preview_layout"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/click_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="3dp"
            android:src="@drawable/permission_guide_click_icon"
            android:layout_below="@+id/preview_layout"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/text_size_big"
            android:textColor="@android:color/white"
            android:id="@+id/click_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_below="@+id/click_icon"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
