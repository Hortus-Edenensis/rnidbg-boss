<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/mapview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/rl_top_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="-5dp"
        android:layout_marginRight="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_back"
            android:background="@drawable/bg_find_map_top_bar"
            android:paddingLeft="8dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_find_map_back"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_search_btn"
            android:background="@drawable/bg_find_map_top_bar"
            android:paddingLeft="12dp"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="10dp"
            android:text="搜索附近位置"
            android:maxLines="1"
            android:drawableLeft="@drawable/icon_search"
            android:drawablePadding="8dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/trip_nearby_button_layout"
            android:visibility="gone"
            android:layout_width="82dp"
            android:layout_height="46dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="-5dp">
            <ImageView
                android:background="@drawable/map_trip_nearby_btn"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/trip_nearby_red_button"
                android:background="@drawable/map_trip_nearby_red_bg"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="2dp"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="77dp"
            android:layout_height="46dp"
            android:layout_marginLeft="3dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_gravity="bottom"
                android:id="@+id/trip_button_layout"
                android:background="@drawable/map_trip_release_btn"
                android:paddingLeft="6dp"
                android:paddingTop="8dp"
                android:paddingRight="6dp"
                android:visibility="visible"
                android:layout_width="80dp"
                android:layout_height="42dp"
                android:text="发布行程"
                android:lines="1"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/filter_enter"
        android:layout_width="65dp"
        android:layout_height="50dp"
        android:layout_marginTop="-7dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/selector_find_map_filter"
        android:layout_below="@+id/rl_top_tool_bar"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/avatar_switch_enter"
        android:layout_width="65dp"
        android:layout_height="50dp"
        android:layout_marginTop="-7dp"
        android:src="@drawable/selector_avatar_show_enter"
        android:layout_toLeftOf="@+id/filter_enter"
        android:layout_below="@+id/rl_top_tool_bar"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#0072ff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_selected_location_info"
        android:background="@drawable/bg_find_map_top_info"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-6dp"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:layout_toLeftOf="@+id/avatar_switch_enter"
        android:layout_below="@+id/rl_top_tool_bar"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_top_prompt"
        android:background="@drawable/ic_bg_findmap_top_toast"
        android:paddingTop="12dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="找朋友附近的人已更新，返回查看"
        android:layout_below="@+id/rl_top_tool_bar"
        android:layout_alignLeft="@+id/rl_top_tool_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/trip_bubble_layout"
        android:visibility="gone"
        android:layout_width="200dp"
        android:layout_height="33dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/rl_top_tool_bar"
        android:layout_alignParentRight="true">
        <ImageView
            android:layout_gravity="right"
            android:layout_width="8dp"
            android:layout_height="4dp"
            android:layout_marginRight="32dp"
            android:src="@drawable/trip_map_bubble_sanjiao_bg"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/map_trip_bubble_btn_title"
            android:background="@drawable/map_trip_bubble_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:text="试试发布行程，提前约玩附近的人"
            android:lines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/btn_confirm_separation_layout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="42dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/separation_button_all_layout"
                android:layout_width="158dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_left_separation"
                    android:background="@drawable/map_separation_left_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center_vertical"
                            android:id="@+id/map_finder_separation_title"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:text="设置分身"
                            android:includeFontPadding="false"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="14dp"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/map_separation_left_icon_bg"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#d7ffffff"
                        android:gravity="center"
                        android:id="@+id/map_finder_separation_intro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="5dp"
                        android:text="让更多人看到你"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_left_separation_success"
                    android:background="@drawable/map_separation_left_btn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:text="迁移分身"
                            android:includeFontPadding="false"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="14dp"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/map_separation_left_icon_bg"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#d7ffffff"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="分身有效期："
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/btn_left_separation_success_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23:45:56"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/btn_confirm_separation"
                android:background="@drawable/map_separation_right_btn"
                android:layout_width="158dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:gravity="center_vertical"
                        android:id="@+id/map_finder_confirm_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:text="解锁附近的人"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="6dp"
                        android:src="@drawable/map_separation_right_icon_bg"/>
                </LinearLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#d7ffffff"
                    android:gravity="center"
                    android:id="@+id/map_finder_confirm_intro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="5dp"
                    android:text="可查看定位附近头像和用户"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/btn_confirm"
        android:background="@drawable/selector_btn_green_normal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="62dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="解锁附近的人"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="（解锁定位附近清晰头像和用户列表）"
            android:alpha="0.8"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/iv_center_location_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_center_location"
            android:layout_width="22dp"
            android:layout_height="28dp"
            android:src="@drawable/icon_center_location"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/iv_center_location_s1"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="44dp"/>
    </FrameLayout>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/iv_center_location_s2"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12dp"
        android:id="@+id/tv_first_prompt"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="32dp"
        android:text="拖动地图试试"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true"
        style="@style/btn_green_solid_28"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center_horizontal"
        android:id="@+id/tv_location_count"
        android:background="@drawable/bg_location_count"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginBottom="12dp"
        android:text="附近有9999人近期活跃"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tv_location_count_num_layout"
        android:background="@drawable/bg_map_nearby_green"
        android:paddingLeft="14dp"
        android:paddingTop="2dp"
        android:paddingRight="14dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:id="@+id/tv_location_count_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9999"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="人"
                android:layout_centerHorizontal="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="16dp">
            <TextView
                android:textSize="10dp"
                android:textColor="#ccffffff"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="附近活跃"/>
            <ImageView
                android:background="@drawable/bg_map_nearby_jj"
                android:layout_width="8dp"
                android:layout_height="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/location_guide_count_num_layout"
        android:background="@drawable/map_find_guide_near_people_num_bg"
        android:visibility="gone"
        android:layout_width="97dp"
        android:layout_height="65dp"
        android:layout_marginBottom="-10dp"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="29dp">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#00c85a"
                android:gravity="center"
                android:id="@+id/map_find_guide_near_people_num_text"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="999"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#00c85a"
                android:gravity="bottom"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="人"/>
        </LinearLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/location_guide_center_bottom_view"
        android:visibility="gone"
        android:layout_width="118dp"
        android:layout_height="52dp"
        android:layout_marginBottom="-96dp"
        android:src="@drawable/map_find_guide_center_bottom_bg"
        android:scaleType="fitXY"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/location_guide_near_no_people"
        android:visibility="gone"
        android:layout_width="141dp"
        android:layout_height="55dp"
        android:layout_marginBottom="-10dp"
        android:src="@drawable/map_find_guide_near_no_people_bg"
        android:scaleType="fitXY"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/location_guide_center_ing_view"
        android:visibility="gone"
        android:layout_width="102dp"
        android:layout_height="55dp"
        android:src="@drawable/map_find_guide_ceter_ing_bg"
        android:scaleType="fitXY"
        android:layout_above="@+id/iv_center_location_layout"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/map_pendant_layout"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="98dp"
        android:layout_marginRight="9dp"
        android:layout_marginBottom="9dp"
        android:layout_above="@+id/move_layout"
        android:layout_alignParentRight="true">
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/map_pendant_img"
            android:layout_width="59dp"
            android:layout_height="92dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/map_pendant_close"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/map_pendant_close"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/move_layout"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="138dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_move_start"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:src="@drawable/icon_location_start"/>
        <ImageView
            android:id="@+id/iv_separation_move"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/map_separation_location_click"/>
        <ImageView
            android:id="@+id/iv_separation_unlock_info"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/map_separation_unlock_info"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_active_enter"
        android:visibility="gone"
        android:layout_width="59dp"
        android:layout_height="77dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/ic_find_map_vip_enter"
        android:layout_above="@+id/move_layout"
        android:layout_alignRight="@+id/move_layout"/>
    <ImageView
        android:id="@+id/iv_active_close"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="-3dp"
        android:layout_marginRight="-3dp"
        android:src="@drawable/iv_find_map_vip_close"
        android:layout_alignTop="@+id/iv_active_enter"
        android:layout_alignRight="@+id/iv_active_enter"/>
    <FrameLayout
        android:id="@+id/tv_location_separation_layout"
        android:background="#b3000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/separation_old_buy_layout"
            android:background="@drawable/map_separation_new_dialog_bg"
            android:layout_width="320dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:id="@+id/map_separation_bug_title"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="购买分身特权"
                    android:lines="1"
                    android:includeFontPadding="false"/>
                <FrameLayout
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginTop="20dp">
                    <ImageView
                        android:id="@+id/map_separation_bug_img1"
                        android:layout_width="91dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/map_separation_bug_img1"
                        android:scaleType="fitXY"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/map_separation_bug_img2"
                        android:layout_width="91dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/map_separation_bug_img2"
                        android:scaleType="fitXY"/>
                    <ImageView
                        android:layout_gravity="right"
                        android:id="@+id/map_separation_bug_img3"
                        android:layout_width="91dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/map_separation_bug_img3"
                        android:scaleType="fitXY"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/separation_optimize_layout"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:layout_width="288dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="解锁坐标："
                        android:lines="1"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/map_separation_bug_success_marquee_bg"
                        android:layout_width="288dp"
                        android:layout_height="25dp"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginLeft="12dp"
                            android:src="@drawable/map_separation_success_position_bg"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#0072ff"
                            android:gravity="center_vertical"
                            android:id="@+id/map_separation_location_km"
