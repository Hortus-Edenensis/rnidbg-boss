<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/listitem_dynamic_expose_home_dynamic_0"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageView"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedImage12"/>
    <ImageView
        android:id="@+id/iv_video"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_video_play_26"
        android:layout_centerInParent="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="#222222"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text_thumbnail"
        android:background="@drawable/shape_feed_text_bg1_12"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:maxLines="4"/>
    <LinearLayout
        android:background="@drawable/dynamic_expose_home_listitem_view_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_margin="4dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="9dp"
            android:layout_height="6dp"
            android:src="@drawable/dynamic_expose_home_view_bg"/>
        <TextView
            android:textSize="9dp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/view_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text=""/>
    </LinearLayout>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/last_top_view"
        android:background="@drawable/dynamic_expose_home_listitem_view_top_bg"
        android:paddingLeft="10dp"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="13dp"
        android:text="最新发布"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
