<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_color_202020"
            android:gravity="center"
            android:id="@+id/tv_top_set"
            android:background="@drawable/selector_settings_item_background"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/service_top_set"/>
        <View
            android:background="#eeeeee"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_color_202020"
            android:gravity="center"
            android:id="@+id/tv_settings"
            android:background="@drawable/selector_settings_item_background"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="设置"/>
        <View
            android:background="#eeeeee"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/Ga"
            android:gravity="center"
            android:id="@+id/tv_change_follow"
            android:background="@drawable/selector_settings_item_background"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/service_account_unfollow_ok"/>
        <View
            android:background="#eeeeee"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_color_202020"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/selector_settings_item_background"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/dialog_cancel"/>
    </LinearLayout>
</FrameLayout>
