<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/Gd"
        android:id="@+id/square_tab_item_text"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/square_tab_item_dot"
        android:background="@drawable/red_circle_lbs_notify"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_alignTop="@+id/square_tab_item_text"
        android:layout_alignRight="@+id/square_tab_item_text"/>
    <View
        android:id="@+id/square_tab_item_bottom"
        android:background="@drawable/bg_nest_dynamic_life_topic_select_tab_light"
        android:visibility="invisible"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/square_tab_item_text"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
