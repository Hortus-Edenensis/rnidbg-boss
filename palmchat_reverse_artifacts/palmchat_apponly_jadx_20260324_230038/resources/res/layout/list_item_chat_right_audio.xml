<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/audioContainer"
                android:background="@drawable/selector_message_right_audio_item_background_bubble"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:layout_toLeftOf="@+id/portrait">
                <RelativeLayout
                    android:id="@+id/audioControlLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <ImageView
                        android:id="@+id/play_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="2dp"
                        android:src="@drawable/ic_audio_bg_play_press"
                        android:layout_centerVertical="true"/>
                    <com.zenmen.palmchat.widget.NoneClickableSeekBar
                        android:id="@+id/play_seek_bar"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/audio_seekbar_style_right"
                        android:thumb="@drawable/ic_audio_seekbar_thumb_press_new"
                        android:thumbOffset="7dp"
                        android:layout_toLeftOf="@+id/play_length"
                        android:layout_toRightOf="@+id/play_icon"
                        android:layout_centerVertical="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:splitTrack="false"
                        android:thumbTintMode="multiply"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/Ab"
                        android:id="@+id/play_length"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:02"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <ImageView
                    android:gravity="right"
                    android:id="@+id/audio"
                    android:visibility="gone"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="center"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="17dp"
                    android:textColor="#ffffff"
                    android:id="@+id/audio_during"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_alignBaseline="@+id/audio_during_label"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/audio_during_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="@string/audio_during_second"
                    android:layout_toRightOf="@+id/audio_during"
                    android:layout_centerVertical="true"
                    android:translationY="-4dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/audioContainer"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_centerInParent="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
