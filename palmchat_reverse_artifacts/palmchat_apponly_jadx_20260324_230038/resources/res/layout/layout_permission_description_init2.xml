<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="top"
    android:orientation="vertical"
    android:background="#b2000000"
    android:paddingLeft="34dp"
    android:paddingTop="40dp"
    android:paddingRight="34dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/B2"
        android:textColor="@color/Gh"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="为了您正常使用连信APP功能，需要您分别授权以下权限："/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/permission_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_init_per_phonestate"/>
        <TextView
            android:textSize="@dimen/B3"
            android:textColor="@color/Gh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="电话权限"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/C2"
        android:textColor="@color/Gh"
        android:id="@+id/des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33dp"
        android:layout_marginTop="16dp"
        android:text="为保障您的账号安全，通过此权限读取硬件信息，判断账号与设备的关联，通过技术与风控规则，提高您的账号安全性。如您拒绝授权，您将无法体验上述服务，但不影响您继续使用连信APP。"/>
</LinearLayout>
