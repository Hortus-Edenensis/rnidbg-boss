<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:layout_gravity="center_vertical"
        android:id="@+id/list_circle_join_auth_cover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/default_portrait"
        android:scaleType="centerCrop"
        app:esv_shape="circle"
        app:radius_x="13"
        app:radius_y="13"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_alignBaseline="@+id/list_circle_join_auth_cover"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:gravity="left"
        android:id="@+id/list_circle_join_auth_name_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:layout_toLeftOf="@+id/list_circle_join_auth_agree"
        android:layout_toRightOf="@+id/list_circle_join_auth_cover">
        <TextView
            android:textSize="15dp"
            android:ellipsize="end"
            android:id="@+id/list_circle_join_auth_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawableRight="@drawable/circle_auth_female"
            android:drawablePadding="6dp"
            style="@style/settings_main_text_black"/>
    </RelativeLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_999999"
        android:id="@+id/list_circle_join_auth_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:layout_toRightOf="@+id/list_circle_join_auth_cover"
        android:layout_below="@+id/list_circle_join_auth_name_ll"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:id="@+id/list_circle_join_auth_agree"
        android:layout_width="61dp"
        android:layout_height="26dp"
        android:layout_marginRight="14dp"
        android:text="@string/circle_join_agree"
        android:layout_below="@+id/list_circle_join_auth_question"
        android:layout_alignParentRight="true"
        style="@style/btn_green_solid"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/list_circle_join_auth_agree_verify_fail"
        android:background="@drawable/shape_cccccc_14"
        android:paddingLeft="7dp"
        android:paddingTop="4dp"
        android:paddingRight="7dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginRight="14dp"
        android:text="账号异常"
        android:layout_below="@+id/list_circle_join_auth_question"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:id="@+id/list_circle_join_auth_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/list_circle_join_auth_agree"
        android:layout_toRightOf="@+id/list_circle_join_auth_cover"
        android:layout_below="@+id/list_circle_join_auth_question"/>
    <View
        android:id="@+id/vw_line"
        android:background="#e6e6e6"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_toRightOf="@+id/list_circle_join_auth_cover"
        android:layout_below="@+id/list_circle_join_auth_agree"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/text_color_666666"
        android:id="@+id/tv_deal_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_toRightOf="@+id/list_circle_join_auth_cover"
        android:layout_below="@+id/vw_line"/>
    <View
        android:id="@+id/vw_line2"
        android:background="#e6e6e6"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/tv_deal_tip"/>
</RelativeLayout>
