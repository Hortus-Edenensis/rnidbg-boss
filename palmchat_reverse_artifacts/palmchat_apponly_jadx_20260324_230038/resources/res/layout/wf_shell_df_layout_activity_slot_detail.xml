<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/wf_shell_df_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@color/wf_shell_df_white_e"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/wf_df_slot_detail_back_image"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/wf_shell_df_icon_back_arrow"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/wf_shell_sdk_df_black"
            android:gravity="center"
            android:id="@+id/wf_df_code_check_txt"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/wf_shell_df_slot_detail"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/wf_shell_df_shape_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_8"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="@string/wf_shell_df_slot_id"
            android:layout_marginStart="@dimen/wf_shell_df_item_left"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_5"
            android:gravity="center_vertical"
            android:id="@+id/wf_sdk_df_item_slot_id"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/wf_shell_df_shape_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_8"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="@string/wf_shell_df_app_id"
            android:layout_marginStart="@dimen/wf_shell_df_item_left"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_5"
            android:gravity="center_vertical"
            android:id="@+id/wf_sdk_df_item_app_id"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/wf_shell_df_shape_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_8"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="@string/wf_shell_df_app_token"
            android:layout_marginStart="@dimen/wf_shell_df_item_left"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_5"
            android:gravity="center_vertical"
            android:id="@+id/wf_sdk_df_item_token_id"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/wf_shell_df_shape_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/wf_shell_df_title_8"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="@string/wf_shell_df_slot_type"
                android:layout_marginStart="@dimen/wf_shell_df_item_left"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/wf_shell_df_title_5"
                android:gravity="center_vertical"
                android:id="@+id/wf_sdk_df_detail_slot_type"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="5dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/wf_shell_df_title_8"
                android:gravity="center"
                android:id="@+id/wf_sdk_df_request_status_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="@string/wf_shell_df_request_status"
                android:layout_marginStart="40dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/wf_shell_df_title_5"
                android:gravity="center_vertical"
                android:id="@+id/wf_sdk_df_request_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/wf_sdk_df_request_error_layout"
        android:background="@drawable/wf_shell_df_shape_content_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_8"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="@string/wf_shell_df_request_error_msg"
            android:layout_marginStart="@dimen/wf_shell_df_item_left"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/wf_shell_df_title_5"
            android:gravity="center_vertical"
            android:id="@+id/wf_sdk_df_request_error_msg"
            android:paddingBottom="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <Button
        android:textSize="16sp"
        android:id="@+id/wf_sdk_df_detail_request_ad"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:text="@string/wf_shell_df_request_ad"
        android:layout_marginStart="@dimen/wf_shell_df_item_left"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/wf_shell_df_white_e"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:id="@+id/wf_sdk_df_detail_slot_request_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
