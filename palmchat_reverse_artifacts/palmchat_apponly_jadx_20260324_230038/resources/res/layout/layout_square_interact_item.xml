<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_content"
    android:tag="layout/layout_square_interact_item_0"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/iv_avatar_interact_list"
        android:tag="binding_1"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:esv_shape="circle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:tag="binding_2"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_interact_list"
        app:layout_constraintRight_toRightOf="@+id/iv_avatar_interact_list"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/Gb"
        android:ellipsize="end"
        android:id="@+id/tv_nickname_message_list"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxWidth="150dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toRightOf="@+id/iv_avatar_interact_list"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar_interact_list"/>
    <TextView
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginLeft="6dp"
        android:text="@string/square_title_friend"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname_message_list"
        app:layout_constraintLeft_toRightOf="@+id/tv_nickname_message_list"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname_message_list"
        style="@style/btn_green_solid_16"/>
    <FrameLayout
        android:id="@+id/content_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_nickname_message_list"
        app:layout_constraintRight_toLeftOf="@+id/feed_image"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname_message_list">
        <TextView
            android:textSize="13dp"
            android:textColor="#222222"
            android:ellipsize="end"
            android:layout_gravity="top|left"
            android:id="@+id/tv_praise_prompt"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#666666"
            android:layout_gravity="top|left"
            android:id="@+id/tv_delete"
            android:background="@drawable/square_message_comment_delete_bg"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="此评论已删除"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <HorizontalScrollView
        android:id="@+id/hs_interact_avatar_list"
        android:tag="binding_6"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_nickname_message_list"
        app:layout_constraintTop_toBottomOf="@+id/content_layout">
        <com.zenmen.square.ui.widget.InteractNestImageContainer
            android:orientation="horizontal"
            android:id="@+id/ll_nest_avatar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
    <TextView
        android:textSize="12dp"
        android:textColor="#999999"
        android:id="@+id/tv_interact_time"
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/content_layout"
        app:layout_constraintTop_toBottomOf="@+id/hs_interact_avatar_list"
        app:layout_goneMarginTop="7dp"/>
    <TextView
        android:id="@+id/tv_reply"
        android:tag="binding_8"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:text="@string/square_interact_reply"
        app:layout_constraintLeft_toLeftOf="@+id/content_layout"
        app:layout_constraintTop_toBottomOf="@+id/tv_interact_time"
        style="@style/btn_gray_solid_22"/>
    <TextView
        android:id="@+id/tv_say_hi"
        android:tag="binding_9"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toRightOf="@+id/tv_reply"
        app:layout_constraintTop_toBottomOf="@+id/tv_interact_time"
        app:layout_goneMarginLeft="0dp"
        style="@style/btn_gray_solid_22"/>
    <RelativeLayout
        android:id="@+id/feed_image"
        android:tag="binding_10"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/iv_interact_thumbnail"
            android:tag="binding_11"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="4dp"
            app:radius_y_dp="4dp"/>
        <ImageView
            android:id="@+id/video_praise_cover"
            android:tag="binding_12"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_video_play_btn"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#222222"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/text_thumbnail"
            android:tag="binding_13"
            android:background="@drawable/shape_feed_text_bg_4"
            android:paddingLeft="3dp"
            android:paddingTop="2dp"
            android:paddingRight="3dp"
            android:paddingBottom="4dp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:maxLines="3"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
