<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentLayout"
    android:tag="layout/layout_square_media_view_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_mediaview"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.square.ui.widget.SquareHackyViewPager
            android:id="@+id/feed_media_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zenmen.square.ui.widget.DoubleClickView
            android:id="@+id/v_feed_detail_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/infoLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_feed_detail_bottom"
            android:background="@drawable/bg_square_feeddetail_bottom_info"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:id="@+id/btn_tv_comment"
                android:tag="binding_2"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginRight="75dp"
                android:layout_marginBottom="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                style="@style/btn_gray_solid_xsmall"/>
            <com.zenmen.square.ui.widget.ExpandableTextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/tv_feed_detail_content"
                android:tag="binding_3"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="83dp"
                app:ellipse_maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/btn_tv_comment"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:maxLines_up_limited="32"
                app:sync_state="false"
                style="@style/square_detail_content_shadow"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/rl_location_time_gallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_feed_detail_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_goneMarginBottom="12dp">
                <ImageView
                    android:id="@+id/iv_feed_location_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="4dp"
                    android:src="@drawable/icon_square_remember"
                    android:scaleType="centerCrop"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/dimen_12"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_feed_location_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/iv_feed_location_icon"/>
                <TextView
                    android:textSize="@dimen/dimen_12"
                    android:textColor="@color/white"
                    android:id="@+id/tv_feed_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/tv_feed_location_label"/>
            </RelativeLayout>
            <TextView
                android:id="@+id/tv_feed_detail_topic_name"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_marginBottom="12dp"
                android:drawableLeft="@drawable/ic_topic_left_white"
                app:layout_constraintBottom_toTopOf="@+id/rl_location_time_gallery"
                app:layout_constraintLeft_toLeftOf="parent"
                style="@style/tag_style_feed_detail"/>
            <TextView
                android:id="@+id/tv_feed_detail_tag"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/rl_location_time_gallery"
                app:layout_constraintLeft_toRightOf="@+id/tv_feed_detail_topic_name"
                app:layout_goneMarginLeft="0dp"
                style="@style/tag_style_feed_detail"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/btn_tv_comment"
                app:layout_constraintRight_toRightOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_gift"
                    android:visibility="gone"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/iv_gift_image"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/icon_feed_gift_btn"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#f8f7f7"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_gift_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="赞赏"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_recommend"
                    android:visibility="gone"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="11dp"
                    app:layout_constraintBottom_toTopOf="@+id/layout_gift"
                    app:layout_constraintRight_toRightOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.zenmen.palmchat.widget.MSVGAImageView
                            android:id="@+id/super_expose_v1_enter_from4_image"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/icon_dynamic_super_expose_v1_enter_from4_image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#f8f7f7"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="上推荐"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_feed_detail_comment_b"
                    android:tag="binding_6"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="11dp"
                    app:layout_constraintBottom_toTopOf="@+id/layout_recommend"
                    app:layout_constraintRight_toRightOf="parent">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/iv_btn_comment_feed_b"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/icon_comment_feeddetail_new"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#f8f7f7"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_feed_detail_comment_count_b"
                        android:tag="binding_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_feed_detail_praise_b"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="11dp"
                    app:layout_constraintBottom_toTopOf="@+id/layout_feed_detail_comment_b"
                    app:layout_constraintRight_toRightOf="parent">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/iv_btn_praise_feed_b"
                        android:tag="binding_8"
                        android:paddingTop="3dp"
                        android:layout_width="32dp"
                        android:layout_height="35dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#f8f7f7"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_feed_detail_praise_count_b"
                        android:tag="binding_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_say_hi_b"
                    android:tag="binding_10"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="13dp"
                    app:layout_constraintBottom_toTopOf="@+id/layout_feed_detail_praise_b"
                    app:layout_constraintRight_toRightOf="parent">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/iv_btn_say_hi_b"
                        android:tag="binding_11"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#f8f7f7"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_say_hi_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/img_feed_detail_avatar_b"
                    android:tag="binding_12"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="22dp"
                    android:scaleType="centerCrop"
                    app:border_width="1dp"
                    app:esv_shape="circle"
                    app:layout_constraintBottom_toTopOf="@+id/layout_say_hi_b"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_goneMarginBottom="20dp"/>
                <ImageView
                    android:tag="binding_13"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    app:layout_constraintBottom_toBottomOf="@+id/img_feed_detail_avatar_b"
                    app:layout_constraintRight_toRightOf="@+id/img_feed_detail_avatar_b"/>
                <com.opensource.svgaplayer.SVGAImageView
                    android:id="@+id/svga_say_hi"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="56dp"
                    app:layout_constraintLeft_toLeftOf="@+id/layout_say_hi_b"
                    app:layout_constraintRight_toRightOf="@+id/layout_say_hi_b"
                    app:layout_constraintTop_toTopOf="@+id/img_feed_detail_avatar_b"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_userinfo_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_feed_detail_tag"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_nickname_b"
                    android:tag="binding_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:singleLine="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/square_detail_content_shadow"/>
                <TextView
                    android:id="@+id/tv_official_b"
                    android:tag="binding_15"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_nickname_b"
                    app:layout_constraintLeft_toRightOf="@+id/tv_nickname_b"
                    app:layout_constraintTop_toTopOf="@+id/tv_nickname_b"
                    app:layout_goneMarginLeft="6dp"
                    style="@style/official_text_tag"/>
                <ImageView
                    android:id="@+id/iv_vip_b"
                    android:tag="binding_16"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_official_b"
                    app:layout_constraintLeft_toRightOf="@+id/tv_official_b"
                    app:layout_constraintTop_toTopOf="@+id/tv_official_b"
                    app:layout_goneMarginLeft="6dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ccffffff"
                    android:ellipsize="end"
                    android:tag="binding_17"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_nickname_b"
                    app:layout_constraintTop_toBottomOf="@+id/tv_nickname_b"
                    style="@style/square_detail_content_shadow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_content_location_second"
            android:background="@drawable/bg_square_feeddetail_bottom_info"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.zenmen.square.ui.widget.ExpandableTextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/tv_feed_detail_content_second"
                android:tag="binding_18"
                android:paddingBottom="72dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="83dp"
                app:ellipse_maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:sync_state="false"
                style="@style/square_detail_content_shadow"/>
            <RelativeLayout
                android:id="@+id/rl_location_time_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_feed_detail_content_second"
                app:layout_constraintLeft_toLeftOf="parent">
                <ImageView
                    android:id="@+id/iv_feed_location_icon_second"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="4dp"
                    android:src="@drawable/icon_square_remember"
                    android:scaleType="centerCrop"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_feed_location_label_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/iv_feed_location_icon_second"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_feed_time_label_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/tv_feed_location_label_second"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/feed_detail_title_bar"
            android:background="@drawable/bg_square_feeddetail_top_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <ImageView
                android:id="@+id/iv_back_second"
                android:tag="binding_19"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="44dp"
                android:src="@drawable/selector_arrow_white"
                android:alpha="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="44dp">
                <ImageView
                    android:id="@+id/iv_back"
                    android:tag="binding_20"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="32dp"
                    android:layout_height="44dp"
                    android:src="@drawable/selector_arrow_white"
                    android:alpha="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/btn_more"
                    android:tag="binding_21"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/ic_square_media_more_new"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_page_indicator"
                    android:background="@drawable/shape_bg_3dffffff_rect_22"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginRight="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/btn_more"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginRight="16dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_detail_wishes"
                    android:tag="binding_22"
                    android:background="@drawable/shape_feed_chat_btn_bg"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_wishes_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginRight="2dp"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#ffffff"
                        android:id="@+id/tv_wishes_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/small_gift_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/large_gift_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</RelativeLayout>
