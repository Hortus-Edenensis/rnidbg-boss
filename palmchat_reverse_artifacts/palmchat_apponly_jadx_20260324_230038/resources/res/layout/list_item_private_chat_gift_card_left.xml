<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row_rec_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/portrait">
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@color/text_color_gray"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    android:maxWidth="@dimen/list_item_text_width"
                    android:text="nameaaaaaaaaaaaaaaaaaaaddddddddddddddddaaaaaaaa"
                    android:singleLine="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_gift_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="@drawable/shape_private_chat_gift_left_card_bg_top"
                        android:paddingLeft="13dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/B3"
                                android:textColor="@color/color_84440C"
                                android:id="@+id/tv_gift_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:minWidth="105dp"
                                android:singleLine="true"/>
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="105dp">
                                <TextView
                                    android:textSize="@dimen/C2"
                                    android:textColor="@color/color_84440C"
                                    android:id="@+id/tv_sub_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="9dp"
                                    android:layout_marginBottom="13dp"
                                    android:singleLine="true"/>
                                <TextView
                                    android:textSize="@dimen/C2"
                                    android:textColor="@color/color_84440C"
                                    android:gravity="center"
                                    android:id="@+id/tv_sub_btn"
                                    android:background="@drawable/shape_private_chat_gift_card_bg_open"
                                    android:paddingLeft="12dp"
                                    android:paddingRight="12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="26dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginBottom="9dp"
                                    android:singleLine="true"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/iv_icon"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginLeft="12dp"
                            android:src="@drawable/ic_chat_flowers_private_chat_gift_card"
                            android:scaleType="centerCrop"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/C3"
                        android:textColor="@color/Gd"
                        android:id="@+id/tv_desc"
                        android:background="@drawable/shape_private_chat_gift_card_bg_bottom"
                        android:paddingLeft="12dp"
                        android:paddingTop="3dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/audio_read"
                android:background="@drawable/red_circle"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginLeft="7dp"
                android:layout_toRightOf="@+id/row_rec_location"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
