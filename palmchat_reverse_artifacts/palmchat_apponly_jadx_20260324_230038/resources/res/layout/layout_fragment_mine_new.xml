<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mine_frame_layout"
    android:background="@drawable/mine_backgroud"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/mine_bar_layout"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_alignParentRight="true"
        android:transitionName="actionBar">
        <ImageView
            android:id="@+id/mine_bar_wallet"
            android:paddingRight="13dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/mine_bar_wallet"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/mine_bar_setting"
            android:paddingRight="13dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/mine_bar_setting"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/mine_bar_myfirends_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/mine_bar_myfirends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/mine_my_friend"/>
            <View
                android:id="@+id/mine_bar_myfirends_dot"
                android:background="@drawable/red_circle_lbs_notify"
                android:visibility="gone"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignEnd="@+id/mine_bar_myfirends"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-5dp"
        android:layout_below="@+id/mine_bar_layout">
        <com.zenmen.palmchat.utils.CustomScrollView
            android:id="@+id/rootScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/contentLayout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:splitMotionEvents="false"/>
        </com.zenmen.palmchat.utils.CustomScrollView>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/decor_guide_bubble_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/mine_bar_layout">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/decor_guide_bubble"
            android:background="@drawable/ic_portrait_decor_bubble_new"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="19dp"
            android:text="领取个性头像挂件"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/vipKefu"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="94dp"
        android:layout_marginBottom="50dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_vip_my_tab_guide"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:layout_width="74dp"
            android:layout_height="22dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="#673203"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/vip_guide_tv"
                android:background="@drawable/ic_vip_my_guide_txt_bg"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:layout_width="74dp"
                android:layout_height="22dp"
                android:text="会员专属客服"/>
            <ImageView
                android:id="@+id/vip_flash"
                android:background="@drawable/ic_vipi_my_guide_text_flash"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="22dp"/>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>
