<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/people_match_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/default_portrait"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/people_match_profile_dot"
        android:background="@drawable/people_match_message_badge_bg"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:layout_constraintRight_toRightOf="@+id/people_match_avatar"
        app:layout_constraintTop_toTopOf="@+id/people_match_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
