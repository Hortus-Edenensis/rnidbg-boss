<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selector_thread_item_background"
    android:paddingLeft="16dp"
    android:paddingTop="9dp"
    android:paddingRight="16dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/default_portrait"
            app:esv_shape="circle"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="17dp"
                    android:textColor="#222222"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/main_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxWidth="180dp"
                    android:singleLine="true"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="62dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/chat_mate_msg_list_bg"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#cccccc"
                android:gravity="center_vertical"
                android:layout_gravity="right"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:text="时间"
                android:singleLine="true"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#ff3984"
                android:ellipsize="end"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:maxWidth="225dp"
                android:singleLine="true"/>
            <TextView
                android:textColor="@color/Ab"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/notification_red_dot"
                android:background="@drawable/red_circle"
                android:paddingBottom="0.5dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_18"
                android:minWidth="@dimen/dimen_18"
                android:text="1"
                style="@style/main_tab_unread_text"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
