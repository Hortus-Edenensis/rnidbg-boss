<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_update_bg"
    android:paddingBottom="20dp"
    android:layout_width="320dp"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/dialog_update_icon"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#999999"
        android:gravity="left"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="24dp"
        android:text="content is xxx"/>
    <FrameLayout
        android:background="@drawable/selector_big_button_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="22dp">
        <ProgressBar
            android:id="@+id/update_dialog_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            style="@style/ButtonProgressBar"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/buttonPositive"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
    </FrameLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="#666666"
        android:layout_gravity="center_horizontal"
        android:id="@+id/buttonNegative"
        android:paddingTop="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
