<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button2"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_tiny"
                android:textColor="@color/text_color_999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:layout_marginTop="17dp"
                android:text="@string/add_contact_empty_des"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/add_contact_from_phone1"
            android:background="@color/color_FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_below="@+id/search_area">
            <TextView
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/text_color_black"
                android:gravity="center_vertical"
                android:background="@drawable/selector_settings_item_background"
                android:paddingLeft="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/contact_add_phone_contact"
                android:drawableLeft="@drawable/icon_menu_add2_circle"
                android:drawablePadding="10dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/content_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <ListView
            android:gravity="top"
            android:id="@+id/contact_request_list"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:stackFromBottom="false"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000"
            android:divider="@color/transparent"
            android:dividerHeight="0px"/>
    </RelativeLayout>
</RelativeLayout>
