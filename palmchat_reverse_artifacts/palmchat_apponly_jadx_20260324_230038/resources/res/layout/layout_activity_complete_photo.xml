<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_recommend"/>
    <TextView
        android:textSize="@dimen/text_size_22"
        android:textColor="@color/big_text_color"
        android:ellipsize="end"
        android:id="@+id/tv_text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="31dp"
        android:layout_marginRight="30dp"
        android:text="@string/login_reg_portrait_title"
        android:maxLines="1"
        android:layout_below="@+id/toolbar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="#6f6f6f"
        android:ellipsize="end"
        android:id="@+id/tv_text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="30dp"
        android:text="@string/login_reg_portrait_subtitle"
        android:maxLines="1"
        android:layout_below="@+id/tv_text_title"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/AvatarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="26dp"
        android:layout_below="@+id/tv_text_subtitle">
        <ImageView
            android:id="@+id/take_photo"
            android:clickable="true"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_login_avatar_big_bg"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/AvatarContainer">
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_next"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="35dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="12dp"
            android:text="结识新朋友"
            android:layout_centerHorizontal="true"
            style="@style/btn_tint_green_solid"/>
    </RelativeLayout>
</RelativeLayout>
