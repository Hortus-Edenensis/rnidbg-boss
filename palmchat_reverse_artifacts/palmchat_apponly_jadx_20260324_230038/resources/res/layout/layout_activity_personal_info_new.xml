<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_activity_personal_info_new_0"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_profile_edit"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="我的照片"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/avatarList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="12dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4"/>
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/avatarEdit"
                        android:background="@drawable/bg_edit_profile_btn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginLeft="48dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="48dp"
                        android:layout_marginBottom="20dp"
                        android:text="+ 编辑照片"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="基本信息"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="昵称"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="性别"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/birthday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="生日"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="个性签名"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="17dp"
                        android:textColor="#222222"
                        android:textColorHint="#ccc"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/signature"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="一个人的生活充斥着无趣。一个人的生活充斥着无趣。"
                        android:hint="暂未填写"
                        android:singleLine="true"
                        android:drawableLeft="@drawable/ic_edit_profile_signature"
                        android:drawablePadding="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="交友资料"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/intentions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="交友意愿"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/occupation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="职业"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/income"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="月收入"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/hometown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="家乡"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/house"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="房产"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/car"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="车产"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="我的动态"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/feedList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="12dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4"/>
                    <TextView
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/editFeed"
                        android:background="@drawable/bg_edit_profile_btn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginLeft="48dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="48dp"
                        android:layout_marginBottom="20dp"
                        android:text="+ 发布新动态"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="我的标签"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/personalityCharacteristics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="我的个性"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/likePersonalityCharacteristics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="我喜欢的个性"/>
                    <com.zenmen.palmchat.widget.CommonInfoCellView
                        android:id="@+id/fond"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:infoCellLabelHint="待设置"
                        app:infoCellRedDot="false"
                        app:infoCellTitle="我的喜好"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="我的兴趣爱好"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="17dp"
                        android:textColor="#222222"
                        android:textColorHint="#ccc"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/hobby"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="一个人的生活充斥着无趣。一个人的生活充斥着无趣。"
                        android:hint="暂未填写"
                        android:singleLine="true"
                        android:drawableLeft="@drawable/ic_edit_profile_signature"
                        android:drawablePadding="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
