<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@color/settings_background_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/notify_tips_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/message_notify_permission_disable"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_color_999"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/notify_tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_message_notify_tips"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/selector_settings_item_background"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="30dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/settings_item_notify"
            android:layout_marginRight="@dimen/settings_item_notify"
            android:text="@string/settings_message_notify_switch"
            style="@style/settings_item_text"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.zenmen.palmchat.widget.ZXCheckBox
            android:id="@+id/notify_checkbox"
            android:layout_marginLeft="@dimen/settings_item_notify"
            android:layout_marginRight="@dimen/settings_item_notify"
            android:button="@drawable/selector_checkbox_background"
            style="@style/settings_checkbox_size"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/settings_item_notify"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/settings_item_notify"
        android:text="@string/settings_message_notify_permission_des"
        style="@style/personal_text_gray"/>
</LinearLayout>
