<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom|center_horizontal"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/dialog_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/super_expose_dialog_bg_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="95dp">
            <ImageView
                android:id="@+id/all_bg_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/super_expose_dialog_all_bg"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/all_show_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/title_img"
                    android:layout_width="95dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="38dp"
                    android:src="@drawable/super_expose_dialog_title_img_new"
                    android:scaleType="fitXY"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="40dp">
                    <FrameLayout
                        android:id="@+id/buyButton"
                        android:layout_width="280dp"
                        android:layout_height="44dp"
                        android:layout_centerHorizontal="true"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/bug_img_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/super_expose_dialog_buy_bg_new"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/bug_text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="获取特权"
                            android:maxLines="1"/>
                    </FrameLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/privacy_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="4dp"
                        android:src="@drawable/ic_super_expose_dialog_privacy"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="@+id/bug_info_text1"
                        app:layout_constraintEnd_toStartOf="@+id/bug_info_text1"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/bug_info_text1"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#999999"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/bug_info_text1"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginTop="12dp"
                        android:text="我已阅读并同意"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        app:layout_constraintEnd_toStartOf="@+id/bug_info_text2"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@+id/privacy_iv"
                        app:layout_constraintTop_toBottomOf="@+id/buyButton"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#2b94fa"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/bug_info_text2"
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="12dp"
                        android:text="《超级曝光付费说明》"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@+id/bug_info_text1"
                        app:layout_constraintTop_toBottomOf="@+id/buyButton"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#fff"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/pop_tv"
                        android:background="@drawable/ic_super_expose_privacy_pop"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="请阅读并同意"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        app:layout_constraintBottom_toTopOf="@+id/privacy_iv"
                        app:layout_constraintLeft_toLeftOf="@+id/privacy_iv"
                        app:layout_constraintRight_toRightOf="@+id/privacy_iv"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="right"
                android:id="@+id/super_redpkg_all_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:layout_marginRight="12dp">
                <com.opensource.svgaplayer.SVGAImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/super_redpkg_img"
                    android:layout_width="43dp"
                    android:layout_height="57dp"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/super_redpkg_time"
                    android:background="@drawable/bg_super_redpkg_time"
                    android:layout_width="56dp"
                    android:layout_height="18dp"
                    android:text="00:00:00"/>
            </FrameLayout>
        </FrameLayout>
        <ImageView
            android:id="@+id/sex_img"
            android:layout_width="320dp"
            android:layout_height="132dp"
            android:src="@drawable/super_expose_dialog_sex_w_bg"
            android:scaleType="fitXY"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:id="@+id/dialog_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="94dp"
            android:layout_alignParentRight="true">
            <ImageView
                android:background="@drawable/super_expose_dialog_close"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="20dp"/>
        </FrameLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/roll_loop_layout"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="2dp"
        android:layout_above="@+id/dialog_bottom_layout"/>
</RelativeLayout>
