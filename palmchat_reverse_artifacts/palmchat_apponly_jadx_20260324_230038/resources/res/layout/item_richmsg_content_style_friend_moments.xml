<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/selector_richmsg_subitem_background"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/moments_with_pic_area"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/moments_large_cover"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:src="@drawable/ic_default_portrait"
                android:scaleType="centerCrop"
                android:layout_alignParentRight="true"
                app:esv_shape="round_rectangle"
                app:radius_x_dp="4dp"
                app:radius_y_dp="4dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/shape_cover_bg_richmsg_img_desc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignBottom="@+id/moments_large_cover">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/moments_photos_small"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_default_portrait"
                    android:scaleType="centerCrop"
                    app:esv_shape="circle"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/B3"
                            android:textColor="@color/Ab"
                            android:ellipsize="end"
                            android:id="@+id/moments_nickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="125dp"
                            android:text="名字"
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="@dimen/C2"
                            android:textColor="@color/Ge"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/moments_publish_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:text="2018年12月13号"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/C2"
                        android:textColor="@color/Ab"
                        android:id="@+id/moments_publish_content"
                        android:paddingRight="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="发布了一条状态发布了一条状态发布了一条状态发布了一条状态发布了一条状态发布了一条状态发布了一条状态发布了一条状态发布了一条状态"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_color_ffffff"
                android:gravity="center"
                android:id="@+id/moments_pic_index"
                android:background="@drawable/moments_shape_gray_img_index"
                android:layout_width="23dp"
                android:layout_height="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:text="1/5"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/moments_video_ic"
                android:visibility="visible"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:src="@drawable/ic_moment_notice_video"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/moments_no_pic_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/moments_text_photo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_default_portrait"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/moments_text_name_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:maxWidth="250dp"
                android:text="11:21211212212122121211212121212122121211"
                android:maxLines="2"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:id="@+id/moments_text_share_url"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="4dp"
                android:text="[分享链接]"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/text_color_999"
                android:id="@+id/moments_text_publish_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="4dp"
                android:text="2018年12月13号"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black"
                android:id="@+id/moments_text_publish_content"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="4dp"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
