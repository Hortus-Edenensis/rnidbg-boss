<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.square.ui.widget.SelectTabHeaderView
        android:id="@+id/square_main_head_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/square_main_head_view">
        <com.google.android.material.appbar.AppBarLayout
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="scroll">
                <com.zenmen.square.ui.widget.PostBar
                    android:id="@+id/public_progress"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/square_user_guid_tiezi_layout"
                    android:background="@drawable/square_guide_user_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_margin="16dp">
                    <ImageView
                        android:id="@+id/square_user_guid_tiezi_image"
                        android:layout_width="44dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#33412a"
                            android:ellipsize="end"
                            android:id="@+id/square_user_guid_tiezi_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#6e776f"
                            android:ellipsize="end"
                            android:id="@+id/square_user_guid_tiezi_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:maxLines="1"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="5dp"
                        android:layout_height="10dp"
                        android:src="@drawable/square_user_guid_tiezi_image"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/square_fragment_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/> /&gt; 
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <ImageView
        android:id="@+id/rl_square_yunying_guide_Image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/square_main_head_view"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:id="@+id/rl_square_guide_publish_float"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_below="@+id/square_main_head_view"
        android:layout_alignParentRight="true">
        <RelativeLayout
            android:id="@+id/square_guide_publish_float_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/v_icon_guide_float_up"
                android:background="@drawable/icon_square_guide_float_up"
                android:layout_width="12.8dp"
                android:layout_height="8dp"
                android:layout_marginRight="36.2dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:background="@drawable/shape_light_green_rectangle_round_corner_big"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="201dp"
                android:layout_height="68dp"
                android:text="@string/square_publish_guide_float_text"
                android:layout_below="@+id/v_icon_guide_float_up"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/square_guide_publish_float_red"
            android:background="@drawable/ic_square_publish_guide_bg_new"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:id="@+id/square_guide_publish_tv"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/square_profile_location_guide"
        android:background="@color/white"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_below="@+id/square_main_head_view">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bg_square_guide_big_logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerInside"
            android:layout_weight="1"/>
        <RelativeLayout
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="269dp">
            <TextView
                android:id="@+id/btn_profile_location_guide"
                android:layout_width="260dp"
                android:layout_height="48dp"
                android:layout_marginBottom="49dp"
                android:text="@string/square_btn_guide_text_profile"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                style="@style/btn_green_solid_new"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#aaaaaa"
                android:gravity="center_horizontal"
                android:id="@+id/tv_guide_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="74dp"
                android:text="@string/square_welcome_summary"
                android:layout_above="@+id/btn_profile_location_guide"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="24dp"
                android:gravity="center_horizontal"
                android:id="@+id/tv_guide_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/square_welcome"
                android:layout_above="@+id/tv_guide_summary"
                android:layout_centerHorizontal="true"
                style="@style/blackStyle"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sys_location_server_layout"
        android:background="@drawable/shape_black_corner_20dp_trans"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="5dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/tips_open_sys_location_service"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/sys_location_service_setting"
            android:background="@drawable/selector_btn_green"
            android:paddingLeft="9dp"
            android:paddingTop="4dp"
            android:paddingRight="9dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="15dp"
            android:text="@string/open_sys_location_service"
            android:singleLine="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_close_sys_location_service_tips"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_close_location_service_tips"/>
    </LinearLayout>
    <com.zenmen.square.ui.widget.BottomGuideView
        android:id="@+id/layout_square_permission_guide_v2"
        android:background="#e7f4ef"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42dp"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/iv_go_top"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="14dp"
        android:src="@drawable/icon_square_go_top"
        android:layout_above="@+id/layout_square_permission_guide_v2"
        android:layout_alignParentRight="true"/>
    <FrameLayout
        android:id="@+id/voice_match_bubble_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="90dp"
        android:layout_above="@+id/layout_square_permission_guide_v2"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/small_gift_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/large_gift_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</RelativeLayout>
