<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_vertical"
        android:id="@+id/contentCard"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="106dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="50dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="false"
        app:contentPadding="0dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="#333"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="遇到问题，需要反馈？"/>
            <ImageView
                android:id="@+id/image"
                android:layout_width="94dp"
                android:layout_height="99dp"
                android:layout_marginTop="6dp"
                android:src="@drawable/ic_apk"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333"
                android:gravity="center"
                android:id="@+id/share"
                android:background="@drawable/bg_screenshot_pop_btn"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="分享截图"
                android:drawableLeft="@drawable/ic_screenshot_pop_share"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333"
                android:gravity="center"
                android:id="@+id/kefu"
                android:background="@drawable/bg_screenshot_pop_btn"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="联系客服"
                android:drawableLeft="@drawable/ic_screenshot_pop_kefu"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
