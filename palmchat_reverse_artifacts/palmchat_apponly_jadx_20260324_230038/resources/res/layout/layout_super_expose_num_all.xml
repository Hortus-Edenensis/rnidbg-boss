<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:tag="layout/layout_super_expose_num_all_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:background="@drawable/super_expose_msg_tab_a_all_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/toolbar"
            layout="@layout/layout_toolbar"/>
        <FrameLayout
            android:id="@+id/super_num_buy_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:id="@+id/count_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="她们"
                            android:lines="1"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/super_num_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="200dp"
                            android:text="正在找人聊天"
                            android:lines="1"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#14cd64"
                            android:gravity="center"
                            android:id="@+id/super_num_text_dialog"
                            android:background="@drawable/super_expose_num_dialog_text_bg"
                            android:visibility="gone"
                            android:layout_width="58dp"
                            android:layout_height="28dp"
                            android:layout_marginLeft="14dp"
                            android:text="曝光中"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#c3c3c3"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/super_sub_title"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:maxWidth="253dp"
                        android:text="主动就有故事，快去打个招呼吧！"
                        android:lines="1"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/super_num_show_dialog"
                android:background="@drawable/super_num_show_bg"
                android:layout_width="91dp"
                android:layout_height="41dp"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#222222"
            android:id="@+id/super_expose_num_mind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="智能排序"
            android:includeFontPadding="false"/>
        <View
            android:background="#c3c3c3"
            android:layout_width="0.5dp"
            android:layout_height="12dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#999999"
            android:id="@+id/super_expose_num_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距离优先"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/mind_distance_recycler_no_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:background="@drawable/super_num_no_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="132dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="暂无更多曝光用户"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/mind_distance_recycler_all_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/mind_all_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/mind_super_content_failed"
                    android:paddingLeft="49dp"
                    android:paddingRight="49dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="143dp"
                        android:src="@drawable/super_num_no_bg"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="加载失败，点击刷新"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mind_super_expose_num_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/distance_all_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/distance_super_content_failed"
                    android:paddingLeft="49dp"
                    android:paddingRight="49dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="143dp"
                        android:src="@drawable/super_num_no_bg"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="加载失败，点击刷新"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/distance_super_expose_num_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
