<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="105dp">
    <ImageView
        android:id="@+id/iv_check"
        android:background="@drawable/shape_gift_item_selected_bg_light_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rl_icon"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/tv_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/C2"
        android:textColor="@color/Gb"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:text="礼物名称"
        android:lines="1"
        android:maxLength="6"
        android:layout_below="@+id/rl_icon"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="-1dp"
        android:layout_below="@+id/tv_name"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_money"
            android:paddingTop="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lianxindou_10"/>
        <TextView
            android:textSize="@dimen/C3"
            android:textColor="@color/Gg"
            android:id="@+id/tv_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text="10"
            android:lines="1"
            android:layout_centerHorizontal="true"/>
        <com.zenmen.palmchat.giftkit.widgit.RedDeleteLineText
            android:textSize="@dimen/C3"
            android:textColor="@color/Gd"
            android:id="@+id/tv_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:lines="1"
            android:layout_centerHorizontal="true"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/C3"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:background="@drawable/shape_gift_tag_bg_style1"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:text="SVIP"/>
    <TextView
        android:textSize="@dimen/C3"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_num"
        android:background="@drawable/shape_ff6262_radius_8"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:text="x12"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:id="@+id/rl_continue"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="88dp"
        android:layout_centerInParent="true">
        <com.zenmen.palmchat.giftkit.widgit.CircleProgressView
            android:id="@+id/pg_continue"
            android:background="@drawable/bg_gift_hit_progress"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerInParent="true"
            app:location_start="top"
            app:progress_color="#ffe593"
            app:progress_width="2dp"/>
        <TextView
            android:textSize="@dimen/B3"
            android:textStyle="bold"
            android:textColor="@color/Da"
            android:id="@+id/tv_hit_number"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="x1"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
