<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/color_photo_grid_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button2"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="@color/sub_gray"
        android:id="@+id/no_photo_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:text="@string/no_photo"
        android:layout_centerHorizontal="true"/>
    <GridView
        android:gravity="center"
        android:id="@+id/photo_grid_view"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="3dp"
        android:listSelector="@android:color/transparent"
        android:horizontalSpacing="3dp"
        android:verticalSpacing="3dp"
        android:stretchMode="columnWidth"
        android:columnWidth="0dp"
        android:numColumns="3"
        android:minHeight="50dp"
        android:layout_below="@+id/toolbar"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/date_text"
        android:background="#80000000"
        android:paddingLeft="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/toolbar"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_tool_bar"
        android:background="@color/bottom_tool_bar_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:minHeight="@dimen/title_bar_height"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/bottom_tool_item_forward"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_forward"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/bottom_tool_item_delete"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_delete"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/bottom_tool_item_download"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_download"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
