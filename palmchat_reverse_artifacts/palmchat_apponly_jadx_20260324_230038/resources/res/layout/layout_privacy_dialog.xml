<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_privacy_dialog"
        android:layout_width="320dp"
        android:layout_height="450dp">
        <TextView
            android:textSize="@dimen/B1"
            android:textStyle="bold"
            android:textColor="@color/Gb"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/login_privacy_dialog_title"
            android:maxLines="1"/>
        <ScrollView
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp"
            android:overScrollMode="never">
            <TextView
                android:textSize="@dimen/B3"
                android:textColor="@color/Gd"
                android:id="@+id/content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_dialog_content"
                android:lineSpacingMultiplier="1.3"/>
        </ScrollView>
        <TextView
            android:id="@+id/btn_agree"
            android:layout_width="224dp"
            android:layout_height="48dp"
            android:layout_marginTop="26dp"
            android:text="@string/login_privacy_dialog_btn_agree"
            style="@style/big_button_green"/>
        <TextView
            android:textSize="@dimen/C1"
            android:textColor="@color/Gd"
            android:gravity="center"
            android:id="@+id/btn_deny"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/login_privacy_dialog_btn_deny"/>
    </LinearLayout>
</LinearLayout>
