<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_gift_info"
        android:background="@drawable/shape_gift_play_item_gb"
        android:paddingLeft="4dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/iv_user_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"
            app:esv_shape="circle"
            app:radius_x_dp="10dp"
            app:radius_y_dp="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:id="@+id/tv_username"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/C1"
                android:textColor="#84440c"
                android:id="@+id/tv_gift_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_gift_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_gift_show_default"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_gift_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="italic|bold"
                android:textColor="#84440c"
                android:id="@+id/tv_multiplication_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x "
                android:singleLine="true"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="italic|bold"
                android:textColor="#84440c"
                android:id="@+id/tv_gift_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
