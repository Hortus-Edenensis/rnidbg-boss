<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:paddingTop="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/mine_lifesyle_title_layout"
        android:background="@color/white"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:splitMotionEvents="false">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/Gb"
            android:id="@+id/mine_lifestyle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的生活方式"
            android:drawablePadding="5dp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/mine_lifestyle_edit"
            android:paddingLeft="5dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:src="@drawable/mine_lifestyle_edit"
            android:layout_toRightOf="@+id/mine_lifestyle_title"
            android:layout_alignBottom="@+id/mine_lifestyle_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#666666"
            android:id="@+id/mine_lifestyle_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="展开"
            android:drawableRight="@drawable/mine_lifestyle_open"
            android:drawablePadding="4dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.zenmen.square.ui.widget.SquareTagSummaryHelper
        android:id="@+id/mine_lifesyle_tag_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="4dp"
        android:layout_below="@+id/mine_lifesyle_title_layout"/>
</RelativeLayout>
