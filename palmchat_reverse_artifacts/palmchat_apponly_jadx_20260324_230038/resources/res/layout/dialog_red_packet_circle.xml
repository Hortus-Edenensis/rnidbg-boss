<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="308dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/icon_circle_redpacket_bg"
        android:layout_width="match_parent"
        android:layout_height="394dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/circle_red_packet_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"
            app:esv_shape="circle"
            app:layout_constraintEnd_toStartOf="@+id/circle_red_packet_nickname"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ff754f1d"
            android:ellipsize="end"
            android:id="@+id/circle_red_packet_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:maxWidth="200dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/circle_red_packet_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/circle_red_packet_avatar"
            app:layout_constraintTop_toTopOf="@+id/circle_red_packet_avatar"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ff754f1d"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/circle_red_packet_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:singleLine="true"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@+id/circle_red_packet_avatar"/>
        <TextView
            android:textSize="22dp"
            android:textColor="#ff754f1d"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/circle_red_packet_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:maxLines="2"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toBottomOf="@+id/circle_red_packet_subtitle"/>
        <ImageView
            android:id="@+id/circle_red_packet_open"
            android:layout_width="92dp"
            android:layout_height="93dp"
            android:layout_marginBottom="73dp"
            android:src="@drawable/icon_circle_red_packet_open"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fffda9a6"
            android:id="@+id/circle_red_packet_go_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="查看领取详情"
            android:drawableRight="@drawable/icon_circle_red_packet_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/circle_red_packet_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@drawable/icon_circle_red_packet_close"/>
</LinearLayout>
