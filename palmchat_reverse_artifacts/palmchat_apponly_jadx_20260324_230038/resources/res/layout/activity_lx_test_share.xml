<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_txt"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="纯文本"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_web"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="链接"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_web"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_image"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="图片"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_namecard"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="名片"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_namecard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
        <CheckBox
            android:id="@+id/chk_lxNameCard"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_topic"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="话题"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_topic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
        <CheckBox
            android:id="@+id/chk_lxTopic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_rank"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="排行榜"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_sm"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="小视频"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
        <CheckBox
            android:id="@+id/chk_lxVideo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <RadioButton
                android:id="@+id/rbtn_def"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:checked="true"
                android:text="视频"/>
            <RadioButton
                android:id="@+id/rbtn_namecard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="名片"/>
            <RadioButton
                android:id="@+id/rbtn_topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="话题"/>
            <RadioButton
                android:id="@+id/rbtn_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="排行榜"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_share_miniapp"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="小程序"
            android:onClick="onClick"/>
        <CheckBox
            android:id="@+id/chk_miniapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朋友圈"/>
    </LinearLayout>
</LinearLayout>
