<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_match_call_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/video_call_icon_loading_fail_bg"
            android:scaleType="centerCrop"/>
        <TextureView
            android:id="@+id/video_screen_render_sv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/video_window_render_fl"
            android:background="@drawable/bg_float_window_voice"
            android:visibility="visible"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:layout_marginTop="104dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="20dp">
            <ImageView
                android:id="@+id/background_fl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/video_call_icon_loading_fail_bg"
                android:scaleType="centerCrop"/>
            <TextureView
                android:id="@+id/video_window_render_sv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/video_info_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/audio_headimage_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="144dp"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/A2"
                android:textStyle="bold"
                android:textColor="@color/Ab"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/audio_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="dadsfasdfasdfasdffa"
                android:singleLine="true"
                android:shadowColor="@color/black"
                android:shadowRadius="2"/>
            <TextView
                android:textSize="@dimen/B2"
                android:textColor="@color/Ab"
                android:layout_gravity="center_horizontal"
                android:id="@+id/calling_hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="dadsfasdfasdfasdffa"
                android:shadowColor="@color/black"
                android:shadowRadius="2"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/top_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="16dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/user_info_layout"
                android:background="@drawable/voice_match_head_info_bg"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/user_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_default_portrait"
                    android:scaleType="centerCrop"
                    app:esv_shape="circle"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#fff"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:maxWidth="130dp"
                    android:text="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                    android:singleLine="true"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/info_report"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="50dp"
                android:src="@drawable/ic_video_match_top_report"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/info_float"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_video_match_top_float"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/risk_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/top_layout">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="none"
                android:id="@+id/risk_tv"
                android:background="@drawable/voice_match_secure_notice_bg"
                android:padding="10dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统检测到对方言论可能涉及违规，如有不适，请立即投诉。"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="40dp"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/silence_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/silence_iv"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_vm_silence_normal"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#fff"
                    android:id="@+id/silence_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="麦克风已开"
                    android:shadowColor="@color/black"
                    android:shadowRadius="2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/speaker_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/speaker_iv"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_vm_speaker_normal"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#fff"
                    android:id="@+id/speaker_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="扬声器已开"
                    android:shadowColor="@color/black"
                    android:shadowRadius="2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/publish_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/publish_iv"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_video_match_btn_publish"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#fff"
                    android:id="@+id/publish_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="公开资料"
                    android:shadowColor="@color/black"
                    android:shadowRadius="2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hangup_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/hangup_iv"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_video_match_btn_hangup"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#fff"
                    android:id="@+id/hangup_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="挂断"
                    android:shadowColor="@color/black"
                    android:shadowRadius="2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/accept_layout"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/accept_iv"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_re_voip_accept"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#222"
                    android:id="@+id/accept_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="接听"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:id="@+id/info_during"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="00:00"
            android:layout_above="@+id/button_layout"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/info_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="当前通话连接质量不佳"
            android:layout_above="@+id/info_during"
            android:layout_centerHorizontal="true"/>
        <com.zenmen.palmchat.widget.GradientAlphaFrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="103dp"
            android:layout_marginBottom="50dp"
            android:layout_above="@+id/info_during"
            app:gradientTopHeight="50dp">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="bottom"
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="200dp"/>
        </com.zenmen.palmchat.widget.GradientAlphaFrameLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/preview_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/preview_back"
            android:paddingLeft="16dp"
            android:paddingRight="8dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_voice_match_back_video"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/preview_des"
            android:background="@drawable/voice_match_common_info_bg"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="68dp"
            android:layout_marginRight="68dp"
            android:layout_marginBottom="178dp"
            android:text="对方已同意邀请，即将进入视频通话页面，请你整理仪容仪表，注意文明聊天。"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/preview_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="286dp"
            android:text="5s…"
            android:shadowColor="#88000000"
            android:shadowRadius="2"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/finish_layout"
        android:background="@drawable/voice_match_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="40dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/back"
                android:paddingLeft="16dp"
                android:paddingRight="8dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_voice_match_back"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/report_iv"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/ic_vm_report"/>
                <ImageView
                    android:id="@+id/float_iv"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_vm_mini"/>
            </LinearLayout>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语音速配"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/finish_user_icon"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="34dp"
            android:src="@drawable/ic_default_portrait"
            android:scaleType="centerCrop"
            app:esv_shape="circle"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#222"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/finish_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="AAAAAAAAAA"
            android:singleLine="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#999"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/finish_during"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="通话时间00:30，继续匹配吧~"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/voice_match_comment_bg"
            android:layout_width="208dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#999"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/finish_comment_bad"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="不满意"
                android:singleLine="true"
                android:drawableLeft="@drawable/ic_vm_comment_bad"
                android:layout_weight="1"/>
            <View
                android:background="#f5f5f5"
                android:layout_width="1dp"
                android:layout_height="24dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#999"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/finish_comment_good"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="还不错"
                android:singleLine="true"
                android:drawableLeft="@drawable/ic_vm_comment_good"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.zenmen.palmchat.framework.bridge.voicomatch.MatchPropInfoCardView
            android:id="@+id/rematch_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</FrameLayout>
