<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_close"
        android:paddingLeft="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:src="@drawable/ic_permission_dialog_close"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/md_dialog_frame_margin"
        android:paddingRight="@dimen/md_dialog_frame_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/title_bar_title_text_size"
            android:textColor="#484a50"
            android:gravity="left"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_dialog_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/permission_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_content_padding_top"
            android:layout_marginBottom="@dimen/md_content_padding_bottom"/>
    </LinearLayout>
</LinearLayout>
