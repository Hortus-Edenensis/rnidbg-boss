<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_25"
        android:textColor="@color/big_text_color"
        android:id="@+id/tv_text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="10dp"
        android:text="请完善个人信息"
        android:maxLines="1"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="#999999"
        android:id="@+id/tv_text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="6dp"
        android:text="我们会为你推荐合适的内容和好友"
        android:maxLines="1"
        android:layout_below="@+id/tv_text_title"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="@color/black"
        android:id="@+id/tv_gender_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="40dp"
        android:text="选择性别"
        android:maxLines="1"
        android:layout_below="@+id/tv_text_subtitle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/genderContainer"
        android:background="@drawable/shape_complete_gender_bg_normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/tv_gender_title"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="18dp"
            android:id="@+id/btn_male"
            android:paddingLeft="32dp"
            android:paddingTop="9dp"
            android:paddingRight="42dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            style="@style/btn_complete_gender_male"/>
        <TextView
            android:textSize="18dp"
            android:id="@+id/btn_female"
            android:paddingLeft="32dp"
            android:paddingTop="9dp"
            android:paddingRight="42dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:layout_alignParentRight="true"
            style="@style/btn_complete_gender_female"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="@color/black"
        android:id="@+id/tv_birthday_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="40dp"
        android:text="选择生日"
        android:maxLines="1"
        android:layout_below="@+id/genderContainer"/>
    <com.zenmen.palmchat.widget.picker.wheel.DateWheelPicker
        android:id="@+id/birthday_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="8dp"
        android:layout_below="@+id/tv_birthday_title"
        app:wheel_items="7"/>
    <TextView
        android:textSize="@dimen/text_size_tiny"
        android:textColor="#999999"
        android:id="@+id/birthday_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/birthday_minimum_limited"
        android:maxLines="1"
        android:layout_below="@+id/birthday_view"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btn_next"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="57dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="57dp"
        android:text="@string/next_step"
        android:layout_below="@+id/birthday_tip"
        android:layout_centerHorizontal="true"
        style="@style/btn_green_solid"/>
</RelativeLayout>
