<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <FrameLayout
                android:id="@+id/image_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_location_height"
                android:layout_marginLeft="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                android:layout_marginTop="@dimen/chat_item_portrait_view_size_margin_right_top"
                android:layout_marginRight="@dimen/chat_item_portrait_margin_left_or_right"
                android:layout_toLeftOf="@+id/portrait">
                <com.zenmen.palmchat.location.LocationImageView
                    android:id="@+id/location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginRight="0dp"
                    android:scaleType="centerCrop"
                    app:side="right"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:id="@+id/location_text_area"
                    android:paddingLeft="7dp"
                    android:paddingTop="2dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@android:color/white"
                        android:ellipsize="end"
                        android:id="@+id/message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"/>
                    <TextView
                        android:textSize="@dimen/text_size_tiny2"
                        android:textColor="@android:color/white"
                        android:ellipsize="end"
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"/>
                </LinearLayout>
                <View
                    android:id="@+id/image_click_area"
                    android:background="@drawable/selector_message_mask_right_item_background"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/map_loaction_find_people_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginLeft="@dimen/chat_conetnt_margin_left_or_right_no_padding"
                android:layout_marginTop="8dp"
                android:layout_toLeftOf="@+id/portrait"
                android:layout_below="@+id/image_container">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#00c85a"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/map_location_find_people_text_num"
                    android:background="@drawable/map_location_find_people_right_bg"
                    android:paddingLeft="19dp"
                    android:paddingRight="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="7dp"
                    android:maxWidth="200dp"
                    android:text="附近99人活跃，查看详情 &gt;"
                    android:lines="1"/>
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/map_location_find_people_left_bg"
                    android:scaleType="fitXY"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/status_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/image_container"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/status_pending"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/custom_progress_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListProgressIndicator"/>
                <ImageView
                    android:id="@+id/status_fail"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/icon_message_status_retry"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/ChatListStatusIndicator"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
