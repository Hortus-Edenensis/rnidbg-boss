<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/edit_text_hint_color"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/net_unavailable_connect"
            style="@style/text_net_unavailable"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/net_unavailable_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/net_unavailable_device"
            style="@style/text_net_unavailable"/>
        <View
            android:background="@color/text_color_gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"/>
        <View
            android:background="@color/login_hint_text_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="15dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/net_unavailable_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/net_unavailable_tips"
            style="@style/text_net_unavailable"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp">
            <View
                android:background="@drawable/gray_circle"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/net_unavailable_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_unavailable_tips_fir"
                android:lineSpacingExtra="4dp"
                style="@style/text_net_unavailable"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="4dp">
            <View
                android:background="@drawable/gray_circle"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/net_unavailable_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_unavailable_tips_sec"
                android:lineSpacingExtra="4dp"
                style="@style/text_net_unavailable"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/net_unavailable_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/net_unavailable_tip"
            style="@style/text_net_unavailable"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp">
            <View
                android:background="@drawable/gray_circle"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/net_unavailable_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_unavailable_tip_fir"
                android:lineSpacingExtra="4dp"
                style="@style/text_net_unavailable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
