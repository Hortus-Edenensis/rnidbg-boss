<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:paddingRight="16dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.LXPortraitView
        android:id="@+id/head_img"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:src="@drawable/default_portrait"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        app:esv_shape="round_rectangle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@+id/head_img">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="13dp"
                android:layout_weight="1"
                app:alignItems="center"
                app:flexDirection="row"
                app:flexWrap="nowrap"
                app:justifyContent="flex_start">
                <TextView
                    android:textSize="16dp"
                    android:ellipsize="end"
                    android:id="@+id/nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="名称ddddddddddddddddddddddddddddddddddddddddddd"
                    android:lines="1"
                    android:singleLine="true"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="1"
                    style="@style/text_normal_content"/>
                <ImageView
                    android:id="@+id/sex_image"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/icon_sex_female"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="0"/>
                <TextView
                    android:id="@+id/tv_official"
                    android:visibility="gone"
                    android:layout_marginLeft="6dp"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="0"
                    style="@style/official_text_tag"/>
                <ImageView
                    android:id="@+id/iv_vip"
                    android:visibility="visible"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/vip_icon_normal_small"
                    app:layout_flexGrow="0"
                    app:layout_flexShrink="0"/>
            </com.google.android.flexbox.FlexboxLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ff999999"
                    android:id="@+id/distance"
                    android:paddingLeft="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.34km · "/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ff14cd64"
                    android:id="@+id/status"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在线"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sub_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@+id/btn_say_hi"
        android:layout_toRightOf="@+id/head_img"
        android:layout_below="@+id/content_layout">
        <TextView
            android:textSize="12dp"
            android:textColor="#ff222222"
            android:ellipsize="end"
            android:id="@+id/profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="30岁 · 上海 · 餐饮"
            android:lines="1"
            android:singleLine="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ff999999"
            android:ellipsize="end"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="我恨太多的谎言，用心换不来真诚"
            android:lines="1"
            android:singleLine="true"/>
        <FrameLayout
            android:id="@+id/feed_list_layout"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <com.zenmen.square.ui.widget.NearByFeedContainer
                android:orientation="horizontal"
                android:id="@+id/ll_feed_pic_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
    <com.zenmen.listui.widget.LeftDrawableText
        android:textSize="12dp"
        android:textColor="@color/Aa"
        android:gravity="center_vertical"
        android:id="@+id/btn_say_hi"
        android:background="@drawable/bg_text_green_26"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="38dp"
        android:text="打招呼"
        android:drawableLeft="@drawable/icon_say_hi_left"
        android:drawablePadding="3dp"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
