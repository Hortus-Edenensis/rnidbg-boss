<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                android:layout_toLeftOf="@+id/multi_choice"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/image_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_item_portrait_view_size_margin_right_top"
                android:layout_marginRight="@dimen/chat_item_portrait_margin_left_or_right"
                android:layout_toLeftOf="@+id/portrait">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.zenmen.palmchat.widget.AutoResizeImageView
                        android:gravity="center_vertical"
                        android:id="@+id/video_thumbnail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:maxWidth="@dimen/chat_image_size"
                        android:maxHeight="@dimen/chat_image_size"
                        app:side="right"/>
                    <ImageView
                        android:id="@+id/video_play"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/video_play"
                        android:scaleType="centerInside"
                        android:layout_centerInParent="true"/>
                    <com.zenmen.palmchat.widget.DownloadProgressBar
                        android:id="@+id/downloadProgress"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_centerInParent="true"/>
                    <ImageView
                        android:id="@+id/status_pending"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="2dp"
                        android:src="@drawable/custom_progress_icon"
                        android:layout_centerInParent="true"
                        style="@style/ChatListProgressIndicator"/>
                    <TextView
                        android:textSize="@dimen/text_size_tiny"
                        android:textColor="@android:color/white"
                        android:id="@+id/video_size"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginBottom="6dp"
                        android:layout_alignLeft="@+id/video_thumbnail"
                        android:layout_alignBottom="@+id/video_thumbnail"/>
                    <TextView
                        android:textSize="@dimen/text_size_tiny"
                        android:textColor="@android:color/white"
                        android:id="@+id/video_length"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="6dp"
                        android:layout_alignRight="@+id/video_thumbnail"
                        android:layout_alignBottom="@+id/video_thumbnail"/>
                    <View
                        android:id="@+id/image_click_area"
                        android:background="@drawable/selector_message_image_right_item_background"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignLeft="@+id/video_thumbnail"
                        android:layout_alignTop="@+id/video_thumbnail"
                        android:layout_alignRight="@+id/video_thumbnail"
                        android:layout_alignBottom="@+id/video_thumbnail"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@color/sub_gray"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/retry_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tap_to_resend"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/status_fail"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_message_status_retry"
                android:layout_toLeftOf="@+id/image_container"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
