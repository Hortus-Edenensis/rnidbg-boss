<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/chat_profile_card_bg"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_load_state_icon"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="143dp"
        android:src="@drawable/icon_load_state_empty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.24"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#666666"
        android:id="@+id/tv_load_state_text"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="空空如也"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_load_state_icon"/>
    <ImageView
        android:id="@+id/iv_page_state_loading"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/icon_square_loading"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.34"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/state_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignItems="center"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:maxLine="3">
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/age"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/online"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/loc"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/occupation"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/income"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/intention_1"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/intention_2"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#333333"
                android:ellipsize="end"
                android:id="@+id/intention_3"
                android:background="@drawable/bg_chat_profile_tag"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                app:layout_flexGrow="0"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/portrait_thumbnail_recycler"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/guide"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#f5f5f5"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
            <RelativeLayout
                android:id="@+id/guide_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/guide_image_iv"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_round_corner_default_pic"
                    android:scaleType="centerCrop"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    app:esv_shape="round_rectangle"
                    app:radius_x_dp="4dp"
                    app:radius_y_dp="4dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#222222"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/guide_text_thumbnail"
                    android:background="@drawable/shape_feed_text_bg_4"
                    android:paddingLeft="3dp"
                    android:paddingTop="2dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="4dp"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:maxLines="3"
                    android:includeFontPadding="false"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_video_icon"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_video_for_square_card_in_chat"
                    android:layout_alignLeft="@+id/guide_image_iv"
                    android:layout_alignRight="@+id/guide_image_iv"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#999999"
                    android:ellipsize="end"
                    android:id="@+id/guide_image_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="精选动态"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/guide_image_iv"
                    android:layout_alignTop="@+id/guide_image_iv"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:gravity="left"
                    android:id="@+id/guide_image_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:layout_toRightOf="@+id/guide_image_iv"
                    android:layout_below="@+id/guide_image_title"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/guide_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#999999"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ta可能感兴趣"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:id="@+id/guide_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lines="1"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#333333"
                    android:ellipsize="end"
                    android:id="@+id/guide_text_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
