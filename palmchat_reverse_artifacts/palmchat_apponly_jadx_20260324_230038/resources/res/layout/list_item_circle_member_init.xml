<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lyt_word_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0px"/>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#888888"
            android:gravity="center_vertical"
            android:id="@+id/group_indicator"
            android:background="#f6f6f6"
            android:paddingLeft="12dp"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:text="A"/>
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="58dp">
        <com.zenmen.palmchat.widget.SocialPortraitView
            android:layout_gravity="center_vertical"
            android:id="@+id/portrait"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/default_portrait"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试一个很长的名字"
                android:singleLine="true"
                style="@style/text_normal_content"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/input_btn_disabled"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试一个很长的名字"
                android:singleLine="true"/>
        </LinearLayout>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#d9d9d9"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
</LinearLayout>
