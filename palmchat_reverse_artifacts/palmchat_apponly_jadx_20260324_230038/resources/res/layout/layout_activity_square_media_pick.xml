<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/no_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_below="@+id/toolbar">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/Gb"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="无法访问相册中照片"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="56dp"
            android:text="请在设置-应用-连信-权限中开启存储空间权限，以正常访问相册照片"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_below="@+id/toolbar">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_square_load_state_empty"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/Gc"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="你的相册中无可用内容"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/media_grid_view"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:id="@+id/media_select"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/media_select_icon"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/square_media_pick_select_bg_green"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/Gb"
                android:gravity="left"
                android:layout_gravity="center_vertical"
                android:id="@+id/media_select_title"
                android:paddingLeft="6dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多选"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/Gd"
                android:gravity="left"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_multi_prompt"
                android:paddingLeft="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="（仅支持图片多选）"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/media_select_action"
                android:background="@drawable/selector_big_button_green"
                android:paddingLeft="22dp"
                android:paddingTop="9dp"
                android:paddingRight="22dp"
                android:paddingBottom="9dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确定"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/action"
        android:background="@drawable/square_btn_bg_24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="65dp"
        android:layout_marginRight="65dp"
        android:layout_marginBottom="222dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#14cd64"
        android:gravity="center"
        android:id="@+id/open_camera"
        android:background="@drawable/square_stroke_btn_bg"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="65dp"
        android:layout_marginRight="65dp"
        android:layout_marginBottom="162dp"
        android:text="拍摄照片"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
