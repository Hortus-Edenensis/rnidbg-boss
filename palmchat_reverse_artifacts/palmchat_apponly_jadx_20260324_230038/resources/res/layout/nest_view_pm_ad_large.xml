<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/ad_root_parent_layout"
    android:layout_width="337dp"
    android:layout_height="516dp">
    <FrameLayout
        android:tag="nest_native_ui_root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/ad_bg_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="24dp"
            app:radius_y_dp="24dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/ad_img_video_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ad_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <FrameLayout
                android:id="@+id/ad_video"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/ad_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/nest_mine_adsdk_close"
            android:scaleType="fitCenter"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/nest_bg_bottom_ad_down_pm"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="212dp">
            <TextView
                android:textSize="17dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/ad_desc"
                android:layout_width="306dp"
                android:layout_height="wrap_content"
                android:text="80后单身交友"
                android:maxLines="2"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="13dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ad_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitXY"
                    app:esv_shape="round_rectangle"
                    app:radius_x_dp="8dp"
                    app:radius_y_dp="8dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/ad_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="陌陌单身"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/logo_ad_layout"
                    android:background="@drawable/nest_mine_adsdk_tag_bg_style2"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="7dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ad_logo"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_gdt_logo"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="9dp"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/ad_sign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:text="@string/adsdk_generic_ad_group_normal"
                        android:lines="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayoutNewPM
                    android:id="@+id/ad_com_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ad_down_yaoyiyao_layout"
                android:tag="ad_down_yaoyiyao_layout"
                android:background="@drawable/nest_bg_pm_btn_ad_down"
                android:layout_width="258dp"
                android:layout_height="44dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ad_yaoyiyao"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:background="@drawable/ad_yaoyiyao"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="5dp"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="摇一摇或"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/app_download_btn"
                            android:tag="huawei_download_btn"
                            android:paddingLeft="7dp"
                            android:paddingTop="2dp"
                            android:paddingRight="7dp"
                            android:paddingBottom="2dp"
                            android:visibility="gone"
                            android:layout_width="200dp"
                            android:layout_height="44dp"
                            app:hiad_fixedWidth="true"
                            app:hiad_maxWidth="200dp"
                            app:hiad_minWidth="200dp"
                            app:hiad_textColor="#ffffff"
                            app:hiad_textSize="16dp"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/ad_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ad_download_start2"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
