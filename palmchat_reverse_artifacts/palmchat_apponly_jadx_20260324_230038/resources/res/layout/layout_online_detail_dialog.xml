<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#b4000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/online_detail_dialog_all_bg"
        android:paddingBottom="30dp"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/online_detail_dialog_top_bg"
            android:layout_width="match_parent"
            android:layout_height="137dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="320dp"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginTop="30dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/portrait_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_portrait"
                    app:esv_shape="circle"/>
                <ImageView
                    android:layout_gravity="bottom|right"
                    android:id="@+id/online_gender"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/online_detail_women_bg"
                    android:scaleType="fitXY"/>
            </FrameLayout>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/online_nick"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="爱吃红柚子"
                android:lines="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#666666"
                    android:ellipsize="end"
                    android:id="@+id/online_city_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="同城 · 23km"
                    android:lines="1"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#666666"
                    android:ellipsize="end"
                    android:id="@+id/online_time_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text=" · 20小时前"
                    android:lines="1"/>
            </LinearLayout>
            <FrameLayout
                android:background="@drawable/online_detail_dialog_status_bg"
                android:layout_width="245dp"
                android:layout_height="72dp"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/online_trip_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="20dp">
                        <ImageView
                            android:id="@+id/online_trip_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="12dp"
                            android:src="@drawable/online_dialog_trip_location_bg"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/online_trip_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="4dp"
                            android:maxWidth="200dp"
                            android:text="约逛街"
                            android:lines="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="9dp">
                        <ImageView
                            android:id="@+id/online_trip_icon2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="12dp"
                            android:src="@drawable/online_trip_map_tag"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#222222"
                            android:ellipsize="end"
                            android:id="@+id/online_trip_address"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="4dp"
                            android:maxWidth="200dp"
                            android:text="上海市浦东新区"
                            android:lines="1"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/online_status_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/online_status_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/online_status_msg_bg"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#222222"
                        android:ellipsize="end"
                        android:id="@+id/online_status_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:maxWidth="170dp"
                        android:text="来个人陪我聊聊天"
                        android:lines="1"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/online_other_layout"
                android:layout_width="245dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/online_gift_layout"
                    android:background="@drawable/online_detail_dialog_gift_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/online_gift_img_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:id="@+id/online_gift_btn_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:maxWidth="110dp"
                        android:text="送礼等回复"
                        android:lines="1"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:id="@+id/online_gift_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:text="(20连信豆)"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/online_saihi_layout"
                    android:background="@drawable/online_detail_dialog_saihi_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/online_dialog_hi_icon_bg"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:text="打招呼"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/online_trip_unlock_layout"
                    android:background="@drawable/online_detail_dialog_saihi_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:text="解锁聊天"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:id="@+id/online_unlock_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:text="(20连信豆)"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/public_dialog_close"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/online_public_dialog_close"/>
    </FrameLayout>
</FrameLayout>
