<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/chat_unread_sep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="#999"
            android:gravity="center"
            android:id="@+id/chat_unread_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/chat_unread_separator"
            android:layout_centerInParent="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginRight="9dp"
            android:layout_toLeftOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
        <View
            android:background="#cfcfcf"
            android:layout_width="66dp"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_toRightOf="@+id/chat_unread_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="time"
        style="@style/text_chat_time"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:paddingLeft="@dimen/chat_item_padding_left_or_right"
            android:paddingRight="@dimen/chat_item_padding_left_or_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.LXPortraitView
                android:id="@+id/portrait"
                android:layout_width="@dimen/chat_item_portrait_view_size"
                android:layout_height="@dimen/chat_item_portrait_view_size"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/row_rec_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/portrait">
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@color/text_color_gray"
                    android:ellipsize="end"
                    android:id="@+id/name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right"
                    android:maxWidth="@dimen/list_item_text_width"
                    android:text="nameaaaaaaaaaaaaaaaaaaaddddddddddddddddaaaaaaaa"
                    android:singleLine="true"/>
                <RelativeLayout
                    android:id="@+id/ll_gift_content"
                    android:layout_width="247dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/chat_item_portrait_margin_left_or_right">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/shape_single_chat_gift_left_card_bg"
                        android:layout_width="247dp"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="17dp"
                            android:textColor="@color/Gb"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_gift_title"
                            android:visibility="visible"
                            android:layout_width="157dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:singleLine="true"
                            android:layout_marginStart="14dp"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/Gc"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_sub_title"
                            android:layout_width="157dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:layout_marginStart="14dp"/>
                        <View
                            android:background="@color/line_bg"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginTop="13.75dp"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14dp"
                                android:textColor="@color/Gb"
                                android:gravity="center"
                                android:id="@+id/tv_action"
                                android:paddingTop="8.25dp"
                                android:paddingBottom="9dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="回礼给Ta"
                                android:singleLine="true"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="@color/Ga"
                                android:gravity="center"
                                android:id="@+id/tv_action2"
                                android:paddingTop="8.25dp"
                                android:paddingBottom="9dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="立即装扮"
                                android:singleLine="true"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </LinearLayout>
                    <com.zenmen.palmchat.widget.LXPortraitView
                        android:id="@+id/iv_gift_icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/ic_chat_flowers_private_chat_gift_card"
                        android:scaleType="centerCrop"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:id="@+id/audio_read"
                android:background="@drawable/red_circle"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginLeft="7dp"
                android:layout_toRightOf="@+id/row_rec_location"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/multi_choice"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="-10dp"
                android:src="@drawable/icon_green_unchecked"
                android:scaleType="center"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/message_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
