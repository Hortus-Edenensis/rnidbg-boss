<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ebebeb"
    android:layout_width="match_parent"
    android:layout_height="92dp">
    <ImageView
        android:id="@+id/dl_icon_iv"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginLeft="23dp"
        android:layout_centerVertical="true"/>
    <Button
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/dl_ctrl_bt"
        android:background="@drawable/opos_mob_drawable_download_btn"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:layout_marginRight="23dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="20dp"
        android:layout_toLeftOf="@+id/dl_ctrl_bt"
        android:layout_toRightOf="@+id/dl_icon_iv"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="12sp"
            android:textColor="#ff000000"
            android:ellipsize="end"
            android:id="@+id/dl_app_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="9dp"
            android:maxEms="8"
            android:singleLine="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff000000"
            android:id="@+id/dl_delete_bt"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <ProgressBar
            android:id="@+id/dl_process_bar"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/opos_mob_drawable_download_barcolor"
            android:layout_alignParentBottom="true"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="8sp"
            android:textColor="#ff000000"
            android:id="@+id/dl_process_tv"
            android:layout_width="wrap_content"
            android:layout_height="11dp"
            android:layout_marginBottom="3dp"
            android:layout_above="@+id/dl_process_bar"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="8sp"
            android:textColor="#ff000000"
            android:id="@+id/dl_status_tv"
            android:layout_width="wrap_content"
            android:layout_height="11dp"
            android:layout_marginBottom="3dp"
            android:layout_above="@+id/dl_process_bar"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/dl_fail_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
