<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:orientation="vertical"
            android:id="@+id/scv_user_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:orientation="vertical"
                    android:id="@+id/scroll_layout"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.zenmen.palmchat.peoplematch.view.LoopingViewPager
                            android:id="@+id/portrait_gallery"
                            android:layout_width="match_parent"
                            android:layout_height="268dp"/>
                        <View
                            android:background="@drawable/user_detail_gallery_cover"
                            android:layout_width="match_parent"
                            android:layout_height="268dp"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#999999"
                            android:gravity="top|center_horizontal"
                            android:id="@+id/portrait_empty_tips"
                            android:paddingTop="30dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="268dp"
                            android:text="Ta还没有头像呢"
                            android:drawableTop="@drawable/user_detail_portrait_empty"
                            android:drawablePadding="8dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/portrait_thumbnail_recycler"
                            android:paddingLeft="14dp"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="167dp"
                            android:layout_alignParentTop="true"/>
                        <FrameLayout
                            android:orientation="horizontal"
                            android:id="@+id/decor_guide_bubble_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:layout_marginTop="-30dp"
                            android:layout_alignTop="@+id/portrait_thumbnail_recycler">
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/decor_guide_bubble"
                                android:background="@drawable/ic_portrait_decor_bubble_new"
                                android:paddingLeft="6dp"
                                android:paddingRight="8dp"
                                android:paddingBottom="6dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="13dp"
                                android:text="领取个性头像挂件"
                                android:drawableRight="@drawable/ic_portrait_decor_bubble_arrow"
                                android:drawablePadding="5dp"/>
                        </FrameLayout>
                        <ImageView
                            android:id="@+id/portrait_cancellation"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="167dp"
                            android:src="@drawable/ic_portrait_cancellation_v2"
                            android:scaleType="centerCrop"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/portrait_add_tips"
                            android:background="@drawable/user_detail_thumbnail_tips_bg"
                            android:paddingLeft="8dp"
                            android:paddingTop="4dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="68dp"
                            android:layout_marginBottom="12dp"
                            android:drawableRight="@drawable/square_publish_right_arrow"
                            android:drawablePadding="4dp"
                            android:layout_alignBottom="@+id/portrait_thumbnail_recycler"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/portrait_permission_tips"
                            android:background="@drawable/user_detail_thumbnail_tips_bg"
                            android:paddingLeft="8dp"
                            android:paddingTop="4dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="-64dp"
                            android:layout_alignTop="@+id/portrait_thumbnail_recycler"
                            android:layout_alignParentLeft="true">
                            <TextView
                                android:textSize="13dp"
                                android:textColor="@color/white"
                                android:layout_gravity="left"
                                android:id="@+id/portrait_permission_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="你需上传3张头像照片，才可查看他人更多照片。"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="@color/white"
                                android:layout_gravity="left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="立即上传"
                                android:drawableRight="@drawable/square_publish_right_arrow"
                                android:drawablePadding="4dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/basic"
                            android:background="@drawable/shape_user_detail_bg_v2"
                            android:paddingLeft="16dp"
                            android:paddingTop="20dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="16dp"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="219dp"
                            android:layout_alignParentTop="true">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="64dp">
                                <TextView
                                    android:textSize="@dimen/B1"
                                    android:textStyle="bold"
                                    android:textColor="@color/Gb"
                                    android:ellipsize="end"
                                    android:id="@+id/nameMain"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:includeFontPadding="false"
                                    app:layout_constrainedWidth="true"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintHorizontal_bias="0"
                                    app:layout_constraintHorizontal_chainStyle="packed"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintRight_toLeftOf="@+id/tv_official"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:id="@+id/tv_official"
                                    android:visibility="gone"
                                    android:layout_marginLeft="6dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/nameMain"
                                    app:layout_constraintRight_toLeftOf="@+id/iv_vip"
                                    app:layout_constraintTop_toTopOf="parent"
                                    style="@style/official_text_tag"/>
                                <ImageView
                                    android:id="@+id/iv_vip"
                                    android:visibility="gone"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/selector_icon_vip"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/tv_official"
                                    app:layout_constraintRight_toLeftOf="@+id/iv_ai_chat"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <ImageView
                                    android:id="@+id/iv_ai_chat"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="18dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/ai_chat_find_logo_bg"
                                    android:scaleType="fitXY"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/iv_vip"
                                    app:layout_constraintRight_toLeftOf="@+id/iv_authen_icon"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <ImageView
                                    android:id="@+id/iv_authen_icon"
                                    android:visibility="gone"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/pr_login_icon_bg"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/iv_ai_chat"
                                    app:layout_constraintRight_toLeftOf="@+id/iv_map_separation_bg"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <ImageView
                                    android:id="@+id/iv_map_separation_bg"
                                    android:visibility="gone"
                                    android:layout_width="46dp"
                                    android:layout_height="18dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/user_map_separation_icon_bg"
                                    android:scaleType="fitXY"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/iv_authen_icon"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">
                                <TextView
                                    android:textSize="@dimen/C2"
                                    android:textColor="@color/Ga"
                                    android:id="@+id/online_text"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="10dp"
                                    android:text="当前在线"
                                    android:drawableLeft="@drawable/user_detail_online_bg"
                                    android:drawablePadding="4dp"/>
                                <TextView
                                    android:textSize="@dimen/C2"
                                    android:textColor="@color/Gd"
                                    android:id="@+id/district_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:textSize="10dp"
                                    android:textStyle="bold"
                                    android:textColor="#ffffff"
                                    android:gravity="center"
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/tv_member_gender_age"
                                    android:background="@drawable/bg_member_gender_age_female"
                                    android:padding="3dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="6dp"/>
                                <com.zenmen.palmchat.contacts.widget.UserDetailLevelViewV2
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/rich_level"
                                    android:visibility="invisible"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="6dp"
                                    app:level_type="rich"/>
                                <com.zenmen.palmchat.contacts.widget.UserDetailLevelViewV2
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/charm_level"
                                    android:visibility="invisible"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="6dp"
                                    app:level_type="charm"/>
                                <com.zenmen.palmchat.contacts.widget.UserDetailEnergyView2
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/energy_view"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="6dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/iv_label"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="18dp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="@dimen/B4"
                                android:textColor="@color/Ba"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:id="@+id/alert_tv"
                                android:background="@drawable/user_detail_alert_tip_bg"
                                android:paddingLeft="14dp"
                                android:paddingRight="14dp"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="对方可能存在违规行为，请谨慎交谈"
                                android:singleLine="true"
                                android:drawableLeft="@drawable/icon_netstatus_unavailable"
                                android:drawablePadding="6dp"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="@color/Gd"
                                android:id="@+id/signature_text"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/no_signature"
                                android:lineSpacingMultiplier="1.1"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="@color/Gc"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/signature_tips"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:drawableRight="@drawable/user_detail_profile_complete_arrow"
                                android:drawablePadding="1dp"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:id="@+id/request_layout"
                            android:background="@drawable/shape_user_detail_sign"
                            android:padding="16dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_marginBottom="16dp"
                            android:layout_below="@+id/basic">
                            <TextView
                                android:textSize="@dimen/C2"
                                android:textColor="@color/Gc"
                                android:id="@+id/tv_extras_title"
                                android:paddingTop="1dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/extras"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:id="@+id/chat_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="6dp"
                                android:layout_toRightOf="@+id/tv_extras_title">
                                <TextView
                                    android:textSize="@dimen/C1"
                                    android:textColor="@color/Gb"
                                    android:id="@+id/item0"
                                    android:visibility="visible"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="5dp"
                                    android:lineSpacingMultiplier="1.1"/>
                                <TextView
                                    android:textSize="@dimen/C1"
                                    android:textColor="@color/Gb"
                                    android:id="@+id/item1"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="5dp"
                                    android:lineSpacingMultiplier="1.1"/>
                                <TextView
                                    android:textSize="@dimen/C1"
                                    android:textColor="@color/Gb"
                                    android:id="@+id/item2"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="5dp"
                                    android:lineSpacingMultiplier="1.1"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="@dimen/C1"
                                android:textColor="@color/Aa"
                                android:gravity="center"
                                android:id="@+id/reply"
                                android:paddingLeft="6dp"
                                android:paddingTop="12dp"
                                android:clickable="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/string_reply"
                                android:includeFontPadding="false"
                                android:layout_below="@+id/chat_layout"
                                android:layout_alignParentRight="true"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/profile_empty"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="60dp"
                            android:layout_below="@+id/basic">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_personal_empty"
                                android:scaleType="centerCrop"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="#999"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/tv_user_fid_error"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(id:0000000)"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#666666"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/profile_error"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="120dp"
                            android:drawableTop="@drawable/ic_personal_no_network"
                            android:drawablePadding="12dp"
                            android:layout_below="@+id/basic"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-10dp"
                            android:layout_alignTop="@+id/basic"
                            android:layout_alignParentRight="true"
                            android:layout_marginEnd="15dp">
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/white"
                                android:gravity="top|center_horizontal"
                                android:layout_gravity="end"
                                android:id="@+id/like_guide"
                                android:background="@drawable/user_detail_like_guide_v2"
                                android:paddingTop="3dp"
                                android:visibility="invisible"
                                android:layout_width="135dp"
                                android:layout_height="29dp"
                                android:text="发送爱意，让Ta找到你"/>
                            <RelativeLayout
                                android:layout_gravity="end"
                                android:id="@+id/like_container"
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginRight="15dp">
                                <ImageView
                                    android:id="@+id/like_img"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:scaleType="fitCenter"
                                    android:layout_centerHorizontal="true"/>
                                <TextView
                                    android:textSize="11dp"
                                    android:textColor="#222222"
                                    android:id="@+id/like_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="喜欢"
                                    android:layout_below="@+id/like_img"
                                    android:layout_centerHorizontal="true"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </RelativeLayout>
                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolbar2"
                        android:background="@color/transparent"
                        android:paddingTop="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:layout_collapseMode="parallax">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/back2"
                            android:paddingLeft="13dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_back_gray"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="13dp">
                            <ImageView
                                android:id="@+id/menu_edit_profile2"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_user_detail_edit_gray"/>
                            <View
                                android:id="@+id/dot_edit_profile2"
                                android:background="@drawable/red_circle_lbs_notify"
                                android:visibility="gone"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_marginLeft="-10dp"
                                android:layout_marginBottom="8dp"/>
                            <ImageView
                                android:id="@+id/menu_more2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:src="@drawable/ic_user_detail_more_gray"/>
                        </LinearLayout>
                    </androidx.appcompat.widget.Toolbar>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
                <com.zenmen.palmchat.contacts.userdetail.UserDetailTabHeaderView
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#999"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_user_fid_info"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:text="(id:0000000)"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </com.zenmen.palmchat.contacts.userdetail.UserDetailTabHeaderView>
            </com.google.android.material.appbar.AppBarLayout>
            <com.zenmen.palmchat.contacts.userdetail.UserDetailPageHelper
                android:id="@+id/dynamic_life"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.zenmen.square.NestTopicFeedsActivity$SquareBehavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/white"
            android:paddingTop="0dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/back"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_back_black"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:minHeight="44dp">
                <ImageView
                    android:id="@+id/menu_edit_profile"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_user_detail_edit_black"/>
                <View
                    android:id="@+id/dot_edit_profile"
                    android:background="@drawable/red_circle_lbs_notify"
                    android:visibility="gone"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginLeft="-10dp"
                    android:layout_marginBottom="8dp"/>
                <ImageView
                    android:id="@+id/menu_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/ic_user_detail_more"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </RelativeLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/action_layout"
        android:background="@drawable/user_detail_action_layout_bg"
        android:paddingLeft="11dp"
        android:paddingTop="30dp"
        android:paddingRight="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp">
        <TextView
            android:enabled="true"
            android:textSize="13dp"
            android:textColor="#f95645"
            android:gravity="center"
            android:id="@+id/textview_blacklist"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/blacklist_des"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp">
            <TextView
                android:enabled="true"
                android:gravity="center"
                android:id="@+id/action_btn_video_call"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/input_fragment_grid_item_video_call_userdetail"
                android:layout_weight="1"
                style="@style/big_button_yellow"/>
            <TextView
                android:enabled="true"
                android:textSize="@dimen/text_size_normal"
                android:gravity="center"
                android:id="@+id/action_btn_add"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/add_to_contact"
                android:layout_weight="1"
                style="@style/big_button_green"/>
            <TextView
                android:enabled="true"
                android:gravity="center"
                android:id="@+id/action_btn_chat"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/source_type_greeting"
                android:layout_weight="1"
                style="@style/big_button_green"/>
            <TextView
                android:enabled="true"
                android:gravity="center"
                android:id="@+id/action_btn_delete"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/delete"
                android:layout_weight="1"
                style="@style/big_button_red"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
