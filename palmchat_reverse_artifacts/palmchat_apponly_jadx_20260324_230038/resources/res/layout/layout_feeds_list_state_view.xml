<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="27dp"
    android:paddingRight="27dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_square_load_state_icon"
        android:layout_width="145dp"
        android:layout_height="115dp"
        android:layout_marginTop="136dp"
        android:src="@drawable/icon_square_load_state_empty"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#737373"
        android:id="@+id/tv_square_load_state_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/square_feed_list_state_empty"
        android:layout_below="@+id/iv_square_load_state_icon"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_page_state_loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/icon_square_loading"
        android:layout_below="@+id/iv_square_load_state_icon"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_operator"
        android:background="@drawable/square_publish_selector_btn"
        android:visibility="gone"
        android:layout_width="156dp"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/tv_square_load_state_text"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
