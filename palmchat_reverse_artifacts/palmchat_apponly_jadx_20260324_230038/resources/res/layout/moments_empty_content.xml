<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_moments_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="72dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="@dimen/moment_item_padding">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="這是空内容的動態哦~理論上來説它不應該出現的o"
            style="@style/friend_circle_content_text"/>
    </LinearLayout>
    <include layout="@layout/include_moments_bottom_right"/>
    <View
        android:visibility="invisible"
        style="@style/base_divider_top_20"/>
</LinearLayout>
