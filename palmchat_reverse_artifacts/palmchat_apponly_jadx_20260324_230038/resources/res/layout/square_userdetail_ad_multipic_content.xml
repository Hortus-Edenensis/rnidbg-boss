<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/square_userdetail_ad_multipic_content_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:background="@drawable/adsdk_user_logo_bg"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#999999"
            android:id="@+id/ad_sign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/ad_img_1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="fitXY"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="4dp"
            app:radius_y_dp="4dp"/>
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="2dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/ad_img_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:esv_shape="round_rectangle"
                app:radius_x_dp="4dp"
                app:radius_y_dp="4dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/ad_close_1"
                android:visibility="gone"
                android:layout_width="19dp"
                android:layout_height="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/square_userdetail_ad_multipic_content_del"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="2dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/ad_img_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:esv_shape="round_rectangle"
                app:radius_x_dp="4dp"
                app:radius_y_dp="4dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/ad_close_2"
                android:visibility="gone"
                android:layout_width="19dp"
                android:layout_height="17dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/square_userdetail_ad_multipic_content_del"
                android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#222222"
        android:id="@+id/ad_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="12dp"
            android:textColor="#cccccc"
            android:id="@+id/ad_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/ad_action"
            android:background="@drawable/square_userdetail_ad_generic_action_bg"
            android:paddingLeft="11dp"
            android:paddingTop="3dp"
            android:paddingRight="11dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:minWidth="63dp"
            android:minHeight="20dp"
            android:text="@string/ad_download_start"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayout2
            android:id="@+id/ad_com_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
