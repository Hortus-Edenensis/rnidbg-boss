<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="244dp"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/ad_root_parent_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:tag="nest_native_ui_root_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="244dp"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="21dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.zenmen.palmchat.widget.EffectiveShapeView
                                android:id="@+id/ad_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:scaleType="fitXY"
                                app:esv_shape="round_rectangle"
                                app:radius_x_dp="8dp"
                                app:radius_y_dp="8dp"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="#999999"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:id="@+id/ad_app_name"
                                android:layout_width="125dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="4dp"
                                android:text="陌陌"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#bbbbbb"
                            android:gravity="center"
                            android:layout_gravity="right"
                            android:id="@+id/ad_sign"
                            android:background="@drawable/nest_square_generic_list_item_ad_drop_bg"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:text="个性化广告"
                            android:includeFontPadding="false"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="7dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ad_img_layout"
                            android:layout_width="match_parent"
                            android:layout_height="80dp">
                            <com.zenmen.palmchat.widget.EffectiveShapeView
                                android:id="@+id/ad_img1"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:scaleType="fitXY"
                                app:esv_shape="round_rectangle"
                                app:radius_x_dp="4dp"
                                app:radius_y_dp="4dp"/>
                            <com.zenmen.palmchat.widget.EffectiveShapeView
                                android:id="@+id/ad_img2"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginLeft="2dp"
                                android:scaleType="fitXY"
                                app:esv_shape="round_rectangle"
                                app:radius_x_dp="4dp"
                                app:radius_y_dp="4dp"/>
                            <com.zenmen.palmchat.widget.EffectiveShapeView
                                android:id="@+id/ad_img3"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginLeft="2dp"
                                android:scaleType="fitXY"
                                app:esv_shape="round_rectangle"
                                app:radius_x_dp="4dp"
                                app:radius_y_dp="4dp"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_gravity="right"
                            android:id="@+id/ad_close"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginRight="6dp"
                            android:src="@drawable/nest_mine_adsdk_close"/>
                        <ImageView
                            android:layout_gravity="bottom"
                            android:id="@+id/ad_logo"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="8dp"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/icon_gdt_logo"
                            android:scaleType="fitCenter"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#666666"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/ad_desc"
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:text="80后单身交友"
                            android:maxLines="1"
                            android:includeFontPadding="false"/>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="right"
                            android:orientation="horizontal"
                            android:id="@+id/ad_down_yaoyiyao_layout"
                            android:tag="ad_down_yaoyiyao_layout"
                            android:background="@drawable/nest_bg_square_btn_ad_down"
                            android:layout_width="129dp"
                            android:layout_height="24dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/ad_yaoyiyao"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:id="@+id/yy_shake_bg"
                                    android:background="@drawable/ad_yaoyiyao"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_marginLeft="5dp"/>
                                <TextView
                                    android:textSize="12dp"
                                    android:textColor="#ffffff"
                                    android:gravity="center"
                                    android:id="@+id/yy_shake_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:text="摇一摇或"/>
                            </LinearLayout>
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:layout_gravity="center"
                                    android:layout_width="50dp"
                                    android:layout_height="17dp">
                                    <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                                        android:layout_gravity="center_horizontal"
                                        android:id="@+id/app_download_btn"
                                        android:tag="huawei_download_btn"
                                        android:paddingLeft="7dp"
                                        android:paddingTop="2dp"
                                        android:paddingRight="7dp"
                                        android:paddingBottom="2dp"
                                        android:visibility="gone"
                                        android:layout_width="50dp"
                                        android:layout_height="17dp"
                                        app:hiad_fixedWidth="true"
                                        app:hiad_maxWidth="50dp"
                                        app:hiad_minWidth="48dp"
                                        app:hiad_textColor="#ffffff"
                                        app:hiad_textSize="12dp"/>
                                </FrameLayout>
                                <TextView
                                    android:textSize="12dp"
                                    android:textColor="#ffffff"
                                    android:gravity="center"
                                    android:id="@+id/ad_action"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ad_download_start2"/>
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.ad.compliance.AdComInfoAllLayoutNew2
                android:id="@+id/ad_com_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
