<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/native_ad_tpbt_container_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/native_ad_tpbt_img_container_fl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.beizi.fusion.widget.CustomRoundImageView
            android:id="@+id/native_ad_tpbt_image_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/native_ad_tpbt_content_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/native_ad_tpbt_title_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_toLeftOf="@+id/native_ad_tpbt_go_rl">
            <TextView
                android:textSize="14sp"
                android:textColor="#1c1c1c"
                android:ellipsize="end"
                android:id="@+id/native_ad_tpbt_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:id="@+id/native_ad_tpbt_subtitle_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:singleLine="true"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/native_ad_tpbt_go_rl"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp">
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:id="@+id/native_ad_tpbt_go_tv"
                android:background="#fb5563"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/native_ad_tpbt_go_iv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
