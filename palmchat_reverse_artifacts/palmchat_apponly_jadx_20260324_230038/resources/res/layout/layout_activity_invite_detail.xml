<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/settings_background_gray_b"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:background="@color/white"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            app:layout_behavior=".contacts.AppbarZoomBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:scrollbarStyle="insideInset"
                android:id="@+id/collapsingLayout"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="288dp"
                android:minHeight="80dp"
                app:collapsedTitleGravity="center"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
                app:statusBarScrim="@color/color_trans">
                <ImageView
                    android:id="@+id/portrait"
                    android:background="@android:color/transparent"
                    android:fitsSystemWindows="true"
                    android:layout_width="match_parent"
                    android:layout_height="288dp"
                    android:src="@drawable/ic_invite_detail_portrait"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7"/>
                <LinearLayout
                    android:layout_gravity="bottom|left"
                    android:orientation="vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginBottom="40dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7">
                    <RelativeLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="left"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="22dp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/nameMain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lines="1"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:background="@color/color_trans"
                    android:paddingTop="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:transitionName="actionBar"
                    app:layout_collapseMode="pin"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scv_user_detail"
            android:background="@drawable/shape_user_detail_bg"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:translationY="-28dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/moment_view"
                    android:background="@drawable/selector_settings_item_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/text_size_65">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/personal_album_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/settings_item_notify"
                        android:text="@string/string_moment_personal_album"
                        android:layout_centerVertical="true"
                        style="@style/settings_title_text_gray"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/moment_photo_group"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="101dp"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/district_view"
                    android:background="@drawable/selector_settings_item_background"
                    android:layout_width="match_parent"
                    android:layout_height="40dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/settings_item_notify"
                        android:text="@string/district"
                        android:layout_centerVertical="true"
                        style="@style/settings_title_text_gray"/>
                    <TextView
                        android:id="@+id/district_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="104dp"
                        android:text="@string/district_china"
                        android:layout_centerVertical="true"
                        style="@style/settings_main_text_gray"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/signature_view"
                    android:background="@drawable/selector_settings_item_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/settings_item_notify"
                        android:text="@string/signature"
                        android:layout_centerVertical="true"
                        style="@style/settings_title_text_gray"/>
                    <TextView
                        android:id="@+id/signature_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="104dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="7dp"
                        android:text="@string/no_signature"
                        android:layout_centerVertical="true"
                        android:lineSpacingMultiplier="1.1"
                        style="@style/settings_main_text_gray"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/hobby_view"
                    android:background="@drawable/selector_settings_item_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/settings_item_notify"
                        android:text="@string/settings_hobby"
                        android:layout_centerVertical="true"
                        style="@style/settings_title_text_gray"/>
                    <TextView
                        android:id="@+id/hobby_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="104dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="7dp"
                        android:text="@string/no_hobby"
                        android:layout_centerVertical="true"
                        android:lineSpacingMultiplier="1.1"
                        style="@style/settings_main_text_gray"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/sourceType_view"
                    android:background="@drawable/selector_settings_item_background"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="34dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/settings_item_notify"
                        android:text="@string/source_type"
                        android:layout_centerVertical="true"
                        style="@style/settings_title_text_gray"/>
                    <TextView
                        android:id="@+id/sourceType_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="104dp"
                        android:text="通过手机通讯录添加"
                        android:layout_centerVertical="true"
                        style="@style/settings_main_text_gray"/>
                </RelativeLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="78dp">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:enabled="true"
                android:gravity="center"
                android:id="@+id/action_textview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:text="@string/contact_invite_friends_invite"
                android:layout_weight="1"
                style="@style/btn_green_solid"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
