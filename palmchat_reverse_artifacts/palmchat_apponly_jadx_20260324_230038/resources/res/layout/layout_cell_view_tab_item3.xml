<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/selector_settings_item_background"
    android:visibility="visible"
    android:layout_width="80dp"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/cell_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/icon_tab_cell_default2"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"
        app:esv_shape="round_rectangle"
        app:radius_x_dp="12dp"
        app:radius_y_dp="12dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#171717"
        android:ellipsize="end"
        android:id="@+id/cell_title"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="title"
        android:maxEms="4"
        android:layout_below="@+id/cell_icon"
        android:layout_centerHorizontal="true"/>
    <com.zenmen.palmchat.widget.TabCellUnReadView
        android:id="@+id/cell_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="-3dp"
        android:layout_toRightOf="@+id/cell_icon"
        android:layout_alignTop="@+id/cell_icon"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/cell_label_relativelayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cell_view_tab_item2_jiao"
            android:scaleType="centerCrop"
            android:layout_below="@+id/cell_label"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/cell_label"
            android:background="@drawable/shape_red_round_corner_17dp"
            android:padding="@dimen/ad_dimen_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="6"
            android:singleLine="true"
            android:maxLength="6"/>
    </RelativeLayout>
</RelativeLayout>
