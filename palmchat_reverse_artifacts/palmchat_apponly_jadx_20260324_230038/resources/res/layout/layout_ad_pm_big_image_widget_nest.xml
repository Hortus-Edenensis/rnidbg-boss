<?xml version="1.0" encoding="utf-8"?>
<com.wifi.ad.core.feedbanner.ClearLogoNativeAdContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ad_view_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAdContainer
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/people_card_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp">
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:id="@+id/ad_image_top"
                android:layout_width="match_parent"
                android:layout_height="234dp"
                android:src="@drawable/shape_people_match_photo_placeholder"
                android:scaleType="centerCrop"/>
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:layout_gravity="bottom"
                android:id="@+id/ad_image_bottom"
                android:layout_width="match_parent"
                android:layout_height="234dp"
                android:src="@drawable/shape_people_match_photo_placeholder"
                android:scaleType="centerCrop"/>
            <com.zenmen.palmchat.widget.EffectiveShapeView
                android:layout_gravity="center_vertical"
                android:id="@+id/ad_image"
                android:layout_width="match_parent"
                android:layout_height="234dp"
                android:src="@drawable/shape_people_match_photo_placeholder"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp">
            <View
                android:background="@drawable/shape_people_match_card_mask"
                android:layout_width="match_parent"
                android:layout_height="268dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_ad_close_tag"
                android:background="@drawable/ad_pm_tag_bg"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="14dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_ad_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pm_icon_csj_logo"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="#dbdbdb"
                    android:gravity="center"
                    android:id="@+id/ad_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个性化广告"
                    android:drawablePadding="6dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:src="@drawable/native_ad_close"
                    android:tint="#dbdbdb"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_ad_close_pop_wrapper"
                android:background="@drawable/ic_ad_close_pop_bg"
                android:paddingTop="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintRight_toRightOf="@+id/ll_ad_close_tag"
                app:layout_constraintTop_toBottomOf="@+id/ll_ad_close_tag">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#dbdbdb"
                    android:gravity="center"
                    android:id="@+id/ll_ad_close_pop"
                    android:paddingLeft="6dp"
                    android:paddingTop="6dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不感兴趣"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#dbdbdb"
                    android:gravity="center"
                    android:id="@+id/ll_vip_entrance_pop"
                    android:paddingLeft="6dp"
                    android:paddingTop="6dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="超级会员免广告"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/kds_ad_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <com.wifi.ad.core.feedbanner.NestHuaWeiNativeAppButton
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/app_download_btn"
                        android:tag="huawei_download_btn"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:layout_marginLeft="22dp"
                        android:layout_marginRight="22dp"
                        android:layout_marginBottom="25dp"
                        app:hiad_fixedWidth="true"
                        app:hiad_maxWidth="280dp"
                        app:hiad_minWidth="280dp"
                        app:hiad_textColor="#ffffff"
                        app:hiad_textSize="15dp"/>
                </FrameLayout>
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/ad_attatch_progress_btn"
                    android:background="@drawable/ad_pm_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginLeft="22dp"
                    android:layout_marginRight="22dp"
                    android:layout_marginBottom="25dp"
                    android:text="了解详情"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="22dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/default_portrait"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/ad_permission"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/ad_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="11dp"
                android:text="ad_name"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/ad_permission"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/ad_icon"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="10dp"
                android:text="ad_title"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/ad_icon"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ad_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toTopOf="@+id/kds_ad_btn_layout">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="11dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_ad_permission"
                        android:background="@drawable/ad_pm_privacy_bg"
                        android:paddingLeft="4dp"
                        android:paddingTop="2dp"
                        android:paddingRight="4dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="权限列表"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_ad_privacy"
                        android:background="@drawable/ad_pm_privacy_bg"
                        android:paddingLeft="4dp"
                        android:paddingTop="2dp"
                        android:paddingRight="4dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="隐私政策"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_ad_function"
                        android:background="@drawable/ad_pm_privacy_bg"
                        android:paddingLeft="4dp"
                        android:paddingTop="2dp"
                        android:paddingRight="4dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="功能介绍"/>
                </LinearLayout>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#d8d8d8"
                    android:id="@+id/tv_ad_dec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.wifi.ad.core.feedbanner.NestHuaWeiNativeAdContainer>
</com.wifi.ad.core.feedbanner.ClearLogoNativeAdContainer>
