<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/people_match_fl_dialog"
        android:background="@drawable/people_match_dialog_pay_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:layout_centerInParent="true">
        <View
            android:background="@drawable/people_match_dialog_header_bg"
            android:layout_width="match_parent"
            android:layout_height="88dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="40dp">
                <com.zenmen.palmchat.widget.EffectiveShapeView
                    android:id="@+id/people_match_esv_header1"
                    android:layout_width="77dp"
                    android:layout_height="77dp"
                    app:esv_shape="circle"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/people_match_like_guide_star"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#3d4240"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="超级喜欢TA"/>
            <TextView
                android:textSize="18dp"
                android:textColor="#a8adb1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="20dp"
                android:text="超级喜欢是付费功能，对方会明确知道你喜欢了Ta。极大提高你们双方配对成功的几率哦！"/>
            <FrameLayout
                android:id="@+id/people_match_pay_continue"
                android:background="@drawable/people_match_super_like_btn_continue"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="49dp">
                <TextView
                    android:textSize="18dp"
                    android:textColor="#3d4240"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="知道了，继续"
                    android:drawableRight="@drawable/people_match_super_like_continue"
                    android:drawablePadding="20dp"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
