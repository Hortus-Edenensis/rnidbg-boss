<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0px"/>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/cate_text_color"
            android:gravity="center_vertical"
            android:id="@+id/group_indicator"
            android:background="@color/cate_bg_color"
            android:paddingLeft="12dp"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:text="@string/friend_recommend_title"/>
        <View
            android:background="#e6e6e6"
            android:layout_width="match_parent"
            android:layout_height="0px"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/single_request_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="51dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/portrait"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp">
                <TextView
                    android:textSize="@dimen/text_size_normal"
                    android:textColor="@color/text_color_black"
                    android:ellipsize="end"
                    android:id="@+id/nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="36dp"
                    android:text="测试一个很长的名字"
                    android:singleLine="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="36dp">
                    <TextView
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/text_color_999"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="测试一个很长的消息"
                        android:singleLine="true"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/contact_recommend_phone_ic"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:src="@drawable/contact_recommend_phone_ic"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/multi_requests_layout"
            android:paddingLeft="12dp"
            android:paddingRight="50dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"/>
        <TextView
            android:textSize="@dimen/text_size_unread"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/notification_red_dot"
            android:background="@drawable/red_circle"
            android:paddingBottom="0.5dp"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginRight="28dp"
            android:text="1"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/color_divider_contact"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="1px"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="1px"/>
</LinearLayout>
