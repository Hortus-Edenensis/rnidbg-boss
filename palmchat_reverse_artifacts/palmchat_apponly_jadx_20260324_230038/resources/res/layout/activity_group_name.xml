<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/input_btn_disabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/group_name"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <EditText
                android:textSize="@dimen/text_size_middle"
                android:textColor="@color/text_color_202020"
                android:textColorHint="@color/divider_gray"
                android:id="@+id/edit_text"
                android:background="@drawable/selector_edit_text_underline_green"
                android:paddingLeft="8dp"
                android:paddingRight="35dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:singleLine="false"
                android:maxLength="32"
                android:textCursorDrawable="@null"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
