<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.circle.app.keep.ui.KeepRecyclerViewPager
        android:id="@+id/rv_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="34dp"
        android:src="@drawable/keep_motion_return_white"
        android:onClick="back"/>
    <com.zenmen.palmchat.circle.app.keep.widget.KeepChronometer
        android:textSize="30dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/back"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:id="@+id/guide"
        android:background="@drawable/shape_ffffff_round"
        android:paddingLeft="11dp"
        android:paddingTop="7dp"
        android:paddingRight="11dp"
        android:paddingBottom="7dp"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="16dp"
        android:text="查看讲解"
        android:layout_alignParentRight="true"
        android:onClick="guideToHtml"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#ffffff"
        android:id="@+id/motion_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginBottom="30dp"
        android:layout_above="@+id/command_ll"
        style="@style/keepTextShadow"/>
    <com.zenmen.palmchat.circle.app.keep.widget.KeepMotionCountView
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:id="@+id/motion_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginBottom="20dp"
        android:layout_above="@+id/motion_name"
        style="@style/keepTextShadow"/>
    <RelativeLayout
        android:id="@+id/command_ll"
        android:background="@drawable/keep_motion_cmd_white_bg"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true">
        <com.zenmen.palmchat.circle.app.keep.widget.KeepProgressBar
            android:id="@+id/pb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/keep_motion_cmd_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/keep_motion_backward"
                android:layout_weight="1"
                android:onClick="prev"/>
            <CheckBox
                android:layout_gravity="center"
                android:id="@+id/play_or_pause"
                android:background="@drawable/keep_motion_play_cb_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                android:src="@drawable/keep_motion_play_pause_selector"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/keep_motion_forward"
                android:layout_weight="1"
                android:onClick="next"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
