<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_square_nest_topic_feed_item_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/iv_feed_pic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:esv_shape="round_rectangle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_x_dp="8dp"
        app:radius_y_dp="8dp"/>
    <ImageView
        android:id="@+id/square_video_play_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_video_play_btn_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/nest_topic_item_cover"
        android:background="@drawable/bg_nest_topic_item_bottom_cover"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_feed_pic"
        app:layout_constraintLeft_toLeftOf="@+id/iv_feed_pic"
        app:layout_constraintRight_toRightOf="@+id/iv_feed_pic"/>
    <RelativeLayout
        android:id="@+id/bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_feed_pic"
        app:layout_constraintLeft_toLeftOf="@+id/iv_feed_pic"
        app:layout_constraintRight_toRightOf="@+id/iv_feed_pic">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_location_time"
            android:tag="binding_1"
            android:paddingLeft="12dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/sex_icon"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_feed_location_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/icon_feed_location"
                app:layout_constraintBottom_toBottomOf="@+id/tv_feed_location_label"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_feed_location_label"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_feed_location_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constraintLeft_toRightOf="@+id/iv_feed_location_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/tv_feed_create_time_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                app:layout_constraintLeft_toLeftOf="@+id/tv_feed_location_label"
                app:layout_constraintTop_toBottomOf="@+id/tv_feed_location_label"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/sex_icon"
            android:tag="binding_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="#222222"
        android:ellipsize="end"
        android:id="@+id/tv_feed_content_desc"
        android:paddingLeft="10dp"
        android:paddingTop="18dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxLines="8"
        app:layout_constraintBottom_toTopOf="@+id/bottom_info"
        app:layout_constraintLeft_toLeftOf="@+id/iv_feed_pic"
        app:layout_constraintRight_toRightOf="@+id/iv_feed_pic"
        app:layout_constraintTop_toTopOf="@+id/iv_feed_pic"/>
    <com.zenmen.listui.widget.LeftDrawableText
        android:id="@+id/iv_pic_count"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        app:layout_constraintRight_toRightOf="@+id/iv_feed_pic"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/icon_media_count"/>
</androidx.constraintlayout.widget.ConstraintLayout>
