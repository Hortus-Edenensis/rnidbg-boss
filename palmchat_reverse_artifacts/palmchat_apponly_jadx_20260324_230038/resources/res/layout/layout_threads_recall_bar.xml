<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_thread_recall_bar"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <com.zenmen.palmchat.widget.EffectiveShapeView
        android:id="@+id/guide_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="6dp"
        android:src="@drawable/icon_default_portrait"
        android:scaleType="centerCrop"
        app:esv_shape="circle"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/guide_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:text="附近的人正在寻找聊天对象"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_below="@+id/bubble_image"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_tiny2"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/guide_btn"
        android:background="@drawable/bg_thread_recall_bar_button"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:minWidth="50dp"
        android:text="招呼"/>
    <ImageView
        android:id="@+id/guide_close"
        android:padding="3dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/ic_recall_bar_close"/>
</LinearLayout>
