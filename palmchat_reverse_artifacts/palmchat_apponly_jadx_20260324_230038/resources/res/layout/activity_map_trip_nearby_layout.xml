<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#b4000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/trip_map_nearby_click_close"
        android:layout_width="match_parent"
        android:layout_height="400dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/trip_map_nearby_layout"
        android:background="@drawable/trip_map_nearby_all_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="700dp">
        <FrameLayout
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/trip_nearby_tool_all_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="108dp">
                <TextView
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:id="@+id/trip_nearby_tool_all_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全部"/>
                <View
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/trip_nearby_tool_all_line"
                    android:background="@drawable/trip_map_nearby_tool_line_bg"
                    android:layout_width="10dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="right"
                android:orientation="vertical"
                android:id="@+id/trip_nearby_tool_normal_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="108dp">
                <TextView
                    android:textSize="17dp"
                    android:textColor="#666666"
                    android:id="@+id/trip_nearby_tool_normal_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已解锁"/>
                <View
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/trip_nearby_tool_normal_line"
                    android:background="@drawable/trip_map_nearby_tool_line_bg"
                    android:visibility="gone"
                    android:layout_width="10dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/trip_map_nearby_show_data"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/trip_map_nearby_toast_layout_all"
                    android:background="@drawable/trip_map_nearby_toast_layout"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/trip_map_nearby_all_toast_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/trip_map_nearby_icon_all"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginLeft="12dp"
                                android:src="@drawable/trip_map_nearby_all_toast_location_bg"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/trip_map_nearby_icon_normal"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginLeft="12dp"
                                android:src="@drawable/trip_map_nearby_noraml_toast_notice_bg"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#0072ff"
                            android:ellipsize="marquee"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/trip_map_nearby_toast_text"
                            android:paddingTop="2dp"
                            android:layout_width="280dp"
                            android:layout_height="19dp"
                            android:layout_marginLeft="6dp"
                            android:text="查看位置: 距离你0km"
                            android:singleLine="true"
                            android:marqueeRepeatLimit="marquee_forever"/>
                    </LinearLayout>
                </FrameLayout>
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/trip_nearby_viewpager_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/trip_map_nearby_network_error_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="66dp">
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="143dp"
                    android:src="@drawable/trip_map_nearby_network_error"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="网络信号弱，请检查网络后再尝试打开页面"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
