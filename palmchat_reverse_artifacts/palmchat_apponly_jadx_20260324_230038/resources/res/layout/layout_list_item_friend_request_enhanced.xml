<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/selector_settings_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/gap"
        android:background="#efefef"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/background"
        android:background="@drawable/selector_settings_item_background"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp">
            <com.zenmen.palmchat.widget.SocialPortraitView
                android:layout_gravity="center_vertical"
                android:id="@+id/portrait"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"
                app:esv_shape="round_rectangle"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/contact_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/new_contact_item_contact_icon"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="13dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="13dp">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/friend_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="名称ddddddddddddddddddddddddddddddddddddddddddd"
                    android:lines="1"
                    android:maxEms="8"
                    android:singleLine="true"
                    style="@style/text_normal_content"/>
                <TextView
                    android:id="@+id/tv_official"
                    android:visibility="gone"
                    android:layout_marginLeft="6dp"
                    style="@style/official_text_tag"/>
                <ImageView
                    android:id="@+id/iv_vip"
                    android:visibility="visible"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/vip_icon_normal_small"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/friend_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="名称"
                    android:singleLine="true"
                    style="@style/text_middle_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/contact_recommend_phone_ic"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/contact_recommend_phone_ic"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_color_btn_green"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/confirm_button"
            android:background="@drawable/selector_btn_green_invite"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="@string/accept_add_contact_request"/>
    </LinearLayout>
</LinearLayout>
