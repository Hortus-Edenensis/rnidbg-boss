<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/C2"
        android:textColor="@color/Gd"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/category"
        android:background="@color/cate_bg_color"
        android:paddingLeft="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:text="@string/latest_threads"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/Ab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/selector_settings_item_background"
            android:paddingLeft="16dp"
            android:paddingTop="5dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zenmen.palmchat.widget.SocialPortraitView
                android:layout_gravity="center_vertical"
                android:id="@+id/portrait"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/default_portrait"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/B2"
                    android:textColor="@color/text_color_black"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="测试一个很长的名字"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/B4"
                    android:textColor="@color/input_btn_disabled"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="测试一个很长的名字"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:background="@color/color_divider_contact"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</LinearLayout>
