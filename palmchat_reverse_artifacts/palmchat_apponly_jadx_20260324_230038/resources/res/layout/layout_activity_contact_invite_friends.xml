<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button2"/>
    <RelativeLayout
        android:id="@+id/permission_fail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="56dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/permission_icon"
            android:layout_width="180dp"
            android:layout_height="143dp"
            android:src="@drawable/image_invite_friend"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/permission_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/permission_granted_guide_contact_title"
            android:layout_below="@+id/permission_icon"
            android:layout_centerHorizontal="true"
            style="@style/text_normal_content"/>
        <TextView
            android:textSize="@dimen/B4"
            android:textColor="@color/Gd"
            android:id="@+id/permission_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_granted_guide_contact_invite"
            android:layout_below="@+id/permission_text"
            android:layout_centerHorizontal="true"
            style="@style/text_middle_content"/>
        <TextView
            android:enabled="true"
            android:textSize="@dimen/B2"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/permission_add"
            android:background="@drawable/selector_btn_green_normal"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="80dp"
            android:text="@string/permission_granted_guide_contact_button"
            android:layout_below="@+id/permission_sub_text"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/contacts_list_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_666666"
            android:gravity="center_horizontal"
            android:id="@+id/notice_text"
            android:background="@color/white"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contact_invite_notice"
            android:layout_centerHorizontal="true"/>
        <ListView
            android:gravity="top"
            android:id="@+id/contacts_list"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:scrollingCache="false"
            android:cacheColorHint="#00000000"
            android:layout_below="@+id/notice_text"/>
        <RelativeLayout
            android:id="@+id/tv_empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/empty_icon"
                android:layout_width="180dp"
                android:layout_height="143dp"
                android:layout_marginTop="56dp"
                android:src="@drawable/image_invite_friend"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/contact_invite_friends_empty_title"
                android:layout_below="@+id/empty_icon"
                android:layout_centerHorizontal="true"
                style="@style/text_normal_content"/>
            <TextView
                android:id="@+id/empty_sub_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/contact_invite_friends_empty_subtile"
                android:layout_below="@+id/empty_text"
                android:layout_centerHorizontal="true"
                style="@style/text_middle_content"/>
            <TextView
                android:enabled="true"
                android:gravity="center"
                android:id="@+id/go_contact"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginTop="80dp"
                android:text="@string/contact_invite_friends_empty_jump_text"
                android:layout_below="@+id/empty_sub_text"
                android:layout_centerHorizontal="true"
                style="@style/btn_green_solid"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/action_layout"
        android:paddingTop="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <TextView
            android:enabled="true"
            android:gravity="center"
            android:id="@+id/action_textview"
            android:layout_width="280dp"
            android:layout_height="48dp"
            android:text="@string/contact_invite_friends_invite"
            style="@style/btn_green_solid"/>
    </LinearLayout>
</LinearLayout>
