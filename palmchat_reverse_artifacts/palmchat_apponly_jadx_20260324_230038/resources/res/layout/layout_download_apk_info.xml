<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:background="#42000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/download_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/download_close"
                android:background="@drawable/download_dialog_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="15dp"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用详情"/>
        </FrameLayout>
        <View
            android:background="#f5f5f5"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center_horizontal"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/download_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/lxad_head_default"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_gravity="center_horizontal"
            android:id="@+id/download_title"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:text="未知应用"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/download_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="330dp"
            android:text="test"
            android:maxLines="3"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="32dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#bcbcbc"
                android:gravity="center_vertical"
                android:id="@+id/download_ver"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="版本号:1.0.0"/>
            <View
                android:background="#bcbcbc"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="6dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#bcbcbc"
                android:gravity="center_vertical"
                android:id="@+id/download_size"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="应用大小:未知"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#bcbcbc"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/download_dev"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="4dp"
            android:text="开发者:未知开发者"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#bcbcbc"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/download_function"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:text="功能 "/>
            <View
                android:background="#bcbcbc"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="4dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#bcbcbc"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/download_per"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:text=" 权限 "/>
            <View
                android:background="#bcbcbc"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="4dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#bcbcbc"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/download_ys"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:text=" 隐私"/>
        </LinearLayout>
        <View
            android:background="#f5f5f5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/download_btn"
            android:background="@drawable/download_dialog_btn_bg"
            android:layout_width="340dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="27dp"
            android:text="立即下载"/>
    </LinearLayout>
</RelativeLayout>
