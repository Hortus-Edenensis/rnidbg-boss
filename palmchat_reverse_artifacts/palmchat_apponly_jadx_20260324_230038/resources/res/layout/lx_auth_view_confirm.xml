<?xml version="1.0" encoding="utf-8"?>
<com.zenmen.openapi.auth.widget.ConfirmDialogView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/lx_auth_confirm_dialog_bg"
        android:paddingLeft="23dp"
        android:paddingTop="20dp"
        android:paddingRight="23dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/lx_auth_confirm_app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/lx_auth_confirm_app_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/lx_auth_confirm_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.5dp"
                android:layout_toRightOf="@+id/lx_auth_confirm_app_icon"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#222222"
                android:id="@+id/lx_auth_confirm_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.5dp"
                android:text="@string/lx_open_api_permission_grant"
                android:layout_toRightOf="@+id/lx_auth_confirm_app_name"
                android:layout_centerVertical="true"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="3dp"
                android:src="@drawable/lx_auth_promp_info"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:id="@+id/lx_auth_confirm_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_below="@+id/lx_auth_confirm_app_info"/>
        <View
            android:id="@+id/lx_first_divider_line"
            android:background="#f4f4f4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/lx_auth_confirm_content"/>
        <RelativeLayout
            android:id="@+id/lx_auth_confirm_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lx_first_divider_line">
            <RelativeLayout
                android:id="@+id/lx_auth_confirm_content_wrap"
                android:layout_width="wrap_content"
                android:layout_height="64dp">
                <ImageView
                    android:id="@+id/lx_auth_confirm_avatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#222222"
                    android:id="@+id/lx_auth_confirm_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="3dp"
                    android:layout_toRightOf="@+id/lx_auth_confirm_avatar"
                    android:layout_alignTop="@+id/lx_auth_confirm_avatar"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginBottom="3dp"
                    android:text="@string/lx_open_api_grant_profile"
                    android:layout_toRightOf="@+id/lx_auth_confirm_avatar"
                    android:layout_alignBottom="@+id/lx_auth_confirm_avatar"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/lx_auth_check"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/lx_auth_confirm_mobile_wrap"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_below="@+id/lx_auth_confirm_content_wrap">
                <View
                    android:background="#f4f4f4"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#222222"
                    android:id="@+id/lx_auth_confirm_mobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:text="@string/lx_open_api_grant_mobile"
                    android:layout_toRightOf="@+id/lx_auth_confirm_mobile"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/lx_auth_check"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/lx_second_divider_line"
            android:background="#f4f4f4"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/lx_auth_confirm_profile"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#202020"
            android:gravity="center"
            android:id="@+id/lx_auth_confirm_cancel"
            android:background="@drawable/lx_openapi_btn_bg_negative"
            android:layout_width="132dp"
            android:layout_height="36dp"
            android:layout_marginTop="33dp"
            android:text="@string/lx_open_api_cancel"
            android:layout_below="@+id/lx_second_divider_line"
            android:layout_alignParentLeft="true"
            android:onClick="onClick"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/lx_auth_confirm_ok"
            android:background="@drawable/lx_openapi_btn_bg_positive"
            android:layout_width="132dp"
            android:layout_height="36dp"
            android:layout_marginTop="33dp"
            android:text="@string/lx_open_api_confirm"
            android:layout_below="@+id/lx_second_divider_line"
            android:layout_alignParentRight="true"
            android:onClick="onClick"/>
    </RelativeLayout>
</com.zenmen.openapi.auth.widget.ConfirmDialogView>
