<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/color_FFFFFF"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zenmen.palmchat.widget.SocialPortraitView
        android:layout_gravity="bottom"
        android:id="@+id/portrait"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/default_portrait"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/first_name"
        android:background="@drawable/square_share_name_bg"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginRight="10dp"/>
    <View
        android:id="@+id/cover"
        android:background="#88ffffff"
        android:visibility="gone"
        android:layout_width="@dimen/list_item_group_init_chosen_width"
        android:layout_height="@dimen/list_item_group_init_chosen_width"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"/>
</FrameLayout>
