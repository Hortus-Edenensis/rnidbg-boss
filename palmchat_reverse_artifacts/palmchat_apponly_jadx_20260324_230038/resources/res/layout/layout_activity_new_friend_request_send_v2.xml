<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_custom_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#202020"
            android:layout_gravity="center_horizontal"
            android:id="@+id/send_msg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/new_friend_send_title"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#8a8a8a"
            android:id="@+id/send_msg_notice_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/new_friend_send_message_b"/>
        <EditText
            android:textSize="14dp"
            android:textColor="#202020"
            android:gravity="top|left"
            android:id="@+id/request_information"
            android:background="@drawable/shape_light_edit_bg"
            android:paddingLeft="15dp"
            android:paddingTop="15dp"
            android:paddingRight="15dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginTop="4dp"
            android:text="@string/new_friend_request_message"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/remark_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#8a8a8a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remark_by_request_send_b"/>
            <com.zenmen.palmchat.widget.ClearEditText
                android:textSize="14dp"
                android:textColor="#202020"
                android:textColorHint="#9b9b9b"
                android:gravity="center"
                android:id="@+id/remark_edit"
                android:background="@drawable/shape_light_edit_bg"
                android:paddingLeft="15dp"
                android:paddingTop="15dp"
                android:paddingRight="15dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="50dp"
                android:singleLine="true"
                android:drawablePadding="10dp"
                android:textCursorDrawable="@null"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#8a8a8a"
            android:layout_gravity="left"
            android:id="@+id/phone_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/remark_recommend_by_phonebook_b"/>
    </LinearLayout>
</LinearLayout>
