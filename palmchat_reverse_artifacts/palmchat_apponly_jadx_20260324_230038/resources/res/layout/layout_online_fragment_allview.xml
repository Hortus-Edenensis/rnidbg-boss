<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/online_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/online_data_layout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/sex_filter_layout">
            <FrameLayout
                android:id="@+id/online_data_success_layout"
                android:paddingTop="7dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.zenmen.square.fragment.online.LineMyRecyclerView
                    android:id="@+id/line_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/online_location_error_layout"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="144dp"
                    android:layout_height="114dp"
                    android:src="@drawable/online_status_location_error_bg"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:id="@+id/location_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxWidth="214dp"
                    android:text="活跃大厅会推荐你附近的活跃用户状态请先授权位置权限"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/online_net_error_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/net_err_img"
                    android:layout_width="115dp"
                    android:layout_height="91dp"
                    android:src="@drawable/online_status_net_error_bg"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#666666"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="加载失败，"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#14cd64"
                        android:id="@+id/net_err_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="点击刷新"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/online_data_error_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="94dp"
                    android:src="@drawable/online_status_data_error_bg"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:id="@+id/data_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxWidth="214dp"
                    android:text="暂无活跃动态，快发布你的活跃状态抢占C位~"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/sex_filter_layout"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginTop="38dp"
            android:layout_above="@+id/status_all_layout"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:gravity="center"
                android:id="@+id/sex_line_normal"
                android:background="@drawable/online_sex_normal_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="只看异性"/>
            <FrameLayout
                android:id="@+id/sex_line_select"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#14cd64"
                    android:gravity="center"
                    android:background="@drawable/online_sex_select_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="只看异性"/>
                <ImageView
                    android:layout_gravity="bottom|right"
                    android:layout_width="14dp"
                    android:layout_height="12dp"
                    android:src="@drawable/online_sex_select_bottom"
                    android:scaleType="fitXY"/>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/status_all_layout"
            android:layout_width="match_parent"
            android:layout_height="117dp"
            android:layout_marginTop="12dp"
            android:layout_above="@+id/bottom_desc_layout">
            <RelativeLayout
                android:background="@drawable/online_status_bg"
                android:layout_width="315dp"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#222222"
                    android:id="@+id/online_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    android:text="我的活跃状态"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/online_status_add_layout"
                    android:background="@drawable/online_status_add_green_bg"
                    android:visibility="gone"
                    android:layout_width="233dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/online_status_title"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/online_status_add_bg"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:id="@+id/online_status_add_btn_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="添加状态"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/online_status_show_msg_layout"
                    android:background="@drawable/online_status_color_def"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="17dp"
                    android:layout_below="@+id/online_status_title"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@+id/online_status_show_msg_img"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/online_status_msg_bg"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#222222"
                        android:ellipsize="end"
                        android:id="@+id/online_status_show_msg_text"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="4dp"
                        android:maxWidth="210dp"
                        android:text="来个人陪我聊聊天"
                        android:lines="1"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/bottom_desc_layout"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="30dp"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/online_status_dt_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#999999"
                    android:gravity="center_vertical"
                    android:id="@+id/online_status_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="09:44:56 后状态自动过期"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#14cd64"
                    android:id="@+id/online_status_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="删除状态"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/online_status_desc_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxWidth="358dp"
                android:text="活跃状态发布后24小时有效，有效期内会持续在活跃大厅中展示"
                android:lines="1"/>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
