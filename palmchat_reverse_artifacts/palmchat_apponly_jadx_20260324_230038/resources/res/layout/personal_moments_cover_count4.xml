<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="81dp"
    android:layout_height="81dp">
    <ImageView
        android:id="@+id/count4_img1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:layout_alignParentLeft="true"/>
    <ImageView
        android:id="@+id/count4_img2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:scaleType="centerCrop"
        android:layout_below="@+id/count4_img1"
        android:layout_alignParentLeft="true"/>
    <ImageView
        android:id="@+id/count4_img3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"
        android:scaleType="centerCrop"
        android:layout_toRightOf="@+id/count4_img1"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/count4_img4"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"/>
    <com.zenmen.palmchat.widget.RoundCornerCoverView
        android:layout_width="81dp"
        android:layout_height="81dp"
        app:cornerRad="4dp"/>
</RelativeLayout>
