<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zenmen.palmchat.giftkit.widgit.GiftTabHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        app:ui_type="light"/>
    <View
        android:id="@+id/tab_line"
        android:background="@color/Fb"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="263dp">
        <com.zenmen.palmchat.giftkit.widgit.NonSwipeableViewPager
            android:id="@+id/vp_panel"
            android:layout_width="match_parent"
            android:layout_height="263dp"/>
        <View
            android:id="@+id/bottom_layout"
            android:background="@drawable/bg_gift_bottom_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_linearlayout"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/ll_recharge_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#fff9398c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="马上充值"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="8dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="2dp"
                    android:src="@drawable/gift_send_arrow"/>
            </LinearLayout>
            <com.zenmen.palmchat.giftkit.widgit.GiftNumSelectorView
                android:id="@+id/number_selector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ui_type="light"/>
            <com.zenmen.palmchat.giftkit.widgit.GiftNumSelectorView
                android:id="@+id/pack_number_selector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ui_type="light"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/B3"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_gift_send"
            android:background="@drawable/selector_gift_send_bg_light"
            android:clickable="true"
            android:layout_width="62dp"
            android:layout_height="32dp"
            android:layout_marginLeft="10dp"
            android:text="赠送"/>
    </LinearLayout>
</LinearLayout>
