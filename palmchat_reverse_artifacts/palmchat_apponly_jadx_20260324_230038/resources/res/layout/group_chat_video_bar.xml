<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/group_video_text_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="13dp"
            android:src="@drawable/ic_group_video_bar_des"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#202020"
            android:gravity="center_vertical"
            android:id="@+id/group_video_text_des"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/string_group_video_chat_des"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="@drawable/ic_group_video_bar_detail"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/group_video_detail_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="#202020"
            android:id="@+id/des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/group_bar_detail_dialog_title"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/member_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:layout_below="@+id/des"/>
        <View
            android:background="#ececec"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/member_layout"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_below="@+id/member_layout">
            <TextView
                android:textSize="15dp"
                android:textColor="#202020"
                android:gravity="center"
                android:id="@+id/cancelTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/group_bar_detail_dialog_cancel"
                android:layout_weight="1"
                android:layout_toLeftOf="@+id/joinTV"
                android:layout_below="@+id/member_layout"/>
            <View
                android:background="#ececec"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#009687"
                android:gravity="center"
                android:id="@+id/joinTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/group_bar_detail_dialog_join"
                android:layout_weight="1"
                android:layout_below="@+id/member_layout"
                android:layout_alignParentRight="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
