<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_width="42dp"
        android:layout_height="42dp">
        <com.zenmen.palmchat.widget.EffectiveShapeView
            android:id="@+id/mToolsItemIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/icon_circle_tools_default"
            app:esv_shape="round_rectangle"
            app:radius_x_dp="12dp"
            app:radius_y_dp="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/text_color_222222"
        android:id="@+id/mToolsItemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
</LinearLayout>
